---
// The install doc's fresh-install section: the weekly installers, and how
// to check one. One column: it lives in the docs' reading column.
import DownloadRow from './DownloadRow.astro';
import { COSIGN_PUB, ISOS } from '../data/site';

const SUMS = ['sha256', 'sha256.sigstore.json', 'json'];

// The signature covers the checksum manifest, not the 5GB ISO -- verifying
// the manifest and then checking the ISO against it proves the same thing
// without cosign reading five gigabytes. The bundle is the signature plus its
// Rekor entry, so cosign checks the key and the public log in one go, with no
// --insecure-ignore-tlog.
const VERIFY = [
  `cosign verify-blob ${ISOS.vanilla}.sha256`,
  `--key ${COSIGN_PUB}`,
  `--bundle ${ISOS.vanilla}.sha256.sigstore.json`,
  `&& sha256sum -c ${ISOS.vanilla}.sha256`,
].join(' ');

const shown = [
  `cosign verify-blob ${ISOS.vanilla}.sha256 \\`,
  `  --key ${COSIGN_PUB} \\`,
  `  --bundle ${ISOS.vanilla}.sha256.sigstore.json \\`,
  `&& sha256sum -c ${ISOS.vanilla}.sha256`,
].join('\n');
---

<div class="iso">
  <p class="lede">
    A weekly installer ISO for each variant, built from the published image itself: the same
    Anaconda installer stock Silverblue uses, landing directly in Pulsar.{' '}
    <span class="sent">Checksummed, and signed with Pulsar's release&nbsp;key.</span>
  </p>

  <div class="grid">
    <div>
      <ul class="isos">
        <DownloadRow which="standard" file={ISOS.vanilla} sums={SUMS} />
        <DownloadRow which="nvidia" file={ISOS.nvidia} sums={SUMS} />
      </ul>
      <p class="hint">
        Write it to a USB&nbsp;stick with GNOME&nbsp;Disks or <code>dd</code>, boot,&nbsp;install.
        The <code>.json</code> sidecar records exactly which image digest the installer carries.
      </p>
    </div>

    <div>
      <p class="cap">
        <span>Signed with the release key, which never leaves the signing&nbsp;host.</span>
      </p>
      <arc-code-block
        class="theme-fixed-dark"
       
        language="bash"
        filename="verify"
        code={shown}
        data-copy={VERIFY}
      ></arc-code-block>
      <p class="hint">
        The public half of that key is published beside the ISOs and committed to the repo as{' '}
        <code>keys/cosign.pub</code>; the build verifies every signature against the committed copy
        before publishing.
      </p>
      <p class="hint">The <code>.sigstore.json</code> bundle carries the signature and its entry in Rekor, Sigstore’s public transparency log, so cosign checks both the key and that the signature was logged in public.</p>
    </div>
  </div>
</div>

<style>
  .grid {
    display: grid;
    /* explicit, or the implicit column sizes to the longest filename */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
  }
  .isos {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cap {
    margin: 0 0 var(--space-sm);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  arc-code-block {
    display: block;
  }
  .hint {
    margin-top: var(--space-md);
    margin-bottom: 0;
  }
</style>
