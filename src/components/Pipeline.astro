---
// The supply chain, as a trail, and then the command that shows what is
// attached to an image. Honest about where it stands: every image carries its
// package list (an SPDX SBOM) and is diffed nightly; the NVIDIA module is
// signed for Secure Boot; the gated nightly images (since 2026-09-28) and the
// installer ISOs are signed with the cosign release key.
import { IMAGES, REPO } from '../data/site';

interface Props {
  /** the home page shows the trail and the check; /docs/provenance also explains */
  compact?: boolean;
}

const { compact = false } = Astro.props;

const STAGES = [
  { name: 'commit', detail: 'a change is merged in the public repo and goes into that night’s build' },
  { name: 'build', detail: 'both images, on a fresh machine that is deleted once the build is done' },
  { name: 'sign', detail: 'the NVIDIA kernel module with the key you enroll for Secure Boot, and each image with Pulsar’s release key' },
  { name: 'record', detail: 'an SPDX SBOM of every package goes on the image and is diffed against last night’s' },
  { name: 'boot', detail: 'your machine starts the new image, and goes back to the old one after three failed boots in a row' },
];

const shown = `oras discover ${IMAGES.nvidia}:latest`;
---

<div class="pipe">
  <arc-timeline heading-level="3" class="trail">
    {
      STAGES.map((stage) => (
        <arc-timeline-item heading={stage.name}>{stage.detail}</arc-timeline-item>
      ))
    }
  </arc-timeline>

  <div class="check">
    <p class="check-cap">To check it&nbsp;yourself:</p>
    <arc-code-block
      class="theme-fixed-dark"
      language="bash"
      filename="what is attached to an image"
      code={shown}
    ></arc-code-block>
    {
      !compact && (
        <p class="hint">
          The images and installer ISOs are signed with Pulsar’s cosign release key, so running them
          means trusting that key. If you’d rather not,{' '}
          <a href={`${REPO}#signing-and-provenance`}>fork the repo and build your own</a>.
        </p>
      )
    }
  </div>
</div>

<style>
  .pipe {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .trail {
    display: block;
    font-family: var(--font-mono);
  }
  .check-cap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin: 0 0 var(--space-sm);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .check arc-code-block {
    display: block;
  }
  .check .hint {
    margin-top: var(--space-md);
  }
  @media (max-width: 56rem) {
    .pipe {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }
</style>
