---
// #install on the home page, and the page's one destination: "Get started"
// in the hero lands here. The downloads sit on Silk, the wallpaper the hero
// draws live, so the page ends on the desktop it began with. Then the path
// from a stick to a desktop, the two things some people need (the NVIDIA key,
// checking the download) as folds, and the switch for people already on an
// atomic Fedora. /docs/install has every screen of it.
import { COSIGN_PUB, IMAGES, ISO_BASE, ISOS } from '../data/site';

const DOWNLOADS = [
  {
    key: 'standard',
    icon: 'laptop',
    name: 'Pulsar',
    who: 'For most computers: laptops and desktops with Intel or AMD graphics.',
    file: ISOS.vanilla,
    note: null,
  },
  {
    key: 'nvidia',
    icon: 'graphics-card',
    name: 'Pulsar for NVIDIA',
    who: 'For NVIDIA GeForce RTX. The driver is built in, ready for games and local models.',
    file: ISOS.nvidia,
    note: 'Secure Boot on? You enroll a key once after installing.',
  },
];

const STOPS = [
  { i: 'usb', t: 'Write the ISO to a USB stick', d: 'Any stick of 8 GB or more. GNOME Disks does it, or Fedora Media Writer on Windows and macOS.' },
  { i: 'hard-drives', t: 'Boot it and install', d: 'You pick the disk and the layout. The installer asks before it changes anything.' },
  { i: 'sign-in', t: 'Log in', d: 'Choose a theme and, if you want one, a coding agent. Your apps finish installing in the background.' },
];

// Broken after the verb, so the short first line leaves the Copy button its
// own corner and a phone scrolls only the image name.
const switchTo = (image: string) => `sudo bootc switch \\\n  ${image}:latest`;
const ENROL = 'sudo mokutil --import /etc/pki/pulsar/MOK.der\nsudo systemctl reboot';
const VERIFY = [
  `cosign verify-blob ${ISOS.vanilla}.sha256 \\`,
  `  --key ${COSIGN_PUB} \\`,
  `  --signature ${ISOS.vanilla}.sha256.sig \\`,
  '  --insecure-ignore-tlog=true \\',
  `&& sha256sum -c ${ISOS.vanilla}.sha256`,
].join('\n');
---

<section class="chapter install" id="install" aria-labelledby="install-h">
  <div class="stage" data-stage-wall>
    <div class="stage-head">
      <h2 id="install-h"><span class="mark" aria-hidden="true"><arc-icon name="download-simple" size="xl"></arc-icon></span>Get Pulsar</h2>
      <p class="stage-sub">Free and open source. One download and a USB stick.</p>
    </div>
    <div class="downloads">
      {
        DOWNLOADS.map((d) => (
          <div class="dl">
            <span class="dl-icon" aria-hidden="true"><arc-icon name={d.icon} size="lg"></arc-icon></span>
            <h3 class="dl-name">{d.name}</h3>
            <p class="dl-who">{d.who}</p>
            {d.note && (
              <p class="dl-note">
                {d.note} <a href="#mok">How</a>
              </p>
            )}
            <div class="dl-act">
              <arc-button href={`${ISO_BASE}/${d.file}`} variant={d.key === 'standard' ? 'primary' : 'secondary'} size="lg">
                Download ISO
              </arc-button>
              <span class="dl-meta">
                <span class="mono">{d.file}</span>
                <span>x86_64 · about 5–6 GB · rebuilt weekly</span>
              </span>
            </div>
            <p class="dl-sums">
              <a href={`${ISO_BASE}/${d.file}.sha256`}>.sha256</a>
              <a href={`${ISO_BASE}/${d.file}.sha256.sig`}>.sha256.sig</a>
              <a href={`${ISO_BASE}/${d.file}.json`}>.json</a>
            </p>
          </div>
        ))
      }
    </div>
  </div>

  <ol class="path" aria-label="From the download to your desktop">
    {
      STOPS.map((s, i) => (
        <li class="stop">
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <a class="from" href="/docs/coming-from">
    <arc-icon name="arrows-left-right" size="md" aria-hidden="true"></arc-icon>
    <span>
      <strong>Coming from Windows or a Mac?</strong>
      <span class="from-d">Check your computer can run it, make the stick, and keep Windows alongside.</span>
    </span>
    <span class="from-go" aria-hidden="true">→</span>
  </a>

  <div class="folds">
    <details class="fold" id="mok">
      <summary>NVIDIA with Secure Boot: enroll the driver’s key, once</summary>
      <div class="fold-body">
        <p>
          The driver is signed with Pulsar’s key so Secure Boot can stay on. Run this, choose a
          one-time password, and restart. A blue screen asks for <arc-kbd>Enroll MOK</arc-kbd> and
          that password, once.
        </p>
        <arc-code-block class="theme-fixed-dark" language="bash" filename="enroll the key" code={ENROL}></arc-code-block>
        <p class="hint"><a href="/docs/install#secure-boot">Every screen, step by step →</a></p>
      </div>
    </details>
    <details class="fold">
      <summary>Check the download is really ours</summary>
      <div class="fold-body">
        <p>
          Each ISO’s checksum is signed with Pulsar’s release key. This checks the signature, then
          the ISO against the checksum.
        </p>
        <arc-code-block class="theme-fixed-dark" language="bash" filename="verify" code={VERIFY}></arc-code-block>
      </div>
    </details>
  </div>

  <div class="switch">
    <div class="switch-copy">
      <h3>Already on Silverblue or Kinoite?</h3>
      <p>
        Switch in place with one command and a restart. Your files, apps and settings are kept, and
        the system you had is still in the boot menu.
      </p>
    </div>
    <div class="switch-cmds">
      <arc-code-block class="theme-fixed-dark" language="bash" filename="Pulsar" code={switchTo(IMAGES.vanilla)}></arc-code-block>
      <arc-code-block class="theme-fixed-dark" language="bash" filename="Pulsar for NVIDIA" code={switchTo(IMAGES.nvidia)}></arc-code-block>
    </div>
  </div>

  <aside class="learn" aria-label="Documentation">
    <arc-icon name="book-open" size="md" aria-hidden="true"></arc-icon>
    <p><strong>Looking to learn more?</strong> Install, themes, updates, agents: every detail is in the docs.</p>
    <arc-button href="/docs" variant="secondary" size="sm">Read the docs</arc-button>
  </aside>
</section>

<style>
  /* ---- the stage: the theme's wallpaper behind the two downloads ------ */
  /* The hero's live sky, as a still (--stage-wall: src/scripts/sky.ts
     snapshots the canvas whenever the picture changes -- the site theme's
     recolor of the look on show), under a wash in the theme's colors: its
     accent from the top corner, then its ground deepening toward the
     downloads so every line of text keeps its contrast. Silk's still until
     then, and with no WebGL. */
  .stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-bottom: var(--space-2xl);
    padding: var(--space-3xl) var(--space-2xl) var(--space-2xl);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: var(--bg-deep);
  }
  .stage::before,
  .stage::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .stage::before {
    z-index: -2;
    background: var(--stage-wall, url('/assets/silk-still-dark.jpg')) center / cover;
  }
  :global(:root[data-theme='light']) .stage::before {
    background: var(--stage-wall, url('/assets/silk-still-light.jpg')) center / cover;
  }
  @media (prefers-color-scheme: light) {
    :global(:root[data-theme='auto']) .stage::before {
      background: var(--stage-wall, url('/assets/silk-still-light.jpg')) center / cover;
    }
  }
  /* On a dark page the sky runs brighter than the theme's ground (a pale
     satin cloth, a lit silk), so the picture itself is dimmed there before
     the wash: the wash can stay light enough to show it, and the text keeps
     WCAG contrast over every theme's preferred look (measured, both modes). */
  :global(:root[data-theme='dark']) .stage::before {
    filter: brightness(0.8);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root[data-theme='auto']) .stage::before,
    :global(:root:not([data-theme])) .stage::before {
      filter: brightness(0.8);
    }
  }
  /* and the mirror on a light page: its darker folds lifted under dark text */
  :global(:root[data-theme='light']) .stage::before {
    filter: none;
  }
  @media (prefers-color-scheme: light) {
    :global(:root[data-theme='auto']) .stage::before,
    :global(:root:not([data-theme])) .stage::before {
      filter: none;
    }
  }
  .stage::after {
    z-index: -1;
    background:
      /* a soft pool of ground behind the heading and its line: the sky keeps
         its detail elsewhere, and a muted theme (Solarized) still reads */
      radial-gradient(55% 45% at 25% 22%, color-mix(in oklab, var(--bg-base) 68%, transparent), transparent 70%),
      radial-gradient(120% 90% at 0% 0%, color-mix(in oklab, var(--accent-primary) 10%, transparent), transparent 65%),
      linear-gradient(180deg, color-mix(in oklab, var(--bg-base) 83%, transparent), color-mix(in oklab, var(--bg-base) 90%, transparent) 35%, color-mix(in oklab, var(--bg-base) 93%, transparent));
  }
  /* Over the sky the stage keeps three tones -- primary for the headings,
     then two steps toward the theme's secondary gray -- each lifted just
     enough to hold 4.5:1 on the brightest themes' skies. */
  .stage .dl-who,
  .stage .dl-note {
    color: color-mix(in oklab, var(--text-primary) 70%, var(--text-secondary));
  }
  .stage .dl-meta,
  .stage .dl-meta .mono,
  .stage .dl-sums a {
    color: color-mix(in oklab, var(--text-primary) 45%, var(--text-secondary));
  }
  .stage-head {
    margin-bottom: var(--space-2xl);
  }
  .stage h2 {
    display: flex;
    align-items: center;
    gap: 0.3em;
    font-size: clamp(2.4rem, 5.2vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0 0 var(--space-sm);
  }
  /* a tinted circle, as the agents' can / can't marks, sized to the heading */
  .stage h2 .mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 0.9em;
    height: 0.9em;
    border-radius: var(--radius-full);
    color: var(--accent-primary);
    background: color-mix(in oklab, var(--accent-primary) 16%, transparent);
  }
  .stage-sub {
    margin: 0;
    font-size: var(--text-lg);
    /* primary, not secondary: over a theme's wallpaper the secondary gray
       ran under 4.5:1 (Catppuccin light) */
    color: var(--text-primary);
  }
  .downloads {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid color-mix(in oklab, var(--text-primary) 18%, transparent);
  }
  .dl {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-xl) var(--space-xl) 0 0;
  }
  .dl + .dl {
    padding-left: var(--space-xl);
    border-left: 1px solid color-mix(in oklab, var(--text-primary) 18%, transparent);
  }
  .dl-name {
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
  }

  /* the path: three numbered steps -- big numerals, no line and no icon
     circles, so it does not echo the updates timeline just above */
  .path {
    list-style: none;
    margin: 0 0 var(--space-lg);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
    counter-reset: none;
  }
  .stop {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-md);
    align-items: start;
    min-width: 0;
  }
  .num {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: clamp(2.25rem, 3.6vw, 3rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--accent-primary);
    font-variant-numeric: tabular-nums;
  }
  .stop h3 {
    font-size: var(--text-lg);
    line-height: var(--heading-lh);
    margin: 0 0 var(--space-xs);
  }
  .stop p {
    margin: 0;
    color: var(--text-secondary);
  }
  .dl-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-xs);
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in oklab, var(--text-primary) 22%, transparent);
    color: var(--text-primary);
  }
  .dl-who {
    margin: 0;
    max-width: 40ch;
    color: var(--text-secondary);
  }
  .dl-note {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .dl-act {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
    /* to the panel's foot, so both buttons line up whatever sits above */
    margin-top: auto;
    padding-top: var(--space-sm);
  }
  .dl-act arc-button {
    display: inline-block;
  }
  .dl-meta {
    display: grid;
    gap: 2px;
    font-size: var(--text-xs);
    color: var(--text-muted);
    min-width: 0;
  }
  .dl-meta .mono {
    color: var(--text-secondary);
    overflow-wrap: anywhere;
  }
  .dl-sums {
    display: flex;
    gap: var(--space-md);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .dl-sums a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .dl-sums a:hover {
    color: var(--accent-primary);
  }

  /* ---- coming from another OS: one wide row that is a link ------------- */
  .from {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-md);
    margin: var(--space-2xl) 0 var(--space-lg);
    padding: var(--space-lg) 0;
    border-block: 1px solid var(--border-subtle);
    color: var(--text-primary);
    text-decoration: none;
  }
  .from arc-icon {
    color: var(--accent-primary);
  }
  .from strong {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-lg);
  }
  .from-d {
    color: var(--text-secondary);
  }
  .from-go {
    font-size: var(--text-xl);
    color: var(--text-muted);
    transition: transform 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }
  .from:hover .from-go {
    color: var(--accent-primary);
    transform: translateX(4px);
  }

  /* ---- the two folds: plain ruled rows --------------------------------- */
  .folds {
    margin-bottom: var(--space-2xl);
  }
  .fold {
    border-bottom: 1px solid var(--border-subtle);
  }
  .fold summary {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) 0;
    cursor: pointer;
    list-style: none;
    color: var(--text-secondary);
  }
  .fold summary::-webkit-details-marker {
    display: none;
  }
  .fold summary::before {
    content: '+';
    width: 1ch;
    font-family: var(--font-mono);
    color: var(--accent-primary);
  }
  .fold[open] summary::before {
    content: '−';
  }
  .fold summary:hover {
    color: var(--text-primary);
  }
  .fold-body {
    max-width: 62ch;
    padding: 0 0 var(--space-lg) calc(1ch + var(--space-sm));
  }
  .fold-body p {
    margin: 0 0 var(--space-md);
    color: var(--text-secondary);
  }
  .fold-body arc-code-block {
    display: block;
  }
  .fold-body .hint {
    margin: var(--space-sm) 0 0;
  }

  /* ---- the second way in ------------------------------------------------ */
  .switch {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-2xl);
    align-items: center;
  }
  .switch h3 {
    font-size: var(--text-2xl);
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-md);
  }
  .switch p {
    margin: 0;
    color: var(--text-secondary);
  }
  .switch-cmds {
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
  }
  .switch-cmds arc-code-block {
    display: block;
  }

  /* a sliver of its own: a slim band after the section's last ask, the way
     on to the docs */
  .learn {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin: var(--space-2xl) 0 0;
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklab, var(--accent-primary) 5%, transparent);
  }
  .learn arc-icon {
    flex: none;
    color: var(--accent-primary);
  }
  .learn p {
    flex: 1;
    margin: 0;
    color: var(--text-secondary);
  }
  .learn strong {
    color: var(--text-primary);
    font-weight: var(--font-display-weight);
  }
  .learn arc-button {
    flex: none;
  }
  @media (max-width: 40rem) {
    .learn {
      flex-wrap: wrap;
    }
    .learn p {
      flex-basis: calc(100% - 2.5rem);
    }
  }

  @media (max-width: 56rem) {
    .stage {
      padding: var(--space-2xl) var(--space-lg) var(--space-xl);
    }
    .downloads,
    .switch,
    .path {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-lg);
    }
    .dl {
      padding-right: 0;
    }
    .dl + .dl {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
