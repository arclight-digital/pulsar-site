---
// #install on the home page, and the page's one destination: "Download
// Pulsar" in the hero lands here. The downloads sit on Nebula, the wallpaper the hero
// draws live, so the page ends on the desktop it began with. Then the path
// from a stick to a desktop, the two things some people need (the NVIDIA key,
// checking the download) as folds, and the switch for people already on an
// atomic Fedora. /docs/install has every screen of it.
import { COSIGN_PUB, IMAGES, ISO_BASE, ISOS } from '../data/site';

const DOWNLOADS = [
  {
    key: 'standard',
    icon: 'laptop',
    name: 'Intel or AMD',
    who: 'If you don’t know what graphics you have, pick this one.',
    button: 'Download for Intel or AMD',
    file: ISOS.vanilla,
    note: null,
  },
  {
    key: 'nvidia',
    icon: 'graphics-card',
    name: 'NVIDIA GeForce',
    who: 'GTX 16 series, RTX 20 series and newer.\nGTX 10 series and older won’t work.',
    button: 'Download for NVIDIA',
    file: ISOS.nvidia,
    note: 'If Secure Boot is on, there’s a key to enroll after installing.',
  },
];

const STOPS = [
  { i: 'usb', t: 'Write the ISO to a USB stick', d: '8 GB or bigger. GNOME Disks can write it, or Fedora Media Writer on Windows and macOS.' },
  { i: 'hard-drives', t: 'Boot it and install', d: 'Pick a disk, whether to keep what’s on it, and the passphrase that unlocks it at every start. The disk isn’t touched until you press Install (or Erase and Install) on the last page.' },
  { i: 'sign-in', t: 'Log in', d: 'Create your account, then pick a theme and a coding agent (or none). Apps keep installing in the background for a while.' },
];

// Broken after the verb, so the short first line leaves the Copy button its
// own corner and a phone scrolls only the image name.
const switchTo = (image: string) => `sudo bootc switch \\\n  ${image}:latest`;
const ENROL = 'sudo mokutil --import /etc/pki/pulsar/MOK.der\nsudo systemctl reboot';
const VERIFY = [
  `cosign verify-blob ${ISOS.vanilla}.sha256 \\`,
  `  --key ${COSIGN_PUB} \\`,
  `  --bundle ${ISOS.vanilla}.sha256.sigstore.json \\`,
  `&& sha256sum -c ${ISOS.vanilla}.sha256`,
].join('\n');
---

<section class="chapter install" id="install" aria-labelledby="install-h">
  <div class="stage">
    <canvas class="stage-sky" data-stage-sky aria-hidden="true" hidden></canvas>
    <div class="stage-head">
      <h2 id="install-h"><span class="mark" aria-hidden="true"><arc-icon name="download-simple" size="xl"></arc-icon></span>Download Pulsar</h2>
      <p class="stage-sub">
        Pulsar is free and MIT-licensed. Both ISOs are rebuilt every week, one for Intel or AMD
        graphics and one with the NVIDIA driver.
      </p>
    </div>
    <div class="doors">
      {
        DOWNLOADS.map((d) => (
          <div class="door">
            <h3 class="door-name"><arc-icon name={d.icon} size="xl" aria-hidden="true"></arc-icon>{d.name}</h3>
            <p class="door-who">{d.who.split('\n').map((line, i) => (<>{i > 0 && <br />}{line}</>))}</p>
            {d.note && (
              <p class="door-note">
                {d.note} <a href="#mok">How to enroll it</a>
              </p>
            )}
            <div class="door-go">
              <arc-button href={`${ISO_BASE}/${d.file}`} variant="primary" size="lg">
                {d.button}
              </arc-button>
              <p class="door-file">
                <span class="mono">{d.file}</span>
                <span>About 4&nbsp;GB · verify with <a href={`${ISO_BASE}/${d.file}.sha256`}>.sha256</a>, <a href={`${ISO_BASE}/${d.file}.sha256.sigstore.json`}>.sigstore.json</a>, <a href={`${ISO_BASE}/${d.file}.sha256.sig`}>.sig</a> · image digest in <a href={`${ISO_BASE}/${d.file}.json`}>.json</a></span>
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <ol class="path" aria-label="From the download to your desktop">
    {
      STOPS.map((s, i) => (
        <li class="stop">
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <section class="faq" aria-labelledby="faq-h">
    <div class="faq-head">
      <h3 id="faq-h">Questions</h3>
      <a class="from" href="/docs/coming-from">
        <arc-icon name="arrows-left-right" size="md" aria-hidden="true"></arc-icon>
        <span>
          <strong>Coming from Windows or a Mac?</strong>
          <span class="from-d">Whether your computer can run it, and how to keep Windows next to it.</span>
        </span>
        <span class="from-go" aria-hidden="true">→</span>
      </a>
    </div>
    <div class="folds">
      <details class="fold">
        <summary>Will my games run?</summary>
        <div class="fold-body">
          <p>
            Some online games won’t start on Linux at all because their anti-cheat blocks it. Look
            your games up on
            <a href="https://areweanticheatyet.com">Are We Anti-Cheat Yet?</a> and
            <a href="https://www.protondb.com">ProtonDB</a> before you switch.
          </p>
          <p class="hint"><a href="/docs/gaming">What’s set up for games →</a></p>
        </div>
      </details>
      <details class="fold" id="mok">
        <summary>I have NVIDIA and Secure Boot on. What do I do?</summary>
        <div class="fold-body">
          <p>
            You enroll Pulsar’s driver key once and leave Secure Boot on. Until you do, the NVIDIA driver
            won’t load, and the desktop runs on the computer’s integrated graphics, or on the firmware’s
            basic display if it has none.
          </p>
          <p>
            From a terminal, run this and set a one-time password when it asks. After the restart,
            MokManager asks you to confirm. Choose <arc-kbd>Enroll MOK</arc-kbd>, then
            <arc-kbd>View key 0</arc-kbd>, <arc-kbd>Continue</arc-kbd> and <arc-kbd>Yes</arc-kbd>, and
            enter the password. The NVIDIA driver loads from then on.
          </p>
          <arc-code-block class="theme-fixed-dark" language="bash" filename="enroll the key" code={ENROL}></arc-code-block>
          <p>
            Or use GNOME Software, which offers to enroll the key while it isn’t enrolled. Follow its
            prompts and restart.
          </p>
          <p class="hint"><a href="/docs/install#secure-boot">Every screen, step by step →</a></p>
        </div>
      </details>
      <details class="fold">
        <summary>How do I check the ISO came from Pulsar?</summary>
        <div class="fold-body">
          <p>
            Each ISO’s checksum file is signed with Pulsar’s release key, and the signature is logged in
            Rekor, Sigstore’s public transparency log. Put the ISO, its <code>.sha256</code> and its
            <code>.sigstore.json</code> in one folder, and this checks the signature and its log entry,
            then the ISO against the checksum.
          </p>
          <arc-code-block class="theme-fixed-dark" language="bash" filename="verify" code={VERIFY}></arc-code-block>
        </div>
      </details>
    </div>
  </section>

  <div class="switch">
    <div class="switch-copy">
      <h3>Already on Silverblue or Kinoite?</h3>
      <p>
        You can switch in place with <code>bootc switch</code> and one restart. It replaces the OS
        image only, so your home folder and Flatpak apps aren’t touched, and the old system stays in
        the boot menu.
      </p>
    </div>
    <div class="switch-cmds">
      <arc-code-block class="theme-fixed-dark" language="bash" filename="Pulsar" code={switchTo(IMAGES.vanilla)}></arc-code-block>
      <arc-code-block class="theme-fixed-dark" language="bash" filename="Pulsar for NVIDIA" code={switchTo(IMAGES.nvidia)}></arc-code-block>
    </div>
  </div>

  <aside class="learn" aria-label="Documentation">
    <arc-icon name="book-open" size="md" aria-hidden="true"></arc-icon>
    <arc-button href="/docs" variant="secondary" size="sm">Read the docs</arc-button>
  </aside>
</section>

<style>
  /* ---- the stage: the theme's wallpaper behind the two downloads ------ */
  /* The hero's live sky, drawn into the stage's own canvas whenever the
     picture changes (src/scripts/sky.ts) -- the site theme's recolor of the
     look on show: it is the point of the stage. Nebula's still until then,
     and with no WebGL.

     The picture is dimmed a little (filter) and tinted toward the theme's
     panel color (::after); the rest of the contrast is in the text colors. */
  .stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-bottom: var(--space-2xl);
    padding: var(--space-2xl);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: var(--bg-deep);
  }
  .stage::before,
  .stage::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* the live sky, drawn straight in by scripts/sky.ts on each change; the
     still under it (::before) until then, and without WebGL */
  .stage-sky {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    filter: brightness(var(--stage-dim, 0.85));
  }
  :global(:root[data-theme='light']) .stage-sky {
    filter: contrast(0.82) brightness(var(--stage-dim, 1.1));
  }
  @media (prefers-color-scheme: light) {
    :global(:root[data-theme='auto']) .stage-sky {
      filter: contrast(0.82) brightness(var(--stage-dim, 1.1));
    }
  }
  .stage::before {
    z-index: -2;
    /* the picture itself, a little softer: its brightest lines (Tide's
       caustics, Nebula's filaments) stop fighting the text. Brightness only: contrast() would lift the black ground
       to a gray the page does not have, and dull every hue with it. */
    filter: brightness(var(--stage-dim, 0.85));
    background: url('/assets/nebula-still-dark.jpg') center / cover;
  }
  :global(:root[data-theme='light']) .stage::before {
    background: url('/assets/nebula-still-light.jpg') center / cover;
    /* on a light page, softened toward the paper instead (white stays
       white: 0.91 x 1.1) */
    filter: contrast(0.82) brightness(var(--stage-dim, 1.1));
  }
  @media (prefers-color-scheme: light) {
    :global(:root[data-theme='auto']) .stage::before {
      background: url('/assets/nebula-still-light.jpg') center / cover;
      filter: contrast(0.82) brightness(var(--stage-dim, 1.1));
    }
  }
  /* A tint in the theme's panel color, laid flat over the picture: it pulls
     the bright folds and the black ground toward the panel's tone (flatter,
     and in the theme's color) while the picture still reads through. */
  .stage::after {
    z-index: -1;
    background: var(--bg-elevated);
    /* per theme: data/stage.ts */
    opacity: var(--stage-tint, 0.48);
  }
  /* ---- what is on it: a heading row, then two doors ---------------------
     The heading, with its line beneath it; below, the two downloads
     split the panel in equal halves -- one per kind of graphics -- each
     with its name, one line, a button that says which it is, and the file. */
  .stage-head {
    display: grid;
    gap: var(--space-md);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid color-mix(in oklab, var(--text-primary) 18%, transparent);
  }
  .stage h2 {
    display: flex;
    align-items: flex-start;
    gap: 0.3em;
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.035em;
    margin: 0;
  }
  /* a tinted circle, as the agents' can / can't marks, sized to the heading
     -- the icon too, or on a phone ARC's fixed xl (32px) nearly fills it --
     and set on the first line, so a heading that wraps keeps it there */
  .stage h2 .mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 0.9em;
    height: 0.9em;
    margin-top: 0.05em;
    border-radius: var(--radius-full);
    color: var(--accent-primary);
    background: color-mix(in oklab, var(--accent-primary) 16%, transparent);
  }
  .stage h2 .mark arc-icon {
    width: 0.55em;
    height: 0.55em;
  }
  .door-name arc-icon {
    flex: none;
    color: var(--accent-primary);
  }
  .stage-sub {
    margin: 0;
    max-width: 58ch;
    font-size: var(--text-lg);
    color: var(--text-primary);
  }
  .doors {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .door {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    padding: var(--space-2xl) var(--space-2xl) 0 0;
    min-width: 0;
  }
  .door + .door {
    padding-left: var(--space-2xl);
    padding-right: 0;
    border-left: 1px solid color-mix(in oklab, var(--text-primary) 18%, transparent);
  }
  /* the name leads with its hardware's icon, in the accent, sized to it */
  .door-name {
    display: flex;
    align-items: center;
    gap: 0.35em;
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .door-who,
  .door-note {
    margin: 0;
  }
  .door-note {
    font-size: var(--text-sm);
  }
  /* to each door's foot, so the two buttons line up */
  .door-go {
    margin-top: auto;
    padding-top: var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }
  .door-go arc-button {
    display: inline-block;
  }
  .door-file {
    display: grid;
    gap: 2px;
    margin: 0;
    font-size: var(--text-xs);
    line-height: 1.6;
  }
  .door-file .mono {
    overflow-wrap: anywhere;
  }
  .door-file a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .door-file a:hover {
    color: var(--accent-primary);
  }
  /* three tones over the picture: primary for the headings, then two steps
     toward the theme's secondary gray */
  .stage .door-who,
  .stage .door-note {
    color: color-mix(in oklab, var(--text-primary) 70%, var(--text-secondary));
  }
  .stage .door-file {
    color: color-mix(in oklab, var(--text-primary) 45%, var(--text-secondary));
  }

  /* the path: three numbered steps -- big numerals, no line and no icon
     circles, so it does not echo the updates timeline just above */
  .path {
    list-style: none;
    margin: 0 0 var(--space-lg);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
    counter-reset: none;
  }
  .stop {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-md);
    align-items: start;
    min-width: 0;
  }
  .num {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: clamp(2.25rem, 3.6vw, 3rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--accent-primary);
    font-variant-numeric: tabular-nums;
  }
  .stop h3 {
    font-size: var(--text-lg);
    line-height: var(--heading-lh);
    margin: 0 0 var(--space-xs);
  }
  .stop p {
    margin: 0;
    color: var(--text-secondary);
  }
  /* ---- questions: a section of its own, heading beside the list -------- */
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-2xl);
    align-items: start;
    margin: var(--space-3xl) 0;
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--border-default);
  }
  .faq-head h3 {
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-sm);
  }
  .faq-head > p {
    margin: 0 0 var(--space-lg);
    color: var(--text-secondary);
  }
  .from {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) 0;
    border-block: 1px solid var(--border-subtle);
    color: var(--text-primary);
    text-decoration: none;
  }
  .from arc-icon {
    color: var(--accent-primary);
  }
  .from strong {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
  }
  .from-d {
    color: var(--text-secondary);
  }
  .from-go {
    font-size: var(--text-xl);
    color: var(--text-muted);
    transition: transform 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }
  .from:hover .from-go {
    color: var(--accent-primary);
    transform: translateX(4px);
  }

  /* ---- the questions: plain ruled rows --------------------------------- */
  .folds {
    border-top: 1px solid var(--border-subtle);
  }
  .fold {
    border-bottom: 1px solid var(--border-subtle);
  }
  .fold summary {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) 0;
    cursor: pointer;
    list-style: none;
    font-size: var(--text-lg);
    color: var(--text-primary);
  }
  .fold summary::-webkit-details-marker {
    display: none;
  }
  .fold summary::before {
    content: '+';
    width: 1ch;
    font-family: var(--font-mono);
    color: var(--accent-primary);
  }
  .fold[open] summary::before {
    content: '−';
  }
  .fold summary:hover {
    color: var(--accent-primary);
  }
  .fold-body {
    max-width: 62ch;
    padding: 0 0 var(--space-lg) calc(1ch + var(--space-sm));
  }
  .fold-body p {
    margin: 0 0 var(--space-md);
    color: var(--text-secondary);
  }
  .fold-body arc-code-block {
    display: block;
  }
  .fold-body .hint {
    margin: var(--space-sm) 0 0;
  }

  /* ---- the second way in ------------------------------------------------ */
  .switch {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-2xl);
    align-items: center;
  }
  .switch h3 {
    font-size: var(--text-2xl);
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-md);
  }
  .switch p {
    margin: 0;
    color: var(--text-secondary);
  }
  .switch-cmds {
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
  }
  .switch-cmds arc-code-block {
    display: block;
  }

  /* a sliver of its own: a slim band after the section's last ask, the way
     on to the docs */
  .learn {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin: var(--space-2xl) 0 0;
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklab, var(--accent-primary) 5%, transparent);
  }
  .learn arc-icon {
    flex: none;
    color: var(--accent-primary);
  }
  .learn p {
    flex: 1;
    margin: 0;
    color: var(--text-secondary);
  }
  .learn strong {
    color: var(--text-primary);
    font-weight: var(--font-display-weight);
  }
  .learn arc-button {
    flex: none;
  }
  @media (max-width: 40rem) {
    .learn {
      flex-wrap: wrap;
    }
    .learn p {
      flex-basis: calc(100% - 2.5rem);
    }
  }

  @media (max-width: 56rem) {
    .stage {
      padding: var(--space-xl) var(--space-lg);
    }
    .stage-head,
    .doors,
    .switch,
    .faq,
    .path {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-lg);
    }
    .doors {
      gap: 0;
    }
    .door,
    .door + .door {
      padding: var(--space-xl) 0 0;
      border-left: 0;
    }
    .door + .door {
      margin-top: var(--space-xl);
      border-top: 1px solid color-mix(in oklab, var(--text-primary) 18%, transparent);
    }
  }
</style>
