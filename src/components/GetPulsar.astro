---
// #install on the home page, and the page's one destination: "Get started"
// in the hero lands here. The downloads sit on Nebula, the wallpaper the hero
// draws live, so the page ends on the desktop it began with. Then the path
// from a stick to a desktop, the two things some people need (the NVIDIA key,
// checking the download) as folds, and the switch for people already on an
// atomic Fedora. /docs/install has every screen of it.
import { COSIGN_PUB, IMAGES, ISO_BASE, ISOS } from '../data/site';

const DOWNLOADS = [
  {
    key: 'standard',
    icon: 'laptop',
    name: 'Intel or AMD',
    who: 'Most laptops and desktops.\nNot sure what’s inside yours? Start here.',
    button: 'Download for Intel or AMD',
    file: ISOS.vanilla,
    note: null,
  },
  {
    key: 'nvidia',
    icon: 'graphics-card',
    name: 'NVIDIA GeForce',
    who: 'RTX cards, with the driver built in.',
    button: 'Download for NVIDIA',
    file: ISOS.nvidia,
    note: 'With Secure Boot on, you’ll enroll one key after installing.',
  },
];

const STOPS = [
  { i: 'usb', t: 'Write the ISO to a USB stick', d: 'Any stick of 8 GB or more. GNOME Disks does it, or Fedora Media Writer on Windows and macOS.' },
  { i: 'hard-drives', t: 'Boot it and install', d: 'You pick the disk and the layout. The installer asks before it changes anything.' },
  { i: 'sign-in', t: 'Log in', d: 'Choose a theme and, if you want one, a coding agent. Your apps finish installing in the background.' },
];

// Broken after the verb, so the short first line leaves the Copy button its
// own corner and a phone scrolls only the image name.
const switchTo = (image: string) => `sudo bootc switch \\\n  ${image}:latest`;
const ENROL = 'sudo mokutil --import /etc/pki/pulsar/MOK.der\nsudo systemctl reboot';
const VERIFY = [
  `cosign verify-blob ${ISOS.vanilla}.sha256 \\`,
  `  --key ${COSIGN_PUB} \\`,
  `  --signature ${ISOS.vanilla}.sha256.sig \\`,
  '  --insecure-ignore-tlog=true \\',
  `&& sha256sum -c ${ISOS.vanilla}.sha256`,
].join('\n');
---

<section class="chapter install" id="install" aria-labelledby="install-h">
  <div class="stage" data-stage-wall>
    <div class="stage-head">
      <h2 id="install-h"><span class="mark" aria-hidden="true"><arc-icon name="download-simple" size="xl"></arc-icon></span>Download Pulsar</h2>
      <p class="stage-sub">
        Pulsar is free, today and always, and every line of it is open source. Choose the download
        that matches your graphics, write it to any USB stick of 8&nbsp;GB or more, and you’re one
        restart away from your new desktop.
      </p>
    </div>
    <div class="doors">
      {
        DOWNLOADS.map((d) => (
          <div class="door">
            <h3 class="door-name"><arc-icon name={d.icon} size="xl" aria-hidden="true"></arc-icon>{d.name}</h3>
            <p class="door-who">{d.who.split('\n').map((line, i) => (<>{i > 0 && <br />}{line}</>))}</p>
            {d.note && (
              <p class="door-note">
                {d.note} <a href="#mok">How</a>
              </p>
            )}
            <div class="door-go">
              <arc-button href={`${ISO_BASE}/${d.file}`} variant="primary" size="lg">
                {d.button}
              </arc-button>
              <p class="door-file">
                <span class="mono">{d.file}</span>
                <span>5–6 GB · rebuilt weekly · verify with <a href={`${ISO_BASE}/${d.file}.sha256`}>.sha256</a>, <a href={`${ISO_BASE}/${d.file}.sha256.sig`}>.sig</a>, <a href={`${ISO_BASE}/${d.file}.json`}>.json</a></span>
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <ol class="path" aria-label="From the download to your desktop">
    {
      STOPS.map((s, i) => (
        <li class="stop">
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <section class="faq" aria-labelledby="faq-h">
    <div class="faq-head">
      <h3 id="faq-h">Questions</h3>
      <p>Before you install, and the two things only some computers need.</p>
      <a class="from" href="/docs/coming-from">
        <arc-icon name="arrows-left-right" size="md" aria-hidden="true"></arc-icon>
        <span>
          <strong>Coming from Windows or a Mac?</strong>
          <span class="from-d">Check your computer can run it, make the stick, and keep Windows alongside.</span>
        </span>
        <span class="from-go" aria-hidden="true">→</span>
      </a>
    </div>
    <div class="folds">
      <details class="fold">
        <summary>Is it really free?</summary>
        <div class="fold-body">
          <p>
            Yes, always. No account, no subscription, no trial, and nothing held back for a paid
            version. Pulsar is open source, and every nightly build is public.
          </p>
        </div>
      </details>
      <details class="fold">
        <summary>Can I keep Windows?</summary>
        <div class="fold-body">
          <p>
            Yes. Shrink Windows to make room, install Pulsar beside it, and choose one each time you
            turn the computer on.
          </p>
          <p class="hint"><a href="/docs/coming-from#dual-boot">Making room, step by step →</a></p>
        </div>
      </details>
      <details class="fold">
        <summary>How do updates work?</summary>
        <div class="fold-body">
          <p>
            A new build is made every night, downloads in the background, and is used from your next
            restart. Nothing restarts on its own, and the build you had stays in the boot menu.
          </p>
          <p class="hint"><a href="/docs/updates">How updates work →</a></p>
        </div>
      </details>
      <details class="fold">
        <summary>What if an update goes wrong?</summary>
        <div class="fold-body">
          <p>
            Choose the previous build in the boot menu, or run <code>sudo pulsar rollback</code>. If a
            new build fails its health checks while it starts, Pulsar goes back to the last good one
            by itself. Your files and apps stay as they are either way.
          </p>
          <p class="hint"><a href="/docs/updates#rollback">Rolling back →</a></p>
        </div>
      </details>
      <details class="fold">
        <summary>Will my games run?</summary>
        <div class="fold-body">
          <p>
            Most will. Steam and Heroic come with it and finish installing in the background after your
            first login, with Proton, gamemode, and on the NVIDIA image the driver for Flatpak games
            already set up.
          </p>
          <p>
            One honest exception: some online games use anti-cheat that refuses to run on Linux at
            all. That is the publisher’s choice, and no Linux system can get around it. Check the games
            you play on <a href="https://areweanticheatyet.com">Are We Anti-Cheat Yet?</a> and
            <a href="https://www.protondb.com">ProtonDB</a> before you switch.
          </p>
          <p class="hint"><a href="/docs/gaming">What’s set up for games →</a></p>
        </div>
      </details>
      <details class="fold" id="mok">
        <summary>I have NVIDIA and Secure Boot on. What do I do?</summary>
        <div class="fold-body">
          <p>
            Enroll Pulsar’s driver key once, and Secure Boot stays on. Either way works:
          </p>
          <p>
            <strong>Right away.</strong> Run this, choose a one-time password, and restart. A blue screen
            asks you to <arc-kbd>Enroll MOK</arc-kbd> and for that password. The NVIDIA driver loads from
            then on.
          </p>
          <arc-code-block class="theme-fixed-dark" language="bash" filename="enroll the key" code={ENROL}></arc-code-block>
          <p>
            <strong>Or just log in.</strong> The desktop starts on the open-source driver, and a moment later
            GNOME Software offers to enroll the key. Follow its prompts, restart, and you’re on NVIDIA.
          </p>
          <p class="hint"><a href="/docs/install#secure-boot">Every screen, step by step →</a></p>
        </div>
      </details>
      <details class="fold">
        <summary>How do I check the download is really yours?</summary>
        <div class="fold-body">
          <p>
            Each ISO’s checksum is signed with Pulsar’s release key. This checks the signature, then
            the ISO against the checksum.
          </p>
          <arc-code-block class="theme-fixed-dark" language="bash" filename="verify" code={VERIFY}></arc-code-block>
        </div>
      </details>
    </div>
  </section>

  <div class="switch">
    <div class="switch-copy">
      <h3>Already on Silverblue or Kinoite?</h3>
      <p>
        Switch in place with one command and a restart. Your files, apps and settings are kept, and
        the system you had is still in the boot menu.
      </p>
    </div>
    <div class="switch-cmds">
      <arc-code-block class="theme-fixed-dark" language="bash" filename="Pulsar" code={switchTo(IMAGES.vanilla)}></arc-code-block>
      <arc-code-block class="theme-fixed-dark" language="bash" filename="Pulsar for NVIDIA" code={switchTo(IMAGES.nvidia)}></arc-code-block>
    </div>
  </div>

  <aside class="learn" aria-label="Documentation">
    <arc-icon name="book-open" size="md" aria-hidden="true"></arc-icon>
    <p><strong>Looking to learn more?</strong> Install, themes, updates, agents: every detail is in the docs.</p>
    <arc-button href="/docs" variant="secondary" size="sm">Read the docs</arc-button>
  </aside>
</section>

<style>
  /* ---- the stage: the theme's wallpaper behind the two downloads ------ */
  /* The hero's live sky, as a still (--stage-wall: src/scripts/sky.ts
     snapshots the canvas whenever the picture changes -- the site theme's
     recolor of the look on show), at full strength: it is the point of the
     stage. Nebula's still until then, and with no WebGL.

     The picture is dimmed a little (filter) and tinted toward the theme's
     panel color (::after); the rest of the contrast is in the text colors. */
  .stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-bottom: var(--space-2xl);
    padding: var(--space-2xl);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: var(--bg-deep);
  }
  .stage::before,
  .stage::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .stage::before {
    z-index: -2;
    /* the picture itself, a little softer: its brightest lines (Tide's
       caustics, Nebula's filaments) stop fighting the text. Brightness only: contrast() would lift the black ground
       to a gray the page does not have, and dull every hue with it. */
    filter: brightness(var(--stage-dim, 0.85));
    background: var(--stage-wall, url('/assets/nebula-still-dark.jpg')) center / cover;
  }
  :global(:root[data-theme='light']) .stage::before {
    background: var(--stage-wall, url('/assets/nebula-still-light.jpg')) center / cover;
    /* on a light page, softened toward the paper instead (white stays
       white: 0.91 x 1.1) */
    filter: contrast(0.82) brightness(var(--stage-dim, 1.1));
  }
  @media (prefers-color-scheme: light) {
    :global(:root[data-theme='auto']) .stage::before {
      background: var(--stage-wall, url('/assets/nebula-still-light.jpg')) center / cover;
      filter: contrast(0.82) brightness(var(--stage-dim, 1.1));
    }
  }
  /* A tint in the theme's panel color, laid flat over the picture: it pulls
     the bright folds and the black ground toward the panel's tone (flatter,
     and in the theme's color) while the picture still reads through. */
  .stage::after {
    z-index: -1;
    background: var(--bg-elevated);
    /* per theme: data/stage.ts */
    opacity: var(--stage-tint, 0.4);
  }
  /* ---- what is on it: a heading row, then two doors ---------------------
     The heading, with its line beneath it; below, the two downloads
     split the panel in equal halves -- one per kind of graphics -- each
     with its name, one line, a button that says which it is, and the file. */
  .stage-head {
    display: grid;
    gap: var(--space-md);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid color-mix(in oklab, var(--text-primary) 18%, transparent);
  }
  .stage h2 {
    display: flex;
    align-items: center;
    gap: 0.3em;
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.035em;
    margin: 0;
  }
  /* a tinted circle, as the agents' can / can't marks, sized to the heading */
  .stage h2 .mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 0.9em;
    height: 0.9em;
    border-radius: var(--radius-full);
    color: var(--accent-primary);
    background: color-mix(in oklab, var(--accent-primary) 16%, transparent);
  }
  .door-name arc-icon {
    flex: none;
    color: var(--accent-primary);
  }
  .stage-sub {
    margin: 0;
    max-width: 58ch;
    font-size: var(--text-lg);
    color: var(--text-primary);
  }
  .doors {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .door {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    padding: var(--space-2xl) var(--space-2xl) 0 0;
    min-width: 0;
  }
  .door + .door {
    padding-left: var(--space-2xl);
    padding-right: 0;
    border-left: 1px solid color-mix(in oklab, var(--text-primary) 18%, transparent);
  }
  /* the name leads with its hardware's icon, in the accent, sized to it */
  .door-name {
    display: flex;
    align-items: center;
    gap: 0.35em;
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .door-who,
  .door-note {
    margin: 0;
  }
  .door-note {
    font-size: var(--text-sm);
  }
  /* to each door's foot, so the two buttons line up */
  .door-go {
    margin-top: auto;
    padding-top: var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }
  .door-go arc-button {
    display: inline-block;
  }
  .door-file {
    display: grid;
    gap: 2px;
    margin: 0;
    font-size: var(--text-xs);
    line-height: 1.6;
  }
  .door-file .mono {
    overflow-wrap: anywhere;
  }
  .door-file a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .door-file a:hover {
    color: var(--accent-primary);
  }
  /* three tones over the picture: primary for the headings, then two steps
     toward the theme's secondary gray */
  .stage .door-who,
  .stage .door-note {
    color: color-mix(in oklab, var(--text-primary) 70%, var(--text-secondary));
  }
  .stage .door-file {
    color: color-mix(in oklab, var(--text-primary) 45%, var(--text-secondary));
  }

  /* the path: three numbered steps -- big numerals, no line and no icon
     circles, so it does not echo the updates timeline just above */
  .path {
    list-style: none;
    margin: 0 0 var(--space-lg);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
    counter-reset: none;
  }
  .stop {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-md);
    align-items: start;
    min-width: 0;
  }
  .num {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: clamp(2.25rem, 3.6vw, 3rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--accent-primary);
    font-variant-numeric: tabular-nums;
  }
  .stop h3 {
    font-size: var(--text-lg);
    line-height: var(--heading-lh);
    margin: 0 0 var(--space-xs);
  }
  .stop p {
    margin: 0;
    color: var(--text-secondary);
  }
  /* ---- questions: a section of its own, heading beside the list -------- */
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-2xl);
    align-items: start;
    margin: var(--space-3xl) 0;
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--border-default);
  }
  .faq-head h3 {
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-sm);
  }
  .faq-head > p {
    margin: 0 0 var(--space-lg);
    color: var(--text-secondary);
  }
  .from {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) 0;
    border-block: 1px solid var(--border-subtle);
    color: var(--text-primary);
    text-decoration: none;
  }
  .from arc-icon {
    color: var(--accent-primary);
  }
  .from strong {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
  }
  .from-d {
    color: var(--text-secondary);
  }
  .from-go {
    font-size: var(--text-xl);
    color: var(--text-muted);
    transition: transform 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }
  .from:hover .from-go {
    color: var(--accent-primary);
    transform: translateX(4px);
  }

  /* ---- the questions: plain ruled rows --------------------------------- */
  .folds {
    border-top: 1px solid var(--border-subtle);
  }
  .fold {
    border-bottom: 1px solid var(--border-subtle);
  }
  .fold summary {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) 0;
    cursor: pointer;
    list-style: none;
    font-size: var(--text-lg);
    color: var(--text-primary);
  }
  .fold summary::-webkit-details-marker {
    display: none;
  }
  .fold summary::before {
    content: '+';
    width: 1ch;
    font-family: var(--font-mono);
    color: var(--accent-primary);
  }
  .fold[open] summary::before {
    content: '−';
  }
  .fold summary:hover {
    color: var(--accent-primary);
  }
  .fold-body {
    max-width: 62ch;
    padding: 0 0 var(--space-lg) calc(1ch + var(--space-sm));
  }
  .fold-body p {
    margin: 0 0 var(--space-md);
    color: var(--text-secondary);
  }
  .fold-body arc-code-block {
    display: block;
  }
  .fold-body .hint {
    margin: var(--space-sm) 0 0;
  }

  /* ---- the second way in ------------------------------------------------ */
  .switch {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-2xl);
    align-items: center;
  }
  .switch h3 {
    font-size: var(--text-2xl);
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-md);
  }
  .switch p {
    margin: 0;
    color: var(--text-secondary);
  }
  .switch-cmds {
    display: grid;
    gap: var(--space-sm);
    min-width: 0;
  }
  .switch-cmds arc-code-block {
    display: block;
  }

  /* a sliver of its own: a slim band after the section's last ask, the way
     on to the docs */
  .learn {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin: var(--space-2xl) 0 0;
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklab, var(--accent-primary) 5%, transparent);
  }
  .learn arc-icon {
    flex: none;
    color: var(--accent-primary);
  }
  .learn p {
    flex: 1;
    margin: 0;
    color: var(--text-secondary);
  }
  .learn strong {
    color: var(--text-primary);
    font-weight: var(--font-display-weight);
  }
  .learn arc-button {
    flex: none;
  }
  @media (max-width: 40rem) {
    .learn {
      flex-wrap: wrap;
    }
    .learn p {
      flex-basis: calc(100% - 2.5rem);
    }
  }

  @media (max-width: 56rem) {
    .stage {
      padding: var(--space-xl) var(--space-lg);
    }
    .stage-head,
    .doors,
    .switch,
    .faq,
    .path {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-lg);
    }
    .doors {
      gap: 0;
    }
    .door,
    .door + .door {
      padding: var(--space-xl) 0 0;
      border-left: 0;
    }
    .door + .door {
      margin-top: var(--space-xl);
      border-top: 1px solid color-mix(in oklab, var(--text-primary) 18%, transparent);
    }
  }
</style>
