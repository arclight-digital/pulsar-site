---
// The agent pillar: the one picture of an agent being handed a problem (the
// real crash notification, its words crash_notify_one's in cli/pulsar), and
// two short lists read across -- what an agent can do here and what it can't.
// The second list is the point, so it gets the same weight as the first.
// Titles only: every row is a page section in /docs/agents, and the limit
// (rollback covers the system, never the home folder) is linked, not buried.

const CAN = [
  'Read crash reports and logs',
  'Check system health and updates',
  'Create and apply themes',
  'Use a local model on your GPU',
];

const CANT = [
  'Modify the read-only system image',
  'Install system packages without your password (guard on)',
  'Read files outside the project (sandbox on)',
  'Change system config without a record (checkpoint taken)',
];
---

<section class="chapter" id="agents" aria-labelledby="agents-h">
  <div class="head">
    <div>
      <h2 id="agents-h">Coding agents, if you want them</h2>
      <p class="lede">
        Pick Claude Code, Codex, Gemini CLI, opencode or aider at first login, or skip it and nothing
        gets installed. The ones you pick know how Pulsar works, and a sandbox keeps them to one
        project.
      </p>
    </div>

    {/* The real notification, drawn. Not a control: the page has nothing to
        hand an agent, so the button is a picture of one. */}
    <figure class="notice" aria-label="The notification Pulsar shows when a program crashes">
      <div class="note" aria-hidden="true">
        <p class="note-app">Pulsar <span>· now</span></p>
        <p class="note-title">wireplumber crashed</p>
        <p class="note-body">
          Claude Code can read the stack trace and the logs, and help you fix or report it. Nothing
          is sent to it unless you click.
        </p>
        <span class="note-btn">Ask Claude Code</span>
      </div>
    </figure>
  </div>

  <div class="split">
    <div class="can">
      <h3 class="col-h">It can</h3>
      <ul class="rows">{CAN.map((r) => <li>{r}</li>)}</ul>
    </div>
    <div>
      <h3 class="col-h">It can’t</h3>
      <ul class="rows">{CANT.map((r) => <li>{r}</li>)}</ul>
    </div>
  </div>
  <p class="hint">
    Rollback restores the system, not your home folder. Keep backups.
    {' '}<a href="/docs/agents-safety">What an agent can access&nbsp;→</a>
  </p>
</section>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-2xl);
    align-items: center;
  }
  .lede {
    max-width: 52ch;
  }

  /* ---- the notification, drawn the way GNOME draws one ------------------ */
  .notice {
    margin: 0;
    display: grid;
    gap: var(--space-sm);
    justify-items: center;
  }
  .note {
    width: min(100%, 24rem);
    padding: var(--space-md) var(--space-lg) var(--space-lg);
    border-radius: var(--radius-xl);
    background: var(--bg-elevated);
    border: 1px solid var(--border-default);
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.55);
    color: var(--text-primary);
  }
  .note p {
    margin: 0;
  }
  .note-app {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-sm) !important;
  }
  .note-app span {
    color: var(--text-ghost);
  }
  .note-title {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-md);
    margin-bottom: var(--space-xs) !important;
  }
  .note-body {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--text-secondary);
    margin-bottom: var(--space-md) !important;
  }
  .note-btn {
    display: block;
    text-align: center;
    padding: var(--space-sm);
    border-radius: var(--radius-md);
    background: color-mix(in oklab, var(--accent-primary) 16%, transparent);
    color: var(--accent-primary);
    font-weight: var(--font-display-weight);
    font-size: var(--text-sm);
  }

  /* ---- can / can't: two plain ruled lists ------------------------------- */
  .split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2xl);
    margin-top: var(--space-2xl);
  }
  .col-h {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-lg);
  }
  .can .col-h {
    color: var(--accent-primary);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows li {
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  @media (max-width: 56rem) {
    .head,
    .split {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }
    .notice {
      justify-items: start;
    }
  }
</style>
