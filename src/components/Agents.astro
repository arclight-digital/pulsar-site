---
// The agent pillar: the one picture of an agent being handed a problem (the
// real crash notification, its words and both actions crash_notify_one's in
// cli/pulsar), and
// two short lists read across -- what an agent can do here and what it can't.
// The second list is the point, so it gets the same weight as the first.
// Titles only: every row is a page section in /docs/agents, and the limit
// (rollback covers the system, never the home folder) is linked, not buried.

const CAN = [
  'Read crash reports and logs',
  'Check system health and updates',
  'Create and apply themes',
  'Use a local model on your GPU',
];

const CANT = [
  'Modify the read-only system image',
  'Install system packages without your password (guard on)',
  'Read files outside the project (sandbox on)',
  'Change system config without a record (checkpoint taken)',
];
---

<section class="chapter" id="agents" aria-labelledby="agents-h">
  <div class="head">
    <div>
      <h2 id="agents-h">Coding agents, if you want them</h2>
      <p class="lede">
        Pick Claude Code, Codex, Gemini CLI, opencode or aider at first login, or skip it and nothing
        gets installed. The ones you pick know how Pulsar works, and a sandbox keeps them to one
        project.
      </p>
    </div>

    {/* The real notification, drawn. Not a control: the page has nothing to
        hand an agent, so the buttons are a picture of them. */}
    <figure class="notice" aria-label="The notification Pulsar shows when a program crashes">
      <div class="note" aria-hidden="true">
        <p class="note-app"><arc-icon name="warning" size="sm"></arc-icon>Pulsar <span>· now</span></p>
        <p class="note-title">wireplumber crashed</p>
        <p class="note-body">
          Claude Code can read the stack trace and the logs, and help you fix or report it. Nothing
          is sent to it unless you click.
        </p>
        <span class="note-btns">
          <span class="note-btn">Ask Claude Code</span>
          <span class="note-btn">Ignore this</span>
        </span>
      </div>
    </figure>
  </div>

  <div class="split">
    <div class="can">
      <h3 class="col-h"><span class="mark yes" aria-hidden="true"><arc-icon name="check" size="lg"></arc-icon></span>Agents can:</h3>
      <ul class="rows">{CAN.map((r) => <li>{r}</li>)}</ul>
    </div>
    <div>
      <h3 class="col-h"><span class="mark no" aria-hidden="true"><arc-icon name="x" size="lg"></arc-icon></span>Agents can’t:</h3>
      <ul class="rows">{CANT.map((r) => <li>{r}</li>)}</ul>
    </div>
  </div>
  <p class="hint">
    Rollback restores the system, not your home folder. Keep backups.
    {' '}<a href="/docs/agents-safety">What an agent can access&nbsp;→</a>
  </p>
</section>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-2xl);
    align-items: center;
  }
  .lede {
    max-width: 52ch;
  }

  /* ---- the notification, drawn the way Pulsar's GNOME draws one --------
     A banner in Pulsar's glass, over the page itself: the theme's raised
     surface as the tint, a little lighter at the top as glass reads, a rim
     lit from the top edge banners drop from, a faint inner edge, the
     theme's own border, a soft shadow, and the dither grain. */
  .notice {
    margin: 0;
    display: grid;
    justify-items: center;
  }
  .note {
    position: relative;
    width: min(100%, 24rem);
    padding: var(--space-md) var(--space-lg) var(--space-lg);
    border-radius: 18px;
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--bg-elevated) 82%, var(--text-primary) 6%),
      color-mix(in oklab, var(--bg-elevated) 70%, transparent)
    );
    backdrop-filter: blur(22px) saturate(1.35);
    -webkit-backdrop-filter: blur(22px) saturate(1.35);
    border: 1px solid var(--border-default);
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, var(--text-primary) 14%, transparent),
      inset 0 0 0 1px color-mix(in oklab, var(--text-primary) 4%, transparent),
      0 16px 44px -14px rgba(0, 0, 0, 0.5);
    color: var(--text-primary);
  }
  /* the light: a rim along the top edge, hottest at its middle, and a
     little of it spilled into the glass */
  .note::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    pointer-events: none;
    padding: 1px;
    background:
      radial-gradient(60% 120% at 50% 0%, color-mix(in oklab, var(--accent-primary) 55%, white) 0%, transparent 70%),
      transparent;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
  }
  .note::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background:
      radial-gradient(70% 45% at 50% 0%, color-mix(in oklab, var(--accent-primary) 14%, transparent), transparent 75%),
      url('/assets/dither.png');
    opacity: 0.9;
  }
  .note > * {
    position: relative;
    z-index: 1;
  }
  .note p {
    margin: 0;
  }
  .note-app {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin-bottom: var(--space-sm) !important;
  }
  .note-app arc-icon {
    color: var(--color-warning);
  }
  .note-app span {
    color: var(--text-muted);
  }
  .note-title {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-md);
    margin-bottom: var(--space-xs) !important;
  }
  .note-body {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--text-secondary);
    margin-bottom: var(--space-md) !important;
  }
  /* GNOME's notification actions: equal pills in a row across the banner's
     foot, in the order notify-send gave them (ask, then ignore) */
  .note-btns {
    display: flex;
    gap: var(--space-sm);
  }
  .note-btn {
    flex: 1 1 0;
    display: block;
    text-align: center;
    padding: var(--space-sm);
    border-radius: var(--radius-full);
    background: color-mix(in oklab, var(--text-primary) 10%, transparent);
    color: var(--text-primary);
    font-weight: var(--font-display-weight);
    font-size: var(--text-sm);
  }

  /* ---- can / can't: two plain ruled lists ------------------------------- */
  .split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2xl);
    margin-top: var(--space-2xl);
  }
  /* a tinted circle holding the check or the x, then the words */
  .col-h {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-size: var(--text-2xl);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-lg);
  }
  .mark {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-full);
  }
  .mark.yes {
    color: var(--color-success);
    background: color-mix(in oklab, var(--color-success) 16%, transparent);
  }
  .mark.no {
    color: var(--color-error);
    background: color-mix(in oklab, var(--color-error) 16%, transparent);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows li {
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  @media (max-width: 56rem) {
    .head,
    .split {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }
    .notice {
      justify-items: start;
    }
  }
</style>
