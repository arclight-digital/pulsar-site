---
// Pillar one: the themes. The preview is the hero's screenshot (Hero.astro),
// a real capture of the desktop in that theme, the tiles are the wallpapers
// the image renders for it, and picking one recolors this page through
// ARC's two-color contract -- the same move the engine makes on GNOME.
//
// Works without JavaScript: the first theme is shown, every tile is still a
// wallpaper and a name, and the command is in the code block. The script only
// adds the switching (src/scripts/themes.ts).
import { THEMES, label, setCommand, tileAttrs, variant } from '../data/themes';

const first = THEMES[0];
---

<section class="chapter showcase" id="themes" data-showcase>
  <h2>A theme engine for the whole desktop</h2>
  <p class="lede lines">
    <span>One palette colors GNOME Shell, GTK and Flatpak apps, the terminal, the editor and btop,</span>
    <span>and the glass and the wallpaper are drawn from it too.</span>
    <span>{THEMES.length} themes ship with Pulsar and Super+T switches between them.</span>
    <span>base16 schemes import directly, or your agent can make one.</span>
  </p>


  <ul class="tiles" role="list">
    {
      THEMES.map((t, i) => {
        const dark = variant(t, 'dark');
        const light = variant(t, 'light');
        return (
          <li>
            <button
              type="button"
              class="tile"
              aria-pressed={i === 0 ? 'true' : 'false'}
              {...tileAttrs(t)}
            >
              <span class="wall">
                {dark.wall ? (
                  <>
                    <img class="w-dark" src={dark.wall} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
                    {/* a one-look theme has one picture: its "light" falls back to it */}
                    {light.wall !== dark.wall && (
                      <img class="w-light" src={light.wall} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
                    )}
                  </>
                ) : (
                  // A theme with no pictures yet (placeholder: true) is drawn from the palette until
                  // the theme's own wallpaper render lands
                  <span class="ph" style={`--pa:${dark.accent};--pb:${dark.bg}`} />
                )}
              </span>
              {/* the accent the theme paints GNOME with: what tells one
                  theme from the next (their terminal palettes all look alike) */}
              <span class="swatch" aria-hidden="true" style={`--acc:${dark.accent};--acc-l:${light.accent}`} />
              <span class="t-name">{label(t)}</span>
            </button>
          </li>
        );
      })
    }
  </ul>

  {/* the theme being worn, as the command that wears it on a Pulsar
      desktop; the screenshot of it is the one under the hero */}
  <div class="cap">
    <span class="cap-name" data-preview-name>{label(first)}</span>
    <arc-code-block
      class="theme-fixed-dark"
      language="bash"
      filename="terminal"
      data-preview-cmd
      code={setCommand(first)}
    ></arc-code-block>
    <a class="more" href="/docs/themes">Theme docs →</a>
  </div>
</section>

<style>
  /* three set lines, each its own; the lede's balance would reflow them */
  .lines span {
    display: block;
  }
  .cap {
    display: grid;
    /* The command is one short line (the longest is `pulsar theme set
       tokyo-night`), so its column stops at a width that fits it and the
       copy button rather than stretching the whole figure: a full-width
       terminal around twenty-odd characters reads as empty chrome. It still
       shrinks below that on narrow screens (minmax 0). */
    grid-template-columns: auto minmax(0, 30rem) auto;
    justify-content: start;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
  }
  .cap-name {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-lg);
    color: var(--text-primary);
  }
  .cap arc-code-block {
    display: block;
    min-width: 0;
  }

  .tiles {
    list-style: none;
    margin: var(--space-xl) 0 var(--space-lg);
    padding: 0;
    display: grid;
    /* eight across: twenty-four themes land as three even rows of eight */
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: var(--space-md);
  }
  .tile {
    appearance: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-secondary);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .wall {
    display: block;
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    transition: border-color 0.2s var(--ease-out);
  }
  .wall img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* a one-look theme has no .w-light, and keeps its one picture in both modes */
  .w-light {
    display: none;
  }
  :global(:root[data-theme='light']) .w-light {
    display: block;
  }
  :global(:root[data-theme='light']) .w-dark:has(+ .w-light) {
    display: none;
  }
  @media (prefers-color-scheme: light) {
    :global(:root[data-theme='auto']) .w-light {
      display: block;
    }
    :global(:root[data-theme='auto']) .w-dark:has(+ .w-light) {
      display: none;
    }
  }
  .ph {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 30% 70%, color-mix(in oklab, var(--pa) 45%, transparent), transparent 60%),
      var(--pb);
  }
  .swatch {
    display: block;
    height: 4px;
    border-radius: var(--radius-full);
    background: var(--acc);
  }
  :global(:root[data-theme='light']) .swatch {
    background: var(--acc-l);
  }
  @media (prefers-color-scheme: light) {
    :global(:root[data-theme='auto']) .swatch {
      background: var(--acc-l);
    }
  }
  .t-name {
    font-size: var(--text-sm);
  }
  .tile:hover .wall {
    border-color: var(--border-bright);
  }
  .tile[aria-pressed='true'] .wall {
    border-color: var(--accent-primary);
  }
  .tile[aria-pressed='true'] .t-name {
    color: var(--text-primary);
  }
  .tile:focus-visible {
    outline: none;
  }
  .tile:focus-visible .wall {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .more {
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .more:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 64rem) {
    /* six even rows of four */
    .tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    /* a phone will not run it: the command to read, without its copy
       button (ARC's documented part, removed rather than restyled) */
    [data-preview-cmd]::part(copy) {
      display: none;
    }
    .cap {
      grid-template-columns: minmax(0, 1fr);
    }
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-sm);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wall {
      transition: none;
    }
  }
</style>
