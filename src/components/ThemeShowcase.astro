---
// Pillar one: the themes, shown before they are described. The preview is a
// real screenshot of the desktop in that theme, the tiles are the wallpapers
// the image renders for it, and picking one recolors this page through
// ARC's two-color contract -- the same move the engine makes on GNOME.
//
// Works without JavaScript: the first theme is shown, every tile is still a
// wallpaper and a name, and the command is in the code block. The script only
// adds the switching (src/scripts/themes.ts).
import { THEMES, label, setCommand, tileAttrs, variant } from '../data/themes';

const first = THEMES[0];
---

<section class="chapter showcase" id="themes" data-showcase>
  <h2>16 themes</h2>
  <p class="lede">
    Each one changes everything at once: the colors, your apps, the terminal and the wallpaper.
    You can always put the original look back.
  </p>

  <figure class="preview">
    <div class="shot">
      <img
        data-preview
        src={variant(first, 'dark').desktop}
        alt={`The Pulsar desktop in the ${label(first)} theme`}
        width="1600"
        height="1000"
        loading="lazy"
        decoding="async"
      />
    </div>
    <figcaption class="cap">
      <span class="cap-name" data-preview-name>{label(first)}</span>
      <arc-code-block
        class="theme-fixed-dark"
        language="bash"
        filename="terminal"
        data-preview-cmd
        code={setCommand(first)}
      ></arc-code-block>
    </figcaption>
  </figure>

  <ul class="tiles" role="list">
    {
      THEMES.map((t, i) => {
        const dark = variant(t, 'dark');
        const light = variant(t, 'light');
        return (
          <li>
            <button
              type="button"
              class="tile"
              aria-pressed={i === 0 ? 'true' : 'false'}
              {...tileAttrs(t)}
            >
              <span class="wall">
                {dark.wall ? (
                  <>
                    <img class="w-dark" src={dark.wall} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
                    <img class="w-light" src={light.wall} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
                  </>
                ) : (
                  // A theme with no pictures yet (placeholder: true) is drawn from the palette until
                  // the theme's own wallpaper render lands
                  <span class="ph" style={`--pa:${dark.accent};--pb:${dark.bg}`} />
                )}
              </span>
              <span class="swatch" aria-hidden="true">
                {dark.swatch.slice(2, 9).map((c) => <span style={`background:${c}`} />)}
              </span>
              <span class="t-name">{label(t)}</span>
            </button>
          </li>
        );
      })
    }
  </ul>

  <p class="more"><a href="/docs/themes">Theme docs →</a></p>
</section>

<style>
  .preview {
    margin: var(--space-xl) 0 var(--space-lg);
  }
  .shot {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--bg-deep);
    aspect-ratio: 16 / 10;
  }
  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.25s var(--ease-out);
  }
  .shot img[data-loading] {
    opacity: 0.4;
  }
  .cap {
    display: grid;
    /* The command is one short line (the longest is `pulsar theme set
       tokyo-night`), so its column stops at a width that fits it and the
       copy button rather than stretching the whole figure: a full-width
       terminal around twenty-odd characters reads as empty chrome. It still
       shrinks below that on narrow screens (minmax 0). */
    grid-template-columns: auto minmax(0, 30rem);
    justify-content: start;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
    margin-top: var(--space-md);
  }
  .cap-name {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-lg);
    color: var(--text-primary);
  }
  .cap arc-code-block {
    display: block;
    min-width: 0;
  }

  .tiles {
    list-style: none;
    margin: 0 0 var(--space-xl);
    padding: 0;
    display: grid;
    /* eight across: sixteen themes land as two even rows of eight */
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: var(--space-md);
  }
  .tile {
    appearance: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-secondary);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .wall {
    display: block;
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    transition: border-color 0.2s var(--ease-out);
  }
  .wall img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .w-light {
    display: none;
  }
  :global(:root[data-theme='light']) .w-light {
    display: block;
  }
  :global(:root[data-theme='light']) .w-dark {
    display: none;
  }
  @media (prefers-color-scheme: light) {
    :global(:root[data-theme='auto']) .w-light {
      display: block;
    }
    :global(:root[data-theme='auto']) .w-dark {
      display: none;
    }
  }
  .ph {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 30% 70%, color-mix(in oklab, var(--pa) 45%, transparent), transparent 60%),
      var(--pb);
  }
  .swatch {
    display: flex;
    height: 4px;
    border-radius: var(--radius-full);
    overflow: hidden;
  }
  .swatch span {
    flex: 1;
  }
  .t-name {
    font-size: var(--text-sm);
  }
  .tile:hover .wall {
    border-color: var(--border-bright);
  }
  .tile[aria-pressed='true'] .wall {
    border-color: var(--accent-primary);
  }
  .tile[aria-pressed='true'] .t-name {
    color: var(--text-primary);
  }
  .tile:focus-visible {
    outline: none;
  }
  .tile:focus-visible .wall {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .more {
    margin: 0;
  }
  .more a {
    text-decoration: none;
  }
  .more a:hover {
    text-decoration: underline;
  }

  @media (max-width: 64rem) {
    .tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .cap {
      grid-template-columns: minmax(0, 1fr);
    }
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-sm);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shot img,
    .wall {
      transition: none;
    }
  }
</style>
