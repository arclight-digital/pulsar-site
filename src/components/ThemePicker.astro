---
// The site-wide picker: a small floating trigger on every page, opening a
// sheet with two independent choices.
//
//   Theme      recolors the whole site through ARC's tokens (never its
//              parts), remembered across pages. A radio group of cards, each
//              a thumbnail of the theme in the page's current mode, in two
//              sets: the themes that follow light/dark, then the one-look
//              themes, which set the page's mode while worn. The page's
//              light/dark toggle sits beside the heading and gives way to a
//              "dark only" / "light only" note while a one-look theme holds
//              the mode (scripts/sitetheme.ts). Arrow keys move the check
//              (scripts/themes.ts).
//   Wallpaper  the home page's live sky in any of its looks, each in
//              the theme's colors as the OS recolors it (scripts/sky.ts).
//              Picking a theme switches to the look its own wallpaper uses.
//
// arc-sheet is modal: the page behind is inert (so focus stays in the
// sheet), Escape closes it, and focus returns to the trigger. Its scrim is
// kept light through its own custom properties so the recolor behind it is
// visible while choosing. Every card carries the theme's name as text.
import { THEMES, label, tileAttrs, variant, type Theme } from '../data/themes';

import { LOOK_LABELS as LOOKS } from '../data/looks';

// Two groups, in the image's own order: the themes that follow light/dark,
// then the ones with a single look, which set the page's mode themselves.
const oneLook = (t: Theme) => !(t.variants.dark && t.variants.light);
const GROUPS = [
  { id: 'pk-both', name: 'Light and dark', note: '', themes: THEMES.filter((t) => !oneLook(t)) },
  { id: 'pk-one', name: 'One look', note: 'picks light or dark for you', themes: THEMES.filter(oneLook) },
];

// The card is a thumbnail of the theme itself: its ground, its text, its
// accent and four of its terminal colors, from the same palette data the
// site recolors with. Both variants ride along as custom properties and the
// stylesheet shows the one the page is in, so a two-variant theme's card
// flips with the light/dark switch and a one-look theme's never does.
const cardVars = (t: Theme) =>
  (['dark', 'light'] as const)
    .map((m) => {
      const v = variant(t, m);
      const k = m[0];
      const c = [v.swatch[3], v.swatch[4], v.swatch[5], v.swatch[7]];
      return [
        `--${k}-bg:${v.bg}`,
        `--${k}-fg:${v.fg}`,
        `--${k}-ac:${v.accent}`,
        ...c.map((x, i) => `--${k}-c${i}:${x}`),
      ].join(';');
    })
    .join(';');
const only = (t: Theme) => (t.variants.dark ? 'dark' : 'light');
---

<button type="button" class="fab" data-picker-open data-fab aria-haspopup="dialog" aria-label="Choose a theme">
  <span class="fab-sw" aria-hidden="true"><i></i><i></i><i></i></span>
  <span class="fab-tx"><span class="fab-k">Theme</span><span class="fab-name" data-fab-name>Pulsar</span></span>
</button>

<arc-sheet side="right" heading="Make it yours" class="picker-sheet" data-picker>
  <section class="grp" aria-labelledby="pk-theme">
    <div class="grp-top">
      <h2 class="grp-h" id="pk-theme">Theme</h2>
      {/* The page's light/dark switch, here too. A one-look theme has nothing
          for it to switch: sitetheme.ts makes every toggle inert while one is
          worn, and this spot says which look it is instead. */}
      <span class="mode">
        <arc-theme-toggle size="sm" class="mode-toggle"></arc-theme-toggle>
        <span class="mode-only mode-only--dark"><arc-icon name="moon" size="sm"></arc-icon>Dark only</span>
        <span class="mode-only mode-only--light"><arc-icon name="sun" size="sm"></arc-icon>Light only</span>
      </span>
    </div>
    <p class="grp-note">Recolors the whole site, like <code>pulsar theme set</code> does your desktop.</p>
    <div class="themes" role="radiogroup" aria-labelledby="pk-theme" data-theme-radios>
      {
        GROUPS.map((g) => (
          <div class="set" role="group" aria-labelledby={g.id}>
            <p class="set-h" id={g.id}>
              <span>{g.name}</span>
              {g.note && <span class="set-note">{g.note}</span>}
            </p>
            <div class="cards">
              {g.themes.map((t) => (
                <button
                  type="button"
                  class="th"
                  role="radio"
                  aria-checked={t.slug === 'pulsar' ? 'true' : 'false'}
                  tabindex={t.slug === 'pulsar' ? 0 : -1}
                  {...tileAttrs(t)}
                >
                  <span class="th-pv" style={cardVars(t)} aria-hidden="true">
                    <span class="th-line">
                      <span class="th-prompt">&gt;</span>
                      <span class="th-text" />
                    </span>
                    <span class="th-dots">
                      <span />
                      <span />
                      <span />
                      <span />
                    </span>
                    {oneLook(t) && (
                      <span class="th-only">
                        <arc-icon name={only(t) === 'dark' ? 'moon' : 'sun'} size="xs" />
                      </span>
                    )}
                    <span class="th-check">
                      <svg viewBox="0 0 16 16" width="10" height="10">
                        <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </span>
                  <span class="th-name">
                    {label(t)}
                    {oneLook(t) && <span class="sr-only">, {only(t)} only</span>}
                  </span>
                </button>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="grp" aria-labelledby="pk-wall">
    <div class="grp-top">
      <h2 class="grp-h" id="pk-wall">Wallpaper</h2>
    </div>
    <p class="grp-note">The home page’s live sky, in the theme’s colors. Picking a theme switches to the look its own wallpaper uses.</p>
    <div class="looks" role="group" aria-label="Looks">
      {
        LOOKS.map((name, index) => (
          <button type="button" class="lk" data-look={index} aria-pressed={index === 0 ? 'true' : 'false'}>
            {/* filled by scripts/sky.ts: this look, rendered in the theme's colors */}
            <span class="lk-pv">
              <canvas data-look-thumb={index} width="256" height="160" aria-hidden="true" hidden></canvas>
              <span class="th-check lk-check">
                <svg viewBox="0 0 16 16" width="10" height="10">
                  <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </span>
            <span class="lk-name">{name}</span>
          </button>
        ))
      }
    </div>
  </section>

  <div slot="footer" class="foot">
    <span class="foot-note">Saved in this browser</span>
    <arc-button variant="ghost" size="sm" data-picker-reset>
      <arc-icon slot="prefix" name="arrow-counter-clockwise" size="sm"></arc-icon>
      Back to Pulsar
    </arc-button>
  </div>
</arc-sheet>

<arc-toast position="bottom-left" data-theme-toast></arc-toast>

<style>
  /* The theme button: the current theme's own colors as three overlapping
     dots, then its name. After half a screen of scrolling it folds to the
     dots alone (.is-compact, set below) and opens out again under the
     pointer or the keyboard. Solid ground: a translucent chip over arbitrary
     page content cannot promise its label's contrast. */
  .fab {
    position: fixed;
    right: var(--space-lg);
    bottom: var(--space-lg);
    z-index: 50;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.4rem 1rem 0.4rem 0.55rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-default);
    background: var(--bg-elevated);
    color: var(--text-primary);
    font: inherit;
    cursor: pointer;
    box-shadow: 0 10px 28px -12px rgba(0, 0, 0, 0.55);
    transition:
      padding 0.35s var(--ease-out-expo),
      gap 0.35s var(--ease-out-expo),
      border-color 0.2s var(--ease-out);
  }
  .fab:hover {
    border-color: var(--border-bright);
  }
  .fab:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }
  .fab-sw {
    display: inline-flex;
    flex: none;
  }
  .fab-sw i {
    width: 1.05rem;
    height: 1.05rem;
    border-radius: var(--radius-full);
    border: 2px solid var(--bg-elevated);
  }
  .fab-sw i + i {
    margin-left: -0.4rem;
  }
  .fab-sw i:nth-child(1) {
    background: var(--accent-primary);
  }
  .fab-sw i:nth-child(2) {
    background: var(--peri);
  }
  .fab-sw i:nth-child(3) {
    background: var(--text-primary);
  }
  .fab-tx {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    max-width: 14rem;
    overflow: hidden;
    white-space: nowrap;
    transition:
      max-width 0.35s var(--ease-out-expo),
      opacity 0.25s var(--ease-out);
  }
  .fab-k {
    font-family: var(--font-label);
    font-weight: var(--label-weight);
    font-size: var(--label-size);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .fab-name {
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .fab.is-compact:not(:hover):not(:focus-visible) {
    gap: 0;
    padding: 0.4rem 0.55rem;
  }
  .fab.is-compact:not(:hover):not(:focus-visible) .fab-tx {
    max-width: 0;
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .fab,
    .fab-tx {
      transition: none;
    }
  }
  .picker-sheet {
    --sheet-width: 460px;
    /* light scrim: the recolor behind the sheet should stay visible */
    --sheet-backdrop: rgba(0, 0, 0, 0.18);
    --sheet-backdrop-filter: none;
  }
  .grp + .grp {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border-subtle);
  }
  .grp-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    min-height: 2.25rem;
  }
  .grp-h {
    margin: 0;
    font-family: var(--font-label);
    font-weight: var(--label-weight);
    font-size: var(--label-size);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-primary);
  }
  .grp-h::before {
    content: '// ';
    font-family: var(--font-mono);
    letter-spacing: 0;
    color: var(--accent-primary);
  }
  .grp-note {
    margin: var(--space-xs) 0 var(--space-md);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .grp-note code {
    font-size: 0.92em;
    white-space: nowrap;
  }

  /* light/dark: the toggle while it can do something, a note while a
     one-look theme holds the mode */
  .mode {
    display: inline-flex;
    align-items: center;
  }
  .mode-only {
    display: none;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-default);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }
  :global(:root[data-mode-pinned]) .mode-toggle {
    display: none;
  }
  :global(:root[data-mode-pinned][data-theme='dark']) .mode-only--dark,
  :global(:root[data-mode-pinned][data-theme='light']) .mode-only--light {
    display: inline-flex;
  }

  .set + .set {
    margin-top: var(--space-md);
  }
  .set-h {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 var(--space-sm);
    margin: var(--space-md) 0 var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .set:first-child .set-h {
    margin-top: 0;
  }
  .set-note::before {
    content: '· ';
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-sm) var(--space-xs);
  }
  .th {
    appearance: none;
    display: grid;
    gap: 6px;
    width: 100%;
    min-width: 0;
    padding: 4px;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    background: none;
    color: var(--text-secondary);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background 0.15s var(--ease-out),
      border-color 0.15s var(--ease-out);
  }
  .th:hover {
    background: var(--bg-card);
    color: var(--text-primary);
  }
  .th[aria-checked='true'] {
    border-color: var(--accent-primary);
    background: var(--bg-card);
    color: var(--text-primary);
  }

  /* the thumbnail, in the variant the page is in */
  .th-pv {
    --bg: var(--d-bg);
    --fg: var(--d-fg);
    --ac: var(--d-ac);
    --c0: var(--d-c0);
    --c1: var(--d-c1);
    --c2: var(--d-c2);
    --c3: var(--d-c3);
    position: relative;
    display: grid;
    align-content: space-between;
    aspect-ratio: 16 / 10;
    padding: 7px 8px;
    border-radius: calc(var(--radius-md) - 2px);
    background: var(--bg);
    box-shadow:
      inset 0 0 0 1px rgba(128, 128, 128, 0.22),
      inset 0 -3px 0 var(--ac);
    overflow: hidden;
  }
  :global(:root[data-theme='light']) .th-pv {
    --bg: var(--l-bg);
    --fg: var(--l-fg);
    --ac: var(--l-ac);
    --c0: var(--l-c0);
    --c1: var(--l-c1);
    --c2: var(--l-c2);
    --c3: var(--l-c3);
  }
  @media (prefers-color-scheme: light) {
    :global(:root[data-theme='auto']) .th-pv,
    :global(:root:not([data-theme])) .th-pv {
      --bg: var(--l-bg);
      --fg: var(--l-fg);
      --ac: var(--l-ac);
      --c0: var(--l-c0);
      --c1: var(--l-c1);
      --c2: var(--l-c2);
      --c3: var(--l-c3);
    }
  }
  .th-line {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    color: var(--ac);
  }
  .th-text {
    flex: 0 1 60%;
    height: 4px;
    border-radius: 2px;
    background: var(--fg);
    opacity: 0.85;
  }
  .th-dots {
    display: flex;
    gap: 4px;
    margin-bottom: 3px;
  }
  .th-dots span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c0);
  }
  .th-dots span:nth-child(2) {
    background: var(--c1);
  }
  .th-dots span:nth-child(3) {
    background: var(--c2);
  }
  .th-dots span:nth-child(4) {
    background: var(--c3);
  }
  .th-only {
    position: absolute;
    right: 6px;
    bottom: 7px;
    display: inline-flex;
    color: var(--fg);
    opacity: 0.8;
  }
  .th-check {
    position: absolute;
    top: 5px;
    right: 5px;
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent-primary);
    color: var(--bg-deep);
    opacity: 0;
    transform: scale(0.4);
    transition:
      opacity 0.15s var(--ease-out),
      transform 0.25s var(--ease-out);
  }
  .th[aria-checked='true'] .th-check {
    opacity: 1;
    transform: none;
  }
  .th-name {
    overflow: hidden;
    padding: 0 2px;
    font-size: var(--text-xs);
    line-height: 1.3;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .th[aria-checked='true'] .th-name {
    font-weight: 700;
  }

  .th:focus-visible,
  .lk:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  /* the looks: cards like the themes', each a small frame of the live
     sky in the theme's colors (scripts/sky.ts renders them) */
  .looks {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-sm) var(--space-xs);
  }
  .lk {
    appearance: none;
    display: grid;
    gap: 6px;
    width: 100%;
    min-width: 0;
    padding: 4px;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    background: none;
    color: var(--text-secondary);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background 0.15s var(--ease-out),
      border-color 0.15s var(--ease-out);
  }
  .lk:hover {
    background: var(--bg-card);
    color: var(--text-primary);
  }
  .lk[aria-pressed='true'] {
    border-color: var(--accent-primary);
    background: var(--bg-card);
    color: var(--text-primary);
  }
  .lk-pv {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: calc(var(--radius-md) - 2px);
    background: var(--bg-deep);
    box-shadow: inset 0 0 0 1px rgba(128, 128, 128, 0.22);
    overflow: hidden;
  }
  /* pinned to the card, not sized from it: a canvas at height 100% of an
     aspect-ratio box kept its own 160px in Firefox and showed its corner */
  .lk-pv canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  .lk[aria-pressed='true'] .lk-check {
    opacity: 1;
    transform: none;
  }
  .lk-name {
    overflow: hidden;
    padding: 0 2px;
    font-size: var(--text-xs);
    line-height: 1.3;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .lk[aria-pressed='true'] .lk-name {
    font-weight: 700;
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    width: 100%;
  }
  .foot arc-button {
    margin-left: auto;
  }
  .foot-note {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* a phone: three across, the sheet a touch narrower than the screen */
  @media (max-width: 30rem) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .foot-note {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .fab {
      right: var(--space-md);
      bottom: var(--space-md);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fab,
    .th,
    .th-check {
      transition: none;
    }
  }
</style>
