---
// The front door: the mark, the wordmark, one line, one button. Its
// background is assets/shaders/pulsar.frag -- the same shader that renders
// the OS wallpapers -- running live in WebGL; src/scripts/sky.ts compiles it.
//
// Nothing here may move when ARC UI hydrates. Every box has its size before
// any script runs: the mark is an <img> with width and height, the words are
// text, and the one button is pre-rendered to declarative shadow DOM at build
// time and held to its final height below. The old hero lost 0.22 of layout
// shift on phones to two code blocks collapsing on hydration; there are no
// code blocks here, and the install commands live under #install.
//
// The wordmark wears ARC's hero device: a blurred bloom twin behind it,
// breathing on the hero's own glow knob so the light theme stays calm. The
// wordmark itself stays solid -- the brand draws it that way.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Mark from './Mark.astro';
import Sky from './Sky.astro';
import { bannerPost, postHref } from '../data/blog';
import { shotSrcset } from '../data/shots';
import { SUBLINE, TAGLINE } from '../data/site';
import { THEMES, label, setCommand, tileAttrs, variant } from '../data/themes';

// The desktop under the lockup: the first theme's real capture, the same
// [data-preview] picture scripts/themes.ts swaps when any theme is picked, so
// the swatches here, the tiles under #themes and the floating picker all
// change the one screenshot. It sits half in the sky and half over the page.
const FIRST = THEMES[0]!;
const SHOT = variant(FIRST, 'dark').desktop;

// Each swatch is the theme's own wallpaper, the render the image ships for
// it (the same files as the tiles under #themes), so the themes are told
// apart by what they look like rather than by a palette strip.

// Where the flywheel pivots: the mark's CORE, read from the shipped SVG at
// build time rather than typed in as a percentage. Each logo drop moves the
// core inside its cropped viewBox, and a hard-coded origin left over from the
// last drop makes the core orbit instead of spin. The light mark is staged
// onto this file's box (stage-assets.mjs), so the one origin serves both
// themes. The build runs from site/, so the repo root is one level up.
const MARK_SVG = join(process.cwd(), 'upstream', 'assets', 'brand', 'svg', 'pulsar-animated-large.svg');
function coreOrigin(svg: string): string {
  const box = svg.match(/<svg\b[^>]*\bviewBox="([^"]+)"/)?.[1]?.split(/[\s,]+/).map(Number);
  const core = svg.match(/<circle\b[^>]*\bclass="pl-core"[^>]*>/)?.[0];
  const cx = Number(core?.match(/\bcx="([^"]+)"/)?.[1]);
  const cy = Number(core?.match(/\bcy="([^"]+)"/)?.[1]);
  if (!box || box.length !== 4 || !Number.isFinite(cx) || !Number.isFinite(cy)) {
    throw new Error(`cannot find the viewBox and .pl-core circle in ${MARK_SVG}`);
  }
  const [x, y, w, h] = box;
  return `${(((cx - x) / w) * 100).toFixed(2)}% ${(((cy - y) / h) * 100).toFixed(2)}%`;
}
const markOrigin = coreOrigin(readFileSync(MARK_SVG, 'utf8'));

// The one piece of news, when a blog post has a banner and it is still
// fresh (src/data/blog.ts). A line of text above the mark, not a strip
// across the page: the hero stays the mark, the word and the button.
const news = await bannerPost();
---

<header class="hero">
  <Sky />

  <div class="inner">
    {
      news && (
        <a class="news" href={postHref(news)}>
          <span class="news-k">New</span>
          <span class="news-t">{news.data.banner}</span>
          <span class="news-go" aria-hidden="true">→</span>
        </a>
      )
    }
    {/* spin is the easter egg's hook -- see src/scripts/spin.ts. Inlined,
        so the mark wears the page's theme: pick one and it recolours. */}
    <Mark kind="hero" size={128} spin class="mark" style={`--mark-origin: ${markOrigin}`} />
    <h1 class="wordmark">
      <span class="glow-wrap">
        <span class="word">PULSAR</span>
        <span class="word word-shadow" aria-hidden="true">PULSAR</span>
      </span>
    </h1>
    <p class="tagline">{TAGLINE}</p>
    <p class="sub">{SUBLINE}</p>
    <div class="go">
      <arc-button href="#install" variant="primary" size="lg">Download Pulsar</arc-button>
    </div>

    {/* Toggle buttons, like the tiles under #themes: each one recolors the
        site, the sky and the screenshot below (scripts/themes.ts). Without
        JavaScript they are a row of palettes and the command still reads. */}
    <div class="try" role="group" aria-labelledby="try-h">
      <p class="try-h" id="try-h">
        Try a theme <span class="try-name" data-preview-name>{label(FIRST)}</span>
      </p>
      <ul class="chips" role="list">
        {
          THEMES.map((t, i) => {
            const dark = variant(t, 'dark');
            const light = variant(t, 'light');
            return (
              <li>
                <button
                  type="button"
                  class="chip"
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  aria-label={label(t)}
                  title={label(t)}
                  style={`--bg:${dark.bg}`}
                  {...tileAttrs(t)}
                >
                  {dark.wall && <img class="w-dark" src={dark.wall} alt="" width="1600" height="1000" decoding="async" />}
                  {light.wall && light.wall !== dark.wall && (
                    <img class="w-light" src={light.wall} alt="" width="1600" height="1000" decoding="async" />
                  )}
                  {/* the theme's accent along the foot, as on the tiles under #themes:
                      the one color it paints GNOME with, so the bar tells the
                      themes apart (their terminal palettes all look alike) */}
                  <span class="strip" aria-hidden="true" style={`--acc:${dark.accent};--acc-l:${light.accent}`} />
                </button>
              </li>
            );
          })
        }
      </ul>
      <code class="try-cmd" data-preview-cmd>{setCommand(FIRST)}</code>
    </div>
  </div>

  <figure class="peek">
    <img
      data-preview
      data-zoom
      src={SHOT}
      srcset={SHOT && shotSrcset(SHOT)}
      sizes="(max-width: 76rem) 100vw, 72rem"
      alt={`The Pulsar desktop in the ${label(FIRST)} theme`}
      width="1600"
      height="1000"
      decoding="async"
    />
  </figure>
</header>

<style>
  /* The sky holds the lockup and the swatches, then the desktop rises out of
     its bottom edge: --peek-w is the screenshot's width, and the last
     --peek-out of its height hangs below the sky over the page (Home.astro
     pads the first chapter by the same amount, from the same formula). The
     canvases fill the hero's box, which ends where the screenshot leaves it. */
  .hero {
    --peek-w: min(100vw - 2 * var(--space-lg), 72rem);
    --peek-out: calc(var(--peek-w) * 0.2625);
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    justify-items: center;
    padding-top: 6rem;
    background: url('/assets/nebula-still-dark.jpg') center / cover no-repeat var(--ink);
    color: var(--star);
    --glow-a: 1;
  }
  :global(:root[data-theme='light']) .hero {
    background-image: url('/assets/nebula-still-light.jpg');
    color: var(--deep);
    --glow-a: 0.4;
  }
  @media (prefers-color-scheme: light) {
    :global(:root[data-theme='auto']) .hero {
      background-image: url('/assets/nebula-still-light.jpg');
      color: var(--deep);
      --glow-a: 0.4;
    }
  }

  .inner {
    position: relative;
    /* its own stacking context, so the readability wash below sits behind
       the words but above the live sky */
    isolation: isolate;
    width: min(100% - 2 * var(--space-lg), 44rem);
    min-width: 0;
    align-self: end;
    padding: var(--space-xl) 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* A soft wash of the page's deepest ground behind the words. The live sky's
     filaments are bright enough to fight a line of text where they cross it;
     the wash calms the center and fades out long before the edges, so the
     sky still reads as alive around the lockup. --bg-deep follows the page
     theme and the site-wide theme picker, so it never shows as a dark box on
     a light page. The dither tile sits on top: a CSS gradient over the sky
     bands without it.

     The falloff is a mask, not the fill's own gradient: a gradient only fades
     the wash, and the dither tile over it stayed at full strength to the
     rectangle's edge -- a faint hatched box with a visible line around the
     lockup. Masked, the wash and its dither fade out together. The stops
     keep the old 70% / 40% / 0 profile (0.57 = 40 / 70). */
  .inner::before {
    content: '';
    position: absolute;
    inset: 0 -40%;
    z-index: -1;
    pointer-events: none;
    background: url('/assets/dither.png') repeat, color-mix(in oklab, var(--bg-deep) 70%, transparent);
    mask-image: radial-gradient(ellipse closest-side at 50% 50%, #000 0%, rgb(0 0 0 / 0.57) 50%, transparent 100%);
  }

  /* the news line: a contained strip of glass above the mark, so it reads as
     news and not as part of the lockup. Body size, not larger: it is
     prominent by its frame and ground, and the wordmark stays the biggest
     thing on the page. */
  .news {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-2xl);
    padding: var(--space-xs) var(--space-md);
    border: 1px solid color-mix(in oklab, var(--accent-primary) 45%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in oklab, var(--bg-deep) 70%, transparent);
    backdrop-filter: blur(8px);
    font-size: var(--text-sm);
    color: var(--text-primary);
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .news:hover {
    border-color: var(--accent-primary);
    background: color-mix(in oklab, var(--bg-deep) 85%, transparent);
  }
  .news:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 3px;
  }
  /* "New" is a word in the strip, set off by a hairline, not a badge of its
     own: one frame, not a pill inside a pill */
  .news-k {
    color: var(--accent-primary);
    font-weight: 600;
    padding-right: var(--space-sm);
    border-right: 1px solid color-mix(in oklab, var(--accent-primary) 45%, transparent);
  }
  .news-go {
    color: var(--accent-primary);
  }
  @media (max-width: 40rem) {
    .news {
      border-radius: var(--radius-lg);
      text-align: left;
    }
  }

  .hero :global(.mark) {
    display: block;
    margin-bottom: var(--space-lg);
    /* the core, not the box center: see --mark-origin in the frontmatter */
    transform-origin: var(--mark-origin, 50% 50%);
  }

  /* Easter egg: the mark is a flywheel -- src/scripts/spin.ts turns it
     about its core and writes --spin-glow from its speed (0 at rest, 1 at a
     hard flick). The glow is the house glow, on the page's accent, and costs
     nothing at rest: a zero-radius drop shadow. */
  .hero :global(.mark) {
    filter: drop-shadow(0 0 calc(var(--spin-glow, 0) * 22px) rgba(var(--accent-primary-rgb), calc(var(--spin-glow, 0) * 0.85)));
    will-change: transform;
  }

  .wordmark {
    margin: 0 0 var(--space-md);
    line-height: 1;
  }
  .glow-wrap {
    position: relative;
    display: block;
  }
  .word {
    position: relative;
    display: block;
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: clamp(2.4rem, 6.5vw, 4.25rem);
    letter-spacing: 0.3em;
    /* swallow the trailing tracking, so the word centers on its letters */
    margin-right: -0.3em;
    line-height: 1;
    z-index: 1;
  }
  /* ARC's hero device: the word the page is named for emits. A blurred bloom
     twin behind the wordmark -- hot white core, accent halo, wide secondary
     falloff. Copied from arcui.dev's own headline. */
  .word-shadow {
    position: absolute;
    inset: 0;
    color: transparent;
    text-shadow:
      0 0 14px rgba(255, 255, 255, calc(0.2 * var(--glow-a))),
      0 0 32px rgba(var(--accent-primary-rgb), calc(0.38 * var(--glow-a))),
      0 0 70px rgba(var(--accent-primary-rgb), calc(0.26 * var(--glow-a))),
      0 0 130px rgba(var(--accent-secondary-rgb), calc(0.22 * var(--glow-a)));
    filter: blur(6px);
    z-index: 0;
    pointer-events: none;
    user-select: none;
    animation: breathe 5s ease-in-out infinite alternate;
  }
  @keyframes breathe {
    from {
      opacity: 0.62;
    }
    to {
      opacity: 0.88;
    }
  }

  .tagline {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-xl);
    letter-spacing: -0.005em;
    margin: 0 0 var(--space-sm);
  }
  .sub {
    font-size: var(--text-lg);
    line-height: var(--body-lh);
    text-wrap: balance;
    opacity: 0.78;
    margin: 0 0 var(--space-xl);
  }


  /* The button's final box, reserved before hydration: ARC's lg button, so
     the declarative shadow DOM and the hydrated element are the same size
     and nothing under it can move. */
  .go {
    min-height: 3rem;
    display: flex;
    align-items: center;
  }
  .go arc-button {
    display: inline-block;
  }

  /* ---- try a theme: two rows of wallpaper chips ---------------------- */
  .try {
    margin-top: var(--space-2xl);
    display: grid;
    justify-items: center;
    gap: var(--space-sm);
    width: 100%;
  }
  .try-h {
    margin: 0;
    font-size: var(--text-sm);
    color: color-mix(in oklab, currentColor 72%, transparent);
  }
  .try-name {
    margin-left: var(--space-xs);
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    color: currentColor;
  }
  /* twelve across: the twenty-four themes as two even rows */
  .chips {
    list-style: none;
    margin: 0;
    padding: var(--space-xs);
    display: grid;
    grid-template-columns: repeat(12, auto);
    justify-content: center;
    gap: 0.375rem;
  }
  /* A wallpaper in a small frame of the theme's own background. Hover lifts
     it toward you; the one being worn carries a ring in the page's text
     color. */
  .chip {
    appearance: none;
    position: relative;
    display: block;
    width: 3.25rem;
    aspect-ratio: 16 / 10;
    padding: 0;
    border: 1px solid color-mix(in oklab, currentColor 18%, transparent);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--bg);
    box-shadow: 0 3px 8px -3px rgb(0 0 0 / 0.55);
    cursor: pointer;
    transition:
      transform 0.4s var(--ease-out-expo),
      box-shadow 0.2s ease;
  }
  .chip img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .strip {
    position: absolute;
    inset: auto 0 0 0;
    height: 5px;
    background: var(--acc);
  }
  :global(:root[data-theme='light']) .strip {
    background: var(--acc-l);
  }
  @media (prefers-color-scheme: light) {
    :global(:root[data-theme='auto']) .strip {
      background: var(--acc-l);
    }
  }
  /* a one-look theme has no .w-light, and keeps its one picture in both modes */
  .chip .w-light {
    display: none;
  }
  :global(:root[data-theme='light']) .chip .w-light {
    display: block;
  }
  :global(:root[data-theme='light']) .chip .w-dark:has(+ .w-light) {
    display: none;
  }
  @media (prefers-color-scheme: light) {
    :global(:root[data-theme='auto']) .chip .w-light {
      display: block;
    }
    :global(:root[data-theme='auto']) .chip .w-dark:has(+ .w-light) {
      display: none;
    }
  }
  .chip:hover {
    transform: translateY(-3px) scale(1.12);
    box-shadow: 0 8px 16px -6px rgb(0 0 0 / 0.6);
  }
  .chip[aria-pressed='true'] {
    border-color: transparent;
    box-shadow:
      0 0 0 2px var(--bg-deep),
      0 0 0 4px currentColor;
  }
  .chip:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 4px;
  }
  .try-cmd {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: color-mix(in oklab, currentColor 64%, transparent);
  }

  /* ---- the desktop, half in the sky ---------------------------------- */
  .peek {
    position: relative;
    z-index: 2;
    width: var(--peek-w);
    margin: var(--space-2xl) 0 calc(-1 * var(--peek-out));
    animation: rise 1.1s var(--ease-out-expo) both;
  }
  .peek img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-default);
    background: var(--bg-deep);
    box-shadow: 0 40px 90px -40px rgb(0 0 0 / 0.75);
  }
  /* the one entrance on the page: the desktop settles into place, from
     already visible */
  @keyframes rise {
    from {
      transform: translateY(2.5rem) scale(0.985);
      opacity: 0.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .word-shadow,
    .peek {
      animation: none;
    }
    .chip:hover {
      transform: none;
    }
  }

  @media (max-width: 40rem) {
    .hero :global(.mark) {
      --mk-fit: 88px;
    }
    /* one row that scrolls sideways under a thumb, faded at both ends,
       rather than a grid of tiny chips */
    .chips {
      display: flex;
      justify-content: flex-start;
      overflow-x: auto;
      max-width: calc(100vw - 2 * var(--space-lg));
      padding: var(--space-sm) var(--space-md);
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      mask-image: linear-gradient(90deg, transparent, #000 var(--space-md), #000 calc(100% - var(--space-md)), transparent);
    }
    .chips li {
      flex: none;
      scroll-snap-align: center;
    }
    .chip {
      width: 3.5rem;
    }
    .peek {
      margin-top: var(--space-xl);
    }
  }
</style>
