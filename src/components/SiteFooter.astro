---
// The close. Pinned dark in both themes, the way the terminals are: the page
// sinks back into the sky it opened on (the nebula still, the CI render of the
// same shader the hero runs live), under a spectrum line that is the palette
// read left to right, and signs off with the mark alone in that sky, its
// glow beating in the theme's accent.
import { getCollection } from 'astro:content';
import ByArclight from './ByArclight.astro';
import { posts } from '../data/blog';
import Mark from './Mark.astro';
import { BUILD_STATUS, REPO, SUPPORT_URL, TAGLINE } from '../data/site';

const SITE = [
  { label: 'Install', href: '/docs/install' },
  { label: 'Docs', href: '/docs' },
  { label: 'Themes', href: '/docs/themes' },
  { label: 'gamescale', href: '/docs/gamescale' },
  { label: 'Provenance', href: '/docs/provenance' },
  // release notes once a nightly has shipped them (see Docs.astro)
  ...((await getCollection('docs')).some((d) => d.id === 'releases') ? [{ label: 'Releases', href: '/docs/releases' }] : []),
  ...((await posts()).length ? [{ label: 'Blog', href: '/blog' }] : []),
  { label: 'Nightly builds', href: '/docs/changelog' },
  { label: 'The pulsar command', href: '/docs/cli' },
];

const MACHINE = [
  { label: 'Source', href: REPO },
  { label: 'Build status', href: BUILD_STATUS },
  { label: 'pulsar.frag', href: `${REPO}/blob/main/assets/shaders/pulsar.frag` },
  { label: 'changelog.json', href: '/changelog.json' },
  { label: 'manifest.json', href: '/manifest.json' },
  { label: 'MIT License', href: `${REPO}/blob/main/LICENSE` },
];
---

<div class="foot theme-fixed-dark">
  <div class="spectrum" aria-hidden="true"></div>
  <div class="sky" aria-hidden="true"></div>
  <arc-footer contained="lg" no-border>
    <div slot="logo" class="brand">
      {/* Static, and the small drawing: the brand package's placement for a
          44px footer mark. The pulse belongs to the top bar and the hero. */}
      <Mark kind="small" size={44} class="foot-mark" />
      <p class="word">PULSAR</p>
      <p class="tagline">{TAGLINE}</p>
    </div>

    <div>
      <p class="col-title">Site</p>
      <ul class="col">
        {SITE.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="col-title">Source and data</p>
      <ul class="col">
        {MACHINE.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="col-title">Arclight</p>
      <ul class="col">
        <li><a href="https://arclight.build">arclight.build</a></li>
        <li><a href="https://arcui.dev">ARC UI</a></li>
        <li><a href="https://github.com/arclight-digital">GitHub</a></li>
      </ul>
    </div>

    <div slot="legal" class="legal">
      <div class="colophons">
      <p class="colophon made">
        Free to download and MIT licensed. Made by Arclight Digital&nbsp;LLC.
        {SUPPORT_URL && <a href={SUPPORT_URL}>Support Pulsar&nbsp;→</a>}
      </p>
      </div>
      <ByArclight />
    </div>
  </arc-footer>
  {/* the sign-off: no words, the mark alone in the open sky, its light
      pulsing slowly in the theme's accent, the way a pulsar does */}
  <div class="beacon" aria-hidden="true">
    <Mark kind="small" size={52} class="beacon-mark" />
  </div>
</div>

<style>
  .foot {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--bg-deep);
    color: var(--text-primary);
  }
  /* The sky, faded in from the page's ink so there is no seam: dark at the
     links, open nebula by the sign-off. */
  .sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: url('/assets/nebula-still-dark.jpg') center 70% / cover no-repeat;
    mask-image: linear-gradient(180deg, transparent 0%, rgb(0 0 0 / 0.35) 45%, #000 100%);
    opacity: 0.9;
  }
  .foot arc-footer {
    background: transparent;
  }
  /* The open sky at the foot of the page, and the mark in it. Its glow
     beats every 4s, a quick rise and a long fade, in the accent of whatever
     theme the visitor is wearing. It also keeps the colophon clear of the
     fixed scroll-to-top button. */
  .beacon {
    display: grid;
    place-items: center;
    padding: var(--space-2xl) 0 var(--space-3xl);
  }
  .beacon :global(.beacon-mark) {
    display: block;
    filter: drop-shadow(0 0 10px rgba(var(--accent-primary-rgb), 0.35));
    animation: beat 4s cubic-bezier(0.2, 0.7, 0.2, 1) infinite;
  }
  @keyframes beat {
    0%,
    100% {
      filter: drop-shadow(0 0 8px rgba(var(--accent-primary-rgb), 0.25));
    }
    8% {
      filter: drop-shadow(0 0 26px rgba(var(--accent-primary-rgb), 0.8));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .beacon :global(.beacon-mark) {
      animation: none;
    }
  }
  .spectrum {
    height: 2px;
    background: linear-gradient(90deg, var(--cyan), var(--peri), var(--violet));
  }
  /* The lockup, then the tagline under the wordmark: a two-column grid puts
     the wordmark on the mark's middle and starts the tagline at the P. */
  .brand {
    display: grid;
    grid-template-columns: auto auto;
    justify-content: start;
    align-items: center;
    column-gap: var(--space-md);
    row-gap: var(--space-xs);
  }
  .brand :global(.foot-mark) {
    display: block;
  }
  .word {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-lg);
    letter-spacing: 0.3em;
    line-height: var(--glyph-lh);
    margin: 0;
  }
  .tagline {
    grid-column: 2;
    margin: 0;
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.4;
  }
  .col-title {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-label);
    font-weight: var(--label-weight);
    font-size: var(--label-size);
    letter-spacing: var(--label-spacing);
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .col {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .col a {
    display: inline-block;
    padding-block: var(--space-xs);
    color: var(--text-primary);
    text-decoration: none;
  }
  .col a:hover {
    color: var(--accent-primary);
    text-shadow: var(--glow-xs);
  }
  .legal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }
  .colophons {
    display: grid;
    gap: var(--space-xs);
  }
  .made {
    color: var(--text-secondary);
  }
  .made a,
  .soon {
    white-space: nowrap;
  }
  .soon {
    color: var(--text-muted);
  }
  .colophon {
    margin: 0;
    max-width: 44rem;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--body-lh);
  }
</style>
