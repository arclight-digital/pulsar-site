---
// The one site bar: the lockup; three destinations and a search field in the
// middle; the theme toggle, the source and Install on the right.
//
// It follows the page's light or dark mode everywhere. On the home page it is
// immersive -- transparent over the hero until scrolled -- so it never sits
// on the mark as a slab.
//
// Search is ARC's command palette over an index built with the site
// (src/data/search.ts): pages and their sections, the themes and the pulsar
// commands, ranked on the page with no service behind it. Ctrl K or ⌘ K
// opens it anywhere, and so does / outside a text field.
import { getCollection } from 'astro:content';
import Mark from './Mark.astro';
import { REPO } from '../data/site';
import { searchIndex } from '../data/search';

interface Props {
  path: string;
  immersive: boolean;
}

const { path, immersive } = Astro.props;
const onDocs = path === '/docs' || path.startsWith('/docs/');
// Releases only once a published nightly has shipped its notes (as the docs
// sidebar does), so the bar never links to a page that is not there yet.
const hasReleases = (await getCollection('docs')).some((d) => d.id === 'releases');
const NAV = [
  { label: 'Docs', href: '/docs', on: onDocs && path !== '/docs/themes' && path !== '/docs/releases' },
  { label: 'Themes', href: '/docs/themes', on: path === '/docs/themes' },
  ...(hasReleases ? [{ label: 'Releases', href: '/docs/releases', on: path === '/docs/releases' }] : []),
];
const groups = await searchIndex();
---

<arc-top-bar fixed contained="lg" immersive={immersive || undefined} home-href="/" class="bar">
  <a slot="logo" class="lockup" href="/" aria-label="Pulsar home">
    <Mark kind="bar" size={28} class="bar-mark" />
    <span class="word">PULSAR</span>
  </a>

  <div slot="center" class="center">
    <nav class="links" aria-label="Site">
      {NAV.map((l) => <a href={l.href} aria-current={l.on ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <button
      type="button"
      class="find"
      data-search-open
      aria-label="Search docs, themes and commands"
      aria-keyshortcuts="Control+K Meta+K /"
    >
      <arc-icon name="magnifying-glass" size="sm"></arc-icon>
      <span class="find-text">Search docs, themes, commands…</span>
      <kbd class="find-key" data-search-key>Ctrl K</kbd>
    </button>
  </div>

  <div slot="actions" class="actions">
    {/* shown only once the center links fold away, so Docs is never lost */}
    <a class="docs-compact" href="/docs" aria-current={onDocs ? 'page' : undefined}>Docs</a>
    <arc-theme-toggle icon-only size="md"></arc-theme-toggle>
    <arc-icon-button href={REPO} name="github-logo" label="Source on GitHub" variant="ghost" size="md"></arc-icon-button>
    <arc-button href="/#install" variant="primary" size="sm">Install</arc-button>
  </div>
</arc-top-bar>

<arc-command-palette data-search placeholder="Search docs, themes, commands…" max-results="12">
  {
    groups.map((g) => (
      <arc-command-group heading={g.heading}>
        {g.items.map((i) => (
          <arc-command-item value={i.href} icon={i.icon} description={i.description} keywords={i.keywords}>
            {i.label}
          </arc-command-item>
        ))}
      </arc-command-group>
    ))
  }
</arc-command-palette>

<script>
  import { detailOf, pick } from '../scripts/themes';

  const palette = document.querySelector<HTMLElement & { open: boolean }>('[data-search]');
  const show = () => {
    if (palette) palette.open = true;
  };
  document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', show));
  // name the key this machine has: ⌘ K on Apple, Ctrl K elsewhere
  if (/Mac|iPhone|iPad/.test(navigator.platform))
    document.querySelectorAll('[data-search-key]').forEach((k) => (k.textContent = '⌘ K'));
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement | null;
    const typing = !!t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName));
    if ((e.key === 'k' || e.key === 'K') && (e.ctrlKey || e.metaKey)) {
      e.preventDefault();
      show();
    } else if (e.key === '/' && !typing && !palette?.open) {
      e.preventDefault();
      show();
    }
  });
  palette?.addEventListener('arc-select', (e) => {
    const value = (e as CustomEvent<{ value: string }>).detail?.value;
    if (!value) return;
    // a theme result recolors the site through the picker's own path (the
    // theme panel's tiles are on every page); a page result goes there
    if (value.startsWith('theme:')) {
      const tile = document.querySelector<HTMLElement>(`[data-theme-tile="${CSS.escape(value.slice(6))}"]`);
      if (tile) pick(detailOf(tile));
      else location.assign('/docs/themes');
      return;
    }
    location.assign(value);
  });
</script>

<style>
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    color: inherit;
    text-decoration: none;
  }
  .lockup :global(.bar-mark) {
    display: block;
  }
  .word {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    letter-spacing: 0.3em;
    margin-right: -0.3em;
    font-size: var(--text-sm);
    line-height: var(--glyph-lh);
  }

  .center {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }
  .links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }
  .links a {
    padding: var(--space-xs) 0;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color 0.2s var(--ease-out);
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--text-primary);
  }

  /* A button that reads as a field: it opens the palette, it takes no text. */
  .find {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: 25rem;
    height: 2.5rem;
    padding: 0 0.5rem 0 0.875rem;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in oklab, var(--text-primary) 12%, transparent);
    background: color-mix(in oklab, var(--bg-base) 55%, transparent);
    backdrop-filter: blur(12px);
    color: var(--text-muted);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease-out),
      color 0.2s var(--ease-out);
  }
  .find:hover {
    border-color: color-mix(in oklab, var(--accent-primary) 45%, transparent);
    color: var(--text-secondary);
  }
  .find:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }
  .find-text {
    flex: 1;
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* small and quiet: a hint, not a second button */
  .find-key {
    flex: none;
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in oklab, var(--text-primary) 16%, transparent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.4;
    color: var(--text-muted);
  }

  .actions {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }
  /* the two icons, then a step, then Install */
  .actions arc-button {
    display: inline-block;
    margin-left: var(--space-md);
  }
  /* A single-mode theme pins the page's mode (scripts/sitetheme.ts), so
     the toggle has nothing to offer. Hidden, not removed: it keeps its slot. */
  :global(:root[data-mode-pinned]) .actions arc-theme-toggle {
    visibility: hidden;
  }
  /* No sidebar to toggle: ARC's bar still renders its hamburger on narrow
     screens, where it would toggle nothing. Hidden through its documented
     part -- a dead control removed, not a part restyled. */
  .bar::part(menu-btn) {
    display: none;
  }

  .docs-compact {
    display: none;
    margin-right: var(--space-sm);
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
  }
  .docs-compact[aria-current='page'] {
    color: var(--text-primary);
  }
  /* narrower: the links fold into a single Docs link on the right (the
     docs sidebar and the footer carry the rest), the field shrinks */
  @media (max-width: 64rem) {
    .links {
      display: none;
    }
    .docs-compact {
      display: inline;
    }
    .find {
      width: 15rem;
    }
  }
  /* then to its icon alone */
  @media (max-width: 48rem) {
    .find {
      width: 2.5rem;
      padding: 0;
      justify-content: center;
    }
    .find-text,
    .find-key {
      display: none;
    }
  }
  /* a phone keeps the mark, search, the toggle and Install; the word is the
     hero's first line, and the source link is also in the footer */
  @media (max-width: 30rem) {
    .actions arc-icon-button,
    .word {
      display: none;
    }
  }
</style>
