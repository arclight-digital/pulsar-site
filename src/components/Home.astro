---
// The home page: one idea per section, each in a shape of its own so the page
// never reads as one long list. What it is (the desktop), what it looks like
// (the themes), what it does for you (the agent, the games), why it stays good
// (the nightly loop), and how to get it. A sentence or two and a picture
// each; the detail lives in the docs they link to.
import Agents from './Agents.astro';
import GetPulsar from './GetPulsar.astro';
import Hero from './Hero.astro';
import ThemeShowcase from './ThemeShowcase.astro';
import Base from '../layouts/Base.astro';
import { version } from '../data/build';
import { shotSrcset } from '../data/shots';
import { THEMES, label, variant } from '../data/themes';

const DESCRIPTION =
  'Stylish, atomic, modern Linux, rebuilt every night on Fedora: twenty desktop themes, games that just run, and a coding agent if you want one.';

// The desktop, as the theme harness photographed it: Pulsar Holo, the house's
// other theme, since the themes section below opens on Pulsar's own.
const HOLO = THEMES.find((t) => t.slug === 'pulsar-holo') ?? THEMES[0]!;
const DESKTOP = variant(HOLO, 'dark').desktop;

// What a fresh install already has, one line each.
const READY = [
  'Thousands of apps, a click away',
  'Steam and your game launchers',
  'Sixteen themes to switch between',
  'A coding agent, if you want one',
];

// The nightly loop, left to right. The last station is the safety net.
const LOOP = [
  { i: 'moon', t: 'Built nightly', d: 'From current Fedora packages.' },
  { i: 'download-simple', t: 'Downloaded for you', d: 'In the background, on mains power.' },
  { i: 'arrow-clockwise', t: 'Ready at your next restart', d: 'A notification tells you, with a Restart button.' },
  { i: 'shield-check', t: 'Automatic rollback', d: 'If the new version fails to boot.' },
];

// gamescale's argument is arithmetic, so it is drawn: on a 2560x1600 laptop
// at 133%, each row's box is the size an X11 game renders at, against the
// screen's outline. Too small gets stretched, too big gets shrunk.
const SCREEN = 2560;
const MODES = [
  { what: 'GNOME default', res: [1920, 1200], you: 'Stretched to fit, blurry' },
  { what: 'GNOME, XWayland native scaling', res: [3840, 2400], you: 'Shrunk to fit, 2.25× the GPU work' },
  { what: 'With gamescale', res: [2560, 1600], you: 'Native, pixel for pixel', native: true },
];
---

<Base
  title="Pulsar — stylish, atomic, modern Linux, built on Fedora"
  ogTitle="Pulsar — your lighthouse in the sky"
  description={DESCRIPTION}
  path="/"
  immersive
>
  <Hero />
  <main id="main">
    <arc-container size="lg">
      <section class="chapter intro" id="about" aria-labelledby="about-h">
        <div class="intro-copy">
          <h2 id="about-h" class="statement">
            Your desktop, <span class="lift">ready to use.</span>
          </h2>
          <p class="big">
            It looks good the moment you log in, your apps and games are already there, and it keeps
            itself up to date.
          </p>
          <ul class="ready">
            {READY.map((r) => <li>{r}</li>)}
          </ul>
        </div>
        <figure class="desk">
          <img
            data-zoom
            src={DESKTOP}
            srcset={DESKTOP && shotSrcset(DESKTOP)}
            sizes="(max-width: 56rem) 100vw, 44rem"
            alt={`The Pulsar desktop in the ${label(HOLO)} theme: GNOME with the top bar, a terminal and the wallpaper.`}
            width="1600"
            height="1000"
            loading="lazy"
            decoding="async"
          />
          <figcaption>The {label(HOLO)} theme.</figcaption>
        </figure>
      </section>

      <ThemeShowcase />

      <Agents />

      <section class="chapter games" id="games" aria-labelledby="games-h">
        <div>
          <h2 id="games-h">Gaming</h2>
          <p class="lede">
            Steam, Heroic and Bottles install on your first boot, with the performance tools games want
            already set up. NVIDIA graphics work out of the box.
          </p>
          <h3 class="gs-h">
            <img src="/assets/gamescale.svg" alt="" width="32" height="32" loading="lazy" decoding="async" />
            gamescale
          </h3>
          <p class="gs-p">
            With display scaling on, many games get the wrong resolution and look blurry. gamescale sets
            the display to 100% while a game runs, and puts your scaling back when it quits.
          </p>
          <arc-code-block class="theme-fixed-dark" language="bash" filename="Steam launch options" code="gamescale %command%"></arc-code-block>
          <p class="more"><a href="/docs/gamescale">How gamescale works →</a></p>
        </div>
        <figure class="modes">
          <figcaption>
            <span class="m-cap">A 2560×1600 display at 133% scaling</span>
            <span class="legend">
              <span><i class="key key-screen" aria-hidden="true"></i>Your screen</span>
              <span><i class="key key-render" aria-hidden="true"></i>What the game renders</span>
            </span>
          </figcaption>
          <ul>
            {
              MODES.map((m) => {
                const k = m.res[0] / SCREEN;
                return (
                  <li class={m.native ? 'native' : undefined} style={`--k:${k};--slot:${Math.max(1, k)}`}>
                    <div class="slot" aria-hidden="true">
                      <span class="render" />
                      <span class="screen" />
                    </div>
                    <div class="m-x">
                      <p class="m-what">{m.what}</p>
                      <p class="m-res mono">{m.res[0]}×{m.res[1]}</p>
                      <p class="m-you">{m.you}</p>
                    </div>
                  </li>
                );
              })
            }
          </ul>
        </figure>
      </section>

      <section class="chapter" id="rot" aria-labelledby="rot-h">
        <h2 id="rot-h">Updates with an undo</h2>
        <p class="lede">
          A fresh version is built every night from the latest Fedora. Pulsar downloads it in the
          background while you’re plugged in, and it takes over the next time you restart. If it
          won’t start, you’re back on the old one.
        </p>
        <ol class="loop" aria-label="What happens between one build and the next">
          {
            LOOP.map((s, i) => (
              <li class={`station${i === LOOP.length - 1 ? ' safety' : ''}`}>
                <span class="badge" aria-hidden="true"><arc-icon name={s.i} size="md"></arc-icon></span>
                <p class="st-t">{s.t}</p>
                <p class="st-d">{s.d}</p>
              </li>
            ))
          }
        </ol>
        <p class="hint buildline">
          Last night’s build: <a href="/docs/changelog" class="mono" id="build-version" data-build-version>{version}</a>
          <span id="build-note" hidden></span>
          · <a href="/docs/updates">How updates work</a>
        </p>
        <p class="hint skip-note" data-skip-note hidden></p>
      </section>

      <GetPulsar />
    </arc-container>
  </main>
</Base>

<style>
  /* ---- intro: a statement and a short list beside the thing itself ---- */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-2xl);
    align-items: center;
    padding-top: var(--space-3xl);
  }
  .statement {
    font-size: clamp(2.4rem, 5.2vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0 0 var(--space-lg);
  }
  .lift {
    display: block;
    color: var(--accent-primary);
  }
  .big {
    font-size: var(--text-lg);
    text-wrap: balance;
    margin: 0 0 var(--space-md);
  }
  .ready {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ready li {
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }
  .desk {
    margin: 0;
    min-width: 0;
  }
  .desk img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-default);
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.6);
    background: var(--ink);
  }
  .desk figcaption {
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* ---- games: the copy, and the arithmetic beside it ------------------- */
  .games {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-2xl);
    align-items: center;
  }
  .games arc-code-block {
    display: block;
    max-width: 24rem;
    margin-bottom: var(--space-md);
  }
  .gs-h {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-xl);
    margin: var(--space-xl) 0 var(--space-sm);
  }
  .gs-h img {
    display: block;
  }
  .gs-p {
    max-width: 52ch;
    color: var(--text-secondary);
    margin: 0 0 var(--space-md);
  }
  /* ---- the gamescale diagram ----------------------------------------- */
  /* Every screen is the same size (--fw), so the three read at one scale.
     Each render is --k times it, centered on it; each row's slot is as tall
     as whichever of the two is taller (--slot), so the 150% render spills
     past its own screen but never into the next row. */
  .modes {
    --fw: 9rem;
    margin: 0;
  }
  .modes figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-lg);
    margin: 0 0 var(--space-sm);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .legend {
    display: flex;
    gap: var(--space-md);
  }
  .legend > span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }
  .key {
    display: inline-block;
    width: 1.25rem;
    height: 0.8rem;
    border-radius: 2px;
  }
  .key-screen {
    border: 1px dashed var(--text-muted);
  }
  .key-render {
    background: color-mix(in oklab, var(--text-primary) 16%, transparent);
    border: 1px solid color-mix(in oklab, var(--text-primary) 30%, transparent);
  }
  .modes ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .modes li {
    display: grid;
    grid-template-columns: calc(var(--fw) * 1.5 + var(--space-md)) minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: center;
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--border-subtle);
  }
  .slot {
    position: relative;
    height: calc(var(--fw) * 10 / 16 * var(--slot));
  }
  .screen,
  .render {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    aspect-ratio: 16 / 10;
  }
  .screen {
    width: var(--fw);
    border: 1px dashed var(--text-muted);
    border-radius: var(--radius-sm);
  }
  .render {
    width: calc(var(--fw) * var(--k));
    border-radius: 2px;
    background: color-mix(in oklab, var(--text-primary) 16%, transparent);
    border: 1px solid color-mix(in oklab, var(--text-primary) 30%, transparent);
  }
  .native .render {
    background: color-mix(in oklab, var(--accent-primary) 35%, transparent);
    border-color: var(--accent-primary);
  }
  .native .screen {
    border-color: transparent;
  }
  .m-x p {
    margin: 0;
  }
  .m-what {
    color: var(--text-primary);
  }
  .m-res {
    font-size: var(--text-xl);
    line-height: 1.3;
    color: var(--text-secondary);
  }
  .native .m-res {
    color: var(--accent-primary);
  }
  .m-you {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* ---- the nightly loop: four stations on one line -------------------- */
  .loop {
    list-style: none;
    margin: var(--space-xl) 0 var(--space-lg);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
    position: relative;
  }
  .loop::before {
    content: '';
    position: absolute;
    top: 23px;
    left: 24px;
    right: 24px;
    height: 1px;
    background: var(--border-default);
  }
  .station {
    position: relative;
    min-width: 0;
  }
  .badge {
    position: relative;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: var(--space-md);
    border-radius: var(--radius-full);
    background: var(--bg-deep);
    border: 1px solid var(--border-default);
    color: var(--accent-primary);
  }
  .safety .badge {
    border-color: var(--color-success);
    color: var(--color-success);
  }
  .st-t {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-lg);
    line-height: var(--heading-lh);
    margin: 0 0 var(--space-xs);
  }
  .st-d {
    margin: 0;
    color: var(--text-secondary);
  }
  .buildline {
    margin: 0;
  }
  .buildline a {
    color: var(--text-secondary);
  }
  .skip-note {
    margin: var(--space-sm) 0 0;
  }

  .more {
    margin: 0;
  }
  .more a {
    text-decoration: none;
  }
  .more a:hover {
    text-decoration: underline;
  }

  @media (max-width: 56rem) {
    .intro,
    .games {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }
    .loop {
      grid-template-columns: minmax(0, 1fr);
      padding-left: calc(48px + var(--space-md));
    }
    .loop::before {
      top: 24px;
      bottom: 24px;
      left: 23px;
      right: auto;
      width: 1px;
      height: auto;
    }
    .badge {
      position: absolute;
      left: calc(-48px - var(--space-md));
      top: 0;
      margin: 0;
    }
  }
</style>
