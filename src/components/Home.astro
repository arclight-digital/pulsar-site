---
// The home page: one idea per section, each in a shape of its own so the page
// never reads as one long list. What it is (the desktop), what it looks like
// (the themes), what it does for you (the agent, the games), why it stays good
// (the nightly loop), and how to get it. A sentence or two and a picture
// each; the detail lives in the docs they link to.
import Agents from './Agents.astro';
import GetPulsar from './GetPulsar.astro';
import Hero from './Hero.astro';
import ThemeShowcase from './ThemeShowcase.astro';
import Base from '../layouts/Base.astro';
import { release, version } from '../data/build';
import { shotSrcset } from '../data/shots';
import { BUILD_STATUS, SUBLINE, TAGLINE } from '../data/site';
import { THEMES, label, variant } from '../data/themes';

const DESCRIPTION = `${SUBLINE} Fedora Silverblue with 24 desktop themes, and Steam installed on first boot.`;

// The desktop, as the theme harness photographed it: Pulsar Holo, the house's
// other theme, since the themes section below opens on Pulsar's own.
const HOLO = THEMES.find((t) => t.slug === 'pulsar-holo') ?? THEMES[0]!;
const DESKTOP = variant(HOLO, 'dark').desktop;

// What a fresh install already has, one line each.
const READY = [
  'A coding agent, set up at first login',
  'Glass menus and windows, with 24 themes',
  'Steam, Heroic and Bottles, plus gamescope and MangoHud',
  'Unfiltered Flathub in GNOME Software',
  'Signed builds with Secure Boot on, plus an NVIDIA variant',
  'Pulsar Settings: one place for appearance and updates',
];

// The nightly loop, left to right. The last station is the safety net.
const LOOP = [
  { i: 'moon', t: 'Built when something changed', d: 'Only on nights when Fedora Silverblue’s packages, Pulsar’s repo or the extra packages Pulsar installs have changed.' },
  { i: 'download-simple', t: 'Downloaded on AC power', d: 'In the background, on an unmetered connection, 20 minutes after boot and about every 12 hours after that.' },
  { i: 'arrow-clockwise', t: 'Applied at your next restart', d: 'The notification has a Restart button. Updates never restart the computer themselves.' },
  { i: 'shield-check', t: 'Rolled back after three failed boots', d: 'greenboot checks each boot for a working desktop. After the third failure it restarts into the previous build.' },
];

// gamescale's argument is arithmetic, so it is drawn: on a 2560x1600 laptop
// at 133%, each row's box is the size an X11 game renders at, against the
// screen's outline. Too small gets stretched, too big gets shrunk. That
// laptop is the example the page is built with; the script after the figure
// swaps in the visitor's own screen when it can tell what that is.
const SCREEN = 2560;
const MODES = [
  { key: 'small', what: 'XWayland at 1×', res: [1920, 1200], you: 'Stretched to fit, blurry' },
  { key: 'big', what: 'GNOME’s default', res: [3840, 2400], you: 'Shrunk to fit, ', cost: 2.25 },
  { key: 'native', what: 'With gamescale', res: [2560, 1600], you: 'Native, pixel for pixel', native: true },
];
---

<Base
  title={`Pulsar | ${TAGLINE.replace(/\.$/, '').toLowerCase()}`}
  ogTitle={`Pulsar | ${TAGLINE.replace(/\.$/, '').toLowerCase()}`}
  description={DESCRIPTION}
  path="/"
  immersive
>
  <Hero />
  <main id="main">
    <arc-container size="lg">
      <section class="chapter intro" id="about" aria-labelledby="about-h">
        <div class="intro-copy">
          <h2 id="about-h" class="statement">
            The setup <span class="lift">is already done.</span>
          </h2>
          <p class="big">
            Pulsar is Fedora Silverblue. New builds download in
            the background and take over when you restart, and <code>sudo pulsar rollback</code> puts
            the previous one back.
          </p>
          <ul class="ready">
            {READY.map((r) => <li>{r}</li>)}
          </ul>
        </div>
        <figure class="desk">
          <img
            data-zoom
            src={DESKTOP}
            srcset={DESKTOP && shotSrcset(DESKTOP)}
            sizes="(max-width: 56rem) 100vw, 44rem"
            alt={`The Pulsar desktop in the ${label(HOLO)} theme: GNOME with the top bar, a terminal and the wallpaper.`}
            width="1600"
            height="1000"
            loading="lazy"
            decoding="async"
          />
          <figcaption>The {label(HOLO)} theme.</figcaption>
        </figure>
      </section>

      <ThemeShowcase />

      <Agents />

      <section class="chapter games" id="games" aria-labelledby="games-h">
        <div>
          <h2 id="games-h">Gaming</h2>
          <p class="lede">
            Steam, Faugus, Heroic and Bottles install on first boot, and GameMode, MangoHud and
            gamescope are in the image. NVIDIA cards (GTX 16 series, RTX 20 series and newer) get their
            own image with the driver built in.
          </p>
          <h3 class="gs-h">
            <img src="/assets/gamescale.svg" alt="" width="32" height="32" loading="lazy" decoding="async" />
            gamescale
          </h3>
          <p class="gs-p">
            <span data-gs="open">Take a screen with</span> <span data-gs="panel">2560×1600</span> pixels<span data-gs="join">. At</span>
            <span data-gs="pct">133%</span> scaling, GNOME treats it as <span data-gs="logical">1920×1200</span>.
            Games render at <span data-gs="times">twice</span> that, <span data-gs="xw">3840×2400</span>, and get
            shrunk to fit. gamescale sets scaling to 100% while a game runs, so it renders at the real
            <span data-gs="panel">2560×1600</span>, and puts it back when the game quits.
          </p>
          <arc-code-block class="theme-fixed-dark" language="bash" filename="Steam launch options" code="gamescale %command%"></arc-code-block>
          <p class="more"><a href="/docs/gamescale">How gamescale works →</a></p>
        </div>
        <figure class="modes">
          <figcaption>
            <span class="m-cap"><span data-gs="a">A</span> <span data-gs="panel">2560×1600</span> display at <span data-gs="pct">133%</span> scaling</span>
            <span class="legend">
              <span><i class="key key-screen" aria-hidden="true"></i>Your screen</span>
              <span><i class="key key-render" aria-hidden="true"></i>What the game renders</span>
            </span>
          </figcaption>
          <ul>
            {
              MODES.map((m, i) => {
                const k = m.res[0] / SCREEN;
                return (
                  <li class={m.key} data-gs-row={m.key} style={`--k:${k};--slot:${Math.max(1, k)};--i:${i}`}>
                    <div class="slot" aria-hidden="true">
                      <span class="render" />
                      <span class="screen" />
                      {!m.native && <arc-icon class="fit" name={k < 1 ? 'arrows-out' : 'arrows-in'} size="md"></arc-icon>}
                    </div>
                    <div class="m-x" data-no-widont>
                      <p class="m-what">{m.what}</p>
                      <p class="m-res mono" data-gs={m.native ? 'panel' : m.key === 'big' ? 'xw' : 'logical'}>{m.res[0]}×{m.res[1]}</p>
                      <p class="m-you">
                        {m.you}
                        {m.cost && <><span data-gs="cost">{m.cost}</span>× the GPU work</>}
                      </p>
                    </div>
                  </li>
                );
              })
            }
          </ul>
        </figure>
        {/* Inline, right after the figure, so the swap lands before first
            paint and before widont joins the last words. */}
        <script is:inline>
          (() => {
            // The visitor's own screen, when the browser tells us honestly.
            // On Wayland, Firefox and Chrome report the logical size as
            // screen.width/height and the fractional scale as
            // devicePixelRatio, so their product is the panel. Kept to the
            // 2560x1600 example: a whole-number scale (nothing to show), a
            // panel not on the list below (Chrome's page zoom changes the
            // ratio but not the size, so it invents panels), or a scale
            // GNOME doesn't offer (Firefox's zoom scales both, so the panel
            // comes out right and the scale doesn't).
            const PANELS = [
              [1920, 1080], [1920, 1200], [2160, 1440], [2256, 1504], [2400, 1600],
              [2496, 1664], [2560, 1440], [2560, 1600], [2560, 1664], [2880, 1620],
              [2880, 1800], [2880, 1864], [2880, 1920], [3000, 2000], [3024, 1964],
              [3072, 1920], [3200, 1800], [3200, 2000], [3456, 2234], [3840, 2160],
              [3840, 2400], [5120, 2880], [6016, 3384],
            ];
            const lw = screen.width, lh = screen.height, dpr = devicePixelRatio;
            if (!(lw > lh) || !(dpr > 1.05) || Math.abs(dpr - Math.round(dpr)) < 0.02) return;
            const panel = PANELS.find(([w, h]) => Math.abs(w - lw * dpr) <= w * 0.01 && Math.abs(h - lh * dpr) <= h * 0.01);
            if (!panel) return;
            const [pw, ph] = panel;
            const s = pw / lw;
            const SCALES = [1.25, 4 / 3, 1.5, 5 / 3, 1.75, 16 / 9, 2.25, 2.5, 2.75, 3.25, 3.5, 3.75];
            if (!SCALES.some((x) => Math.abs(x - s) < 0.015)) return;
            const n = Math.ceil(s);
            const x = (w, h) => `${w}×${h}`;
            const cost = Math.round((n / s) ** 2 * 100) / 100;
            const text = {
              open: 'Your screen has',
              join: ', but at',
              a: 'Your',
              panel: x(pw, ph),
              pct: `${Math.round(s * 100)}%`,
              logical: x(lw, lh),
              xw: x(lw * n, lh * n),
              times: n === 2 ? 'twice' : 'three times',
              cost: String(cost),
            };
            for (const el of document.querySelectorAll('#games [data-gs]')) el.textContent = text[el.dataset.gs];
            const fig = document.querySelector('#games .modes');
            fig.style.setProperty('--aw', pw);
            fig.style.setProperty('--ah', ph);
            fig.style.setProperty('--kmax', Math.max(1.5, n / s));
            for (const [row, k] of [['small', 1 / s], ['big', n / s], ['native', 1]]) {
              const li = fig.querySelector(`[data-gs-row="${row}"]`);
              li.style.setProperty('--k', k);
              li.style.setProperty('--slot', Math.max(1, k));
            }
          })();
        </script>
      </section>

      <section class="chapter" id="rot" aria-labelledby="rot-h">
        <h2 id="rot-h">Nightly builds</h2>
        <p class="lede">
          Each update is a whole new build of Pulsar, made overnight on top of Fedora Silverblue’s
          latest image. The build you had stays in the boot menu.
        </p>
        <ol class="loop" aria-label="What happens between one build and the next">
          {
            LOOP.map((s, i) => (
              <li class={`station${i === LOOP.length - 1 ? ' safety' : ''}`}>
                <span class="badge" aria-hidden="true"><arc-icon name={s.i} size="md"></arc-icon></span>
                <p class="st-t">{s.t}</p>
                <p class="st-d">{s.d}</p>
              </li>
            ))
          }
        </ol>
        {/* two facts and where to read more: a label and its value each,
            no underlines until hover. The beacon's note, when it has one,
            is its own line under them. */}
        <div class="buildline">
          <p class="facts">
            {release && (
              <a class="fact" href="/docs/releases">
                <span class="k">Release</span> <span class="v mono">{release}</span>
              </a>
            )}
            <a class="fact" href="/docs/changelog">
              <span class="k">Latest build</span>
              <span class="v mono" id="build-version" data-build-version>{version}</span>
            </a>
            <a class="go" href="/docs/updates">How updates work <span aria-hidden="true">→</span></a>
            <a class="go" href={BUILD_STATUS}>Build status <span aria-hidden="true">→</span></a>
          </p>
          <p class="hint build-note" id="build-note" hidden></p>
        </div>
        <p class="hint skip-note" data-skip-note hidden></p>
      </section>

      <GetPulsar />
    </arc-container>
  </main>
</Base>

<script>
  // the gamescale diagram moves only while it is on screen
  const modes = document.querySelector('.modes');
  if (modes)
    new IntersectionObserver(([e]) => modes.classList.toggle('is-live', e.isIntersecting), { threshold: 0.2 }).observe(modes);
</script>

<style>
  /* ---- intro: a statement and a short list beside the thing itself ---- */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-2xl);
    align-items: center;
    padding-top: var(--space-3xl);
  }
  .statement {
    font-size: clamp(2.4rem, 5.2vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0 0 var(--space-lg);
  }
  .lift {
    display: block;
    color: var(--accent-primary);
  }
  .big {
    font-size: var(--text-lg);
    text-wrap: balance;
    margin: 0 0 var(--space-md);
  }
  .ready {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ready li {
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }
  .desk {
    margin: 0;
    min-width: 0;
  }
  .desk img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-default);
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.6);
    background: var(--ink);
  }
  .desk figcaption {
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* ---- games: the copy, and the arithmetic beside it ------------------- */
  .games {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-2xl);
    align-items: center;
  }
  .games arc-code-block {
    display: block;
    max-width: 24rem;
    margin-bottom: var(--space-md);
  }
  .gs-h {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-xl);
    margin: var(--space-xl) 0 var(--space-sm);
  }
  .gs-h img {
    display: block;
  }
  .gs-p {
    max-width: 52ch;
    color: var(--text-secondary);
    margin: 0 0 var(--space-md);
  }
  /* ---- the gamescale diagram ----------------------------------------- */
  /* Every screen is the same size (--fw), so the three read at one scale.
     Each render is --k times it, centered on it; each row's slot is as tall
     as whichever of the two is taller (--slot), so the 150% render spills
     past its own screen but never into the next row. On a phone the screens
     shrink with the viewport (never past 9rem), so the words keep a column. */
  .modes {
    --fw: clamp(5rem, 22vw, 9rem);
    /* the screen's shape and the widest render; the inline script resets
       all three to the visitor's own screen */
    --aw: 16;
    --ah: 10;
    --kmax: 1.5;
    margin: 0;
  }
  .modes figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-lg);
    margin: 0 0 var(--space-sm);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .legend {
    display: flex;
    gap: var(--space-md);
  }
  .legend > span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }
  .key {
    display: inline-block;
    width: 1.25rem;
    height: 0.8rem;
    border-radius: 2px;
  }
  .key-screen {
    border: 1px dashed var(--text-muted);
  }
  .key-render {
    background: color-mix(in oklab, var(--text-primary) 16%, transparent);
    border: 1px solid color-mix(in oklab, var(--text-primary) 30%, transparent);
  }
  .modes ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .modes li {
    display: grid;
    grid-template-columns: calc(var(--fw) * var(--kmax) + var(--space-md)) minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: center;
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--border-subtle);
  }
  .slot {
    position: relative;
    height: calc(var(--fw) * var(--ah) / var(--aw) * var(--slot));
  }
  .screen,
  .render {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    aspect-ratio: var(--aw) / var(--ah);
  }
  .screen {
    width: var(--fw);
    border: 1px dashed var(--text-muted);
    border-radius: var(--radius-sm);
  }
  .render {
    width: calc(var(--fw) * var(--k));
    border-radius: 2px;
    background: color-mix(in oklab, var(--text-primary) 16%, transparent);
    border: 1px solid color-mix(in oklab, var(--text-primary) 30%, transparent);
  }
  /* The rows act out their words, on a slow loop while the diagram is on
     screen (.is-live, below): each render eases from its own size to the
     screen's and back -- the small one stretched up and softening, the big
     one shrunk down into it. gamescale's never moves: it already is the
     screen, and pulses. Still with reduced motion. */
  /* One thing moves at a time, in a 9s round: the small render stretches
     out and back, then the big one shrinks in and back, then gamescale's
     answers with one success pulse (its fill brightens and glows, and a
     ring of the accent leaves its edge), then a beat of stillness. */
  .modes.is-live .small .render {
    animation: pulsar-stretch 9s var(--ease-out-expo) infinite;
  }
  .modes.is-live .big .render {
    animation: pulsar-shrink 9s var(--ease-out-expo) infinite;
  }
  .modes.is-live .native .render {
    animation: pulsar-ok 9s ease-in-out infinite;
  }
  .native .render::after {
    content: '';
    position: absolute;
    inset: -1.5px;
    border: 1.5px solid var(--accent-primary);
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
  }
  .modes.is-live .native .render::after {
    animation: pulsar-ping 9s var(--ease-out-expo) infinite;
  }
  @keyframes pulsar-stretch {
    0%, 4%, 30%, 100% { transform: translate(-50%, -50%) scale(1); filter: none; }
    12%, 22% { transform: translate(-50%, -50%) scale(calc(1 / var(--k))); filter: blur(1.5px); }
  }
  @keyframes pulsar-shrink {
    0%, 34%, 60%, 100% { transform: translate(-50%, -50%) scale(1); }
    42%, 52% { transform: translate(-50%, -50%) scale(calc(1 / var(--k))); }
  }
  @keyframes pulsar-ok {
    0%, 64%, 86%, 100% {
      background: color-mix(in oklab, var(--accent-primary) 35%, transparent);
      box-shadow: 0 0 0 0 transparent;
    }
    72% {
      background: color-mix(in oklab, var(--accent-primary) 55%, transparent);
      box-shadow: 0 0 22px -4px color-mix(in oklab, var(--accent-primary) 60%, transparent);
    }
  }
  @keyframes pulsar-ping {
    0%, 66% { transform: scale(1); opacity: 0; }
    67% { transform: scale(1); opacity: 0.8; }
    84%, 100% { transform: scale(1.22); opacity: 0; }
  }
  /* the move named while it happens: corners out for the stretch, in for
     the shrink */
  .fit {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    color: var(--text-primary);
    opacity: 0;
    pointer-events: none;
  }
  .modes.is-live .small .fit {
    animation: pulsar-arrows-1 9s ease-out infinite;
  }
  .modes.is-live .big .fit {
    animation: pulsar-arrows-2 9s ease-out infinite;
  }
  @keyframes pulsar-arrows-1 {
    0%, 3%, 28%, 100% { opacity: 0; }
    8%, 22% { opacity: 0.85; }
  }
  @keyframes pulsar-arrows-2 {
    0%, 33%, 58%, 100% { opacity: 0; }
    38%, 52% { opacity: 0.85; }
  }
  @media (prefers-reduced-motion: reduce) {
    .modes.is-live .render,
    .modes.is-live .native .render::after,
    .modes.is-live .fit {
      animation: none;
    }
    /* still: the arrows stay, as the diagram's only sign of the move */
    .fit {
      opacity: 0.85;
    }
  }
  /* the answer: filled and outlined in the accent, its figure too */
  .native .render {
    background: color-mix(in oklab, var(--accent-primary) 35%, transparent);
    border: 1.5px solid var(--accent-primary);
  }
  .native .screen {
    border-color: transparent;
  }
  .native .m-res {
    color: var(--accent-primary);
  }
  .m-x p {
    margin: 0;
  }
  .m-what {
    color: var(--text-primary);
  }
  .m-res {
    font-size: var(--text-xl);
    line-height: 1.3;
    color: var(--text-secondary);
  }
  .native .m-res {
    color: var(--accent-primary);
  }
  .m-you {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* ---- the nightly loop: four stations on one line -------------------- */
  .loop {
    list-style: none;
    margin: var(--space-xl) 0 var(--space-lg);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
    position: relative;
  }
  .loop::before {
    content: '';
    position: absolute;
    top: 23px;
    left: 24px;
    right: 24px;
    height: 1px;
    background: var(--border-default);
  }
  .station {
    position: relative;
    min-width: 0;
  }
  .badge {
    position: relative;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: var(--space-md);
    border-radius: var(--radius-full);
    background: var(--bg-deep);
    border: 1px solid var(--border-default);
    color: var(--accent-primary);
  }
  .safety .badge {
    border-color: var(--color-success);
    color: var(--color-success);
  }
  .st-t {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: var(--text-lg);
    line-height: var(--heading-lh);
    margin: 0 0 var(--space-xs);
  }
  .st-d {
    margin: 0;
    color: var(--text-secondary);
  }
  .buildline {
    margin-top: var(--space-lg);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--space-xl);
    row-gap: var(--space-xs);
    margin: 0;
    font-size: var(--text-sm);
  }
  .fact,
  .go {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-sm);
    text-decoration: none;
  }
  .fact .k {
    color: var(--text-muted);
  }
  .fact .v {
    color: var(--text-primary);
  }
  .go {
    color: var(--text-secondary);
  }
  .fact:hover .v,
  .go:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .fact:focus-visible,
  .go:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  .build-note {
    margin: var(--space-sm) 0 0;
  }
  .skip-note {
    margin: var(--space-sm) 0 0;
  }

