---
// The blog's shell, inside the site's Base: a masthead over the tinted sky
// (BlogSky.astro), then the page. A post gets a reading column with a rail
// beside it, the contents that follow the scroll, set like the docs' so a
// post and a guide read as the same site; the index and an author's page
// get one wider column.
//
// Slots: `head` is the masthead (the page's h1 lives there), the default
// slot is the page, `rail` is the optional column beside it.
import BlogSky from '../components/BlogSky.astro';
import Base from './Base.astro';
import { REPO } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  crumb: string;
  jsonLd?: Record<string, unknown>[];
  /** the index's one wide column rather than a post's reading measure */
  wide?: boolean;
}
const { title, description, path, crumb, jsonLd = [], wide = false } = Astro.props;
const rail = Astro.slots.has('rail');
---

<Base title={title} crumb={crumb} description={description} path={path} jsonLd={jsonLd}>
  <main id="main" class="blog">
    <BlogSky />
    <arc-container size="lg">
      <div class:list={['grid', { wide, 'has-rail': rail }]}>
        <header class="head">
          <slot name="head" />
        </header>
        <div class="body">
          <slot />
          <p class="provenance">
            Written with help from AI and reviewed by a person before publishing.
            Spotted a mistake? <a href={`${REPO}/issues`}>Let us know.</a>
          </p>
        </div>
        {
          rail && (
            <aside class="rail">
              <slot name="rail" />
            </aside>
          )
        }
      </div>
    </arc-container>
  </main>
</Base>

<style>
  .blog {
    position: relative;
    padding-top: var(--space-4xl);
  }
  /* above the sky */
  .blog > arc-container {
    position: relative;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 46rem);
    grid-template-areas: 'head' 'body';
    justify-content: center;
    column-gap: var(--space-3xl);
    padding-bottom: var(--space-3xl);
  }
  .grid.wide {
    grid-template-columns: minmax(0, 52rem);
  }
  .grid.has-rail {
    grid-template-columns: minmax(0, 46rem) 13rem;
    grid-template-areas: 'head .' 'body rail';
  }
  .head {
    grid-area: head;
    padding: var(--space-2xl) 0 var(--space-2xl);
  }
  .body {
    grid-area: body;
    min-width: 0;
  }
  .rail {
    grid-area: rail;
    position: sticky;
    top: var(--space-4xl);
    align-self: start;
    max-height: calc(100svh - var(--space-4xl));
    overflow-y: auto;
  }

  .head :global(h1) {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
    margin: 0 0 var(--space-lg);
  }
  .head :global(.lede) {
    font-size: clamp(var(--text-lg), 2vw, var(--text-xl));
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 40em;
    margin: 0;
  }

  .provenance {
    margin-top: var(--space-3xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border-subtle);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .provenance a {
    color: inherit;
  }

  @media (max-width: 72rem) {
    .grid.has-rail {
      grid-template-columns: minmax(0, 46rem);
      grid-template-areas: 'head' 'body';
    }
    .rail {
      display: none;
    }
  }
  @media (max-width: 40rem) {
    .head {
      padding-top: var(--space-lg);
    }
  }
</style>
