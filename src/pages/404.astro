---
// Served for any path the build did not write (wrangler.jsonc sets
// not_found_handling to 404-page, so the Worker answers with this page and a
// real 404 status). noindex, out of the sitemap, and no canonical: it stands
// for no URL.
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found | Pulsar"
  description="There’s no page at this address."
  path="/404"
  noindex
>
  <main id="main" class="page">
    <arc-container size="lg">
      <arc-page-header border>
        <h1 slot="heading">Nothing here</h1>
        <p slot="description">There’s no page at this address.</p>
      </arc-page-header>

      <section class="chapter">
        <h2>Try one of these</h2>
        <arc-divider class="h-rule" align="left" variant="line-gradient"></arc-divider>
        <ul class="ways">
          <li><a href="/">The Pulsar home page</a></li>
          <li><a href="/docs/install">Install Pulsar</a></li>
          <li><a href="/docs/changelog">Nightly builds</a></li>
          <li><a href="/docs/cli">The pulsar command</a></li>
        </ul>
      </section>
    </arc-container>
  </main>
</Base>

<style>
  .ways {
    display: grid;
    gap: var(--space-sm);
    padding-left: 1.25rem;
    font-size: var(--text-lg);
  }
</style>
