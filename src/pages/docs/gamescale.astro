---
import Gamescale from '../../components/Gamescale.astro';
import Docs from '../../layouts/Docs.astro';
import { APP_ID, ORG_ID } from '../../data/site';

const DESCRIPTION =
  'gamescale gives each game your screen’s real resolution under GNOME fractional scaling, and puts the scale back when it quits, even if the game dies.';

const FLATPAK_ERR =
  '$ flatpak run --command=sh --filesystem=/usr/bin/gamescale:ro com.valvesoftware.Steam\nF: Not sharing "/usr/bin/gamescale" with sandbox: Path "/usr" is reserved by Flatpak';
const JSONLD = [
  {
    '@type': 'TechArticle',
    headline: 'gamescale',
    description: DESCRIPTION,
    about: { '@id': APP_ID },
    author: { '@id': ORG_ID },
    publisher: { '@id': ORG_ID },
    url: new URL('/docs/gamescale', Astro.site).href,
  },
];
const SETUP = 'pulsar setup gamescale --platform <name>';
const TOC = [
  { id: 'how', label: 'How it works', level: 2 },
  { id: 'in-the-image', label: 'What ships in the image', level: 2 },
  { id: 'steam', label: 'Flatpak Steam', level: 2 },
  { id: 'flatpak', label: 'Other Flatpak launchers', level: 2 },
];
---

<Docs
  title="gamescale"
  fullTitle="gamescale — native-resolution games with fractional scaling"
  description={DESCRIPTION}
  path="/docs/gamescale"
  headings={TOC}
  jsonLd={JSONLD}
>
  <p class="above"><img class="gs-icon" src="/assets/gamescale.svg" alt="" width="48" height="48" /></p>
  <h1>gamescale</h1>
  <p class="intro">Your screen’s real resolution, for one game at a time.</p>

  <h2 id="how">How it works</h2>
  <Gamescale />

  <h2 id="in-the-image">What ships in the image</h2>
  <p>
    <a href="https://github.com/arclight-digital/gamescale">gamescale</a> (pinned, hash-verified):{' '}
    <code>/usr/bin/gamescale</code>, its top-bar indicator, and a unit that restores your scale if
    a game crashes. That’s all native launchers and terminal use need.
  </p>

  <h2 id="steam">Flatpak Steam needs nothing</h2>
  <p>Flatpak apps can’t see the host’s <code>/usr</code>:</p>
  <arc-code-block class="theme-fixed-dark" language="bash" filename="flatpak" code={FLATPAK_ERR}></arc-code-block>
  <p>
    At every boot <code>pulsar-steam-grants.service</code> gives Steam a read-only view of the
    host OS and puts a directory holding only <code>gamescale</code>, <code>gg</code> and{' '}
    <code>ggm</code> on its <code>PATH</code>. Steam runs the image’s copies, which update with the
    image. If you set gamescale up for Steam on an older image, run{' '}
    <code>pulsar setup gamescale</code> once: it points Steam back at the image’s copies and removes
    old copies in <code>~/.local/bin</code> that match them.
  </p>

  <h2 id="flatpak">Other Flatpak launchers need one step</h2>
  <p>Heroic, Faugus, Bottles and other launchers get gamescale under <code>$HOME</code>:</p>
  <arc-code-block class="theme-fixed-dark" language="bash" filename="setup" code={SETUP}></arc-code-block>
  <p>
    This runs the image’s pinned installer, offline. (Upstream’s <code>curl | sh</code> installs
    the latest instead.) It also adds <code>gg</code> and <code>ggm</code>, the{' '}
    <a href="/docs/gaming#launch-options">launch options</a>.
  </p>
  <p>
    The user install replaces the image copy: <code>~/.local/bin</code>, the user extension and the
    user unit take precedence. <code>gamescale --version</code> shows which copy runs.
  </p>
</Docs>

<style>
  .above {
    margin: 0 0 var(--space-md);
  }
  .gs-icon {
    display: block;
  }
</style>
