---
import Ledger from '../../components/Ledger.astro';
import Version from '../../components/Version.astro';
import { getCollection } from 'astro:content';
import Docs from '../../layouts/Docs.astro';
import { changelog, release, version } from '../../data/build';
import { arithmetic, digest } from '../../data/digest';
import { APP_ID, BUILD_STATUS, IMAGES } from '../../data/site';
import { postHref, posts } from '../../data/blog';

const DESCRIPTION =
  'The latest Pulsar nightly build against the one before it, package by package. The build diffs its SBOM against the previous one and writes this page itself.';

const lead = digest.lead;
// The night Pulsar moved to a new Fedora release: nearly every package moved,
// so the page says so and points at the post about the move instead of
// listing them (see baseMoveOf in src/data/digest.ts).
const move = digest.baseMove;
const movePost = move ? (await posts()).find((p) => p.data.base === move.to) : undefined;
const moved = digest.packages + digest.added.length + digest.removed.length;
// the other changelog: Pulsar's own releases, once a nightly has shipped them
const hasReleases = (await getCollection('docs')).some((d) => d.id === 'releases');
const extra = lead ? lead.members.length - 1 : 0;

// The one page whose freshness is a fact the build knows: the diff's own stamp.
const JSONLD = [
  {
    '@type': 'WebPage',
    name: `Pulsar ${version} nightly build changes`,
    description: DESCRIPTION,
    dateModified: changelog.generated,
    about: { '@id': APP_ID },
    url: new URL('/docs/changelog', Astro.site).href,
  },
];
const TOC = move
  ? [{ id: 'last-night', label: 'What changed', level: 2 }]
  : [
      { id: 'last-night', label: 'What changed', level: 2 },
      { id: 'every-package', label: 'Every package that moved', level: 2 },
    ];
---

<Docs
  title="Nightly builds"
  fullTitle={`Pulsar ${version} nightly build changes`}
  description={DESCRIPTION}
  path="/docs/changelog"
  headings={TOC}
  jsonLd={JSONLD}
>
  <h1>Latest nightly build</h1>
  <p class="intro">
    Each nightly build diffs its SPDX SBOM against the previous build’s and writes the result to{' '}
    <a href="/changelog.json">changelog.json</a>, which this page is built from.
    {
      hasReleases && (
        <>
          {' '}For what is new in Pulsar itself{release && <> ({`Pulsar ${release}`})</>}, see the{' '}
          <a href="/docs/releases">release notes</a>.
        </>
      )
    }
  </p>
  <p class="hint">
    The page updates once a night’s image is published. <a href={BUILD_STATUS}>beacon.getpulsar.dev</a>{' '}
    shows each night’s build as it runs, including the reason a night was skipped or failed.
  </p>

  <h2 id="last-night">What changed</h2>
  <div class="lead">
    {
      move ? (
        <>
          <p class="lead-say">Moved to Fedora {move.to}.</p>
          <p class="lede">
            The latest image is the first one built on Fedora {move.to}, so nearly every package
            changed ({moved.toLocaleString('en-US')} of them), and this page doesn’t list them.
            {movePost && (
              <>
                {' '}The post about the move: <a href={postHref(movePost)}>{movePost.data.title}</a>.
              </>
            )}
          </p>
        </>
      ) : digest.baseline ? (
        <p class="lead-say">First build.</p>
      ) : digest.quiet ? (
        <p class="lead-say">Nothing moved.</p>
      ) : (
        lead && (
          <p class="lead-tx">
            <span class="lead-pkg">
              {lead.label}
              {extra > 0 && <span class="lead-with">+{extra} related</span>}
            </span>
            <span class="lead-ver" aria-hidden="true">
              <Version delta={lead.delta} from={lead.from} to={lead.to} />
            </span>
            <span class="sr-only">
              {lead.label}, {lead.from} to {lead.to}
            </span>
          </p>
        )
      )
    }
    {!move && <p class="lede">{arithmetic()}</p>}
    <p class="prov mono">
      <arc-badge variant="primary" size="sm" class="mono">{version}</arc-badge>
      {
        digest.fromDigest && digest.toDigest && (
          <>
            <span class="dim">image</span>
            <span>{digest.fromDigest}</span>
            <span class="dim" aria-hidden="true">→</span>
            <span>{digest.toDigest}</span>
          </>
        )
      }
      <span><span class="dim">diffed</span> <time datetime={changelog.generated}>{changelog.generated}</time></span>
    </p>
    {/* Filled by src/scripts/beacon.ts when the newest nightly built
        nothing, which is the night this heading would otherwise be
        wrong about. Hidden in the served HTML: skips commit nothing. */}
    <p class="hint skip-note" data-skip-note hidden></p>
  </div>

  {
    !move && (
      <>
        <h2 id="every-package">Every package that moved</h2>
        <Ledger />
      </>
    )
  }
  <p class="hint">
    Each image’s SBOM is attached to it in the registry, and{' '}
    <code>oras discover {IMAGES.vanilla}:latest</code> lists it. On a Pulsar machine,{' '}
    <code>pulsar changelog</code> prints the same&nbsp;list.
  </p>
</Docs>

<style>
  .lead-say,
  .lead-pkg {
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  .lead-say {
    margin: 0 0 var(--space-md);
  }
  .lead-tx {
    display: grid;
    gap: var(--space-sm);
    margin: 0 0 var(--space-md);
  }
  .lead-with {
    display: inline-block;
    vertical-align: 0.9em;
    margin-left: var(--space-sm);
    font-family: var(--font-mono);
    font-weight: var(--font-mono-weight);
    font-size: var(--text-sm);
    letter-spacing: 0;
    color: var(--accent-primary);
  }
  .lead-ver {
    font-size: var(--text-lg);
  }
  .prov {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin: 0;
  }
  .dim {
    color: var(--text-ghost);
  }
  .hint {
    margin-top: var(--space-xl);
  }
  /* after .hint, which it also is: it belongs to the line above it, not to
     the section below */
  .skip-note {
    margin: var(--space-sm) 0 0;
  }
</style>
