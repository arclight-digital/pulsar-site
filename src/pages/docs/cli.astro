---
import Docs from '../../layouts/Docs.astro';
import { APP_ID, ORG_ID, REPO } from '../../data/site';

const DESCRIPTION =
  'One command for an atomic Linux desktop: re-color GNOME in one step, check the system’s health, set up a coding agent in a toolbox, update, and roll back.';

// The CLI's own usage text, verbatim from cli/pulsar. A transcript, not a
// retyping: if the help changes, this is the place that has to change with it.


import { USAGE } from '../../data/cli';
const usage = USAGE.join('\n');

const JSONLD = [
  {
    '@type': 'TechArticle',
    headline: 'The pulsar command',
    description: DESCRIPTION,
    about: { '@id': APP_ID },
    author: { '@id': ORG_ID },
    publisher: { '@id': ORG_ID },
    url: new URL('/docs/cli', Astro.site).href,
  },
];
const SETUP = [
  'sudo pulsar setup apps         # install any default Flatpak that is missing',
  'pulsar setup devbox            # a dev distrobox, pulsar-dev, from /usr/share/pulsar/distrobox.ini',
  'sudo pulsar setup gamemode     # enroll accounts in the gamemode group',
  'pulsar setup quadlet           # the quadlet template, and container auto-update',
  'pulsar setup gamescale --platform steam   # let a Flatpak launcher use gamescale',
].join('\n');

const JSON_EXAMPLES = [
  "pulsar doctor --json | jq -r '.checks[] | select(.status != \"ok\") | .summary'",
  "pulsar update --check --json    # {status, booted, latest, image, staged}",
  "pulsar manifest --json | jq 'del(.host)'    # the manifest baked into the image",
].join('\n');

// where each command is explained properly
const WHERE: [string, string, string][] = [
  ['doctor, report', 'Troubleshooting', '/docs/troubleshooting'],
  ['status, update, rollback, pin, checkpoint', 'Updates and rollback', '/docs/updates'],
  ['theme', 'Themes', '/docs/themes'],
  ['agent, mcp', 'Coding agents', '/docs/agents'],
  ['setup', 'Where things go', '/docs/where-things-go'],
  ['manifest, changelog, sbom, verify', 'Provenance', '/docs/provenance'],
];

const TOC = [
  { id: 'usage', label: 'Everything it does', level: 2 },
  { id: 'json', label: 'For scripts', level: 2 },
  { id: 'setup', label: 'setup', level: 2 },
  { id: 'doctor', label: 'How doctor checks', level: 2 },
  { id: 'update', label: 'update, not upgrade', level: 2 },
  { id: 'name', label: 'If a different pulsar runs', level: 2 },
];
---

<Docs
  title="The pulsar command"
  fullTitle="The pulsar command — themes, health, agents and rollback"
  description={DESCRIPTION}
  path="/docs/cli"
  headings={TOC}
  jsonLd={JSONLD}
>
  <h1>The pulsar command</h1>
  <p class="intro">Themes, health checks, changes, agents and rollback, in one command.</p>

  <h2 id="usage">Everything it does</h2>
  <arc-code-block class="theme-fixed-dark" filename="pulsar --help" code={usage}></arc-code-block>
  <p>
    Plain <code>pulsar</code> runs <code>doctor</code>. <code>pulsar help &lt;command&gt;</code> or{' '}
    <code>--help</code> shows a command’s usage. Only commands marked root need it.
  </p>
  <table>
    <thead><tr><th>Commands</th><th>Explained in</th></tr></thead>
    <tbody>
      {WHERE.map(([cmds, label, href]) => (
        <tr><td><code>{cmds}</code></td><td><a href={href}>{label}</a></td></tr>
      ))}
    </tbody>
  </table>

  <h2 id="json">For scripts</h2>
  <p>
    <code>--json</code> works anywhere on the line; commands without JSON output exit with an error.{' '}
    <code>doctor</code> exits 1 only on a failed check; <code>update --check</code> exits 10 when an
    update is available.
  </p>
  <arc-code-block class="theme-fixed-dark" language="bash" filename="json" code={JSON_EXAMPLES}></arc-code-block>

  <h2 id="setup">setup: what the image can’t include</h2>
  <p>
    Each <code>setup</code> recipe handles per-machine or per-account state (apps, groups,
    containers) and tells you if it needs, or must not have, <code>sudo</code>.
  </p>
  <arc-code-block class="theme-fixed-dark" language="bash" filename="setup" code={SETUP}></arc-code-block>
  <p class="hint">
    <a href="/docs/where-things-go">Where things go</a> ·{' '}
    <a href="/docs/gamescale#flatpak">gamescale setup</a>
  </p>

  <h2 id="doctor">How doctor checks</h2>
  <p>
    <code>doctor</code> reads actual system state (e.g. <code>/sys/kernel/sched_ext/state</code>),
    not unit status, and needs no root: it reads through <code>rpm-ostree</code>, not{' '}
    <code>bootc status</code>. <code>pulsar sbom</code> is generated from the live rpm database with
    the nightly’s script.
  </p>

  <h2 id="update">update, not upgrade</h2>
  <p>
    <code>bootc upgrade</code> drops packages layered with <code>rpm-ostree install</code>.{' '}
    <code>pulsar update</code> uses <code>rpm-ostree upgrade</code> when you have layers (see
    doctor’s <code>updates</code> line). <code>pulsar update --check</code> needs no root.{' '}
    <a href="/docs/updates">Updates</a>.
  </p>

  <h2 id="name">If a different pulsar runs</h2>
  <p>
    The Pulsar code editor’s RPM or AppImage can shadow this <code>pulsar</code> on{' '}
    <code>PATH</code> (its Flatpak doesn’t). <code>/usr/bin/pulsar</code> always works; doctor’s{' '}
    <code>cli</code> check flags shadowing.
  </p>
  <p class="hint">The source is <a href={`${REPO}/blob/main/cli/pulsar`}>cli/pulsar</a>, one shell script.</p>
</Docs>
