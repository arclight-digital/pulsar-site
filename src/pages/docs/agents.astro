---
// Coding agents, as a how-to: install one, point it at the machine, hand it a
// problem, give it a local model, and sandbox it. Every command and message is
// cli/pulsar's (agent_*, sandbox_*, model_*), scripts/pulsar-mcp's, or
// system_files/etc/profile.d/pulsar-agents.sh's. The transcripts are real
// runs. What an agent can and cannot reach is docs/AGENTS-SAFETY.md, which
// this page links to rather than restates.
import Docs from '../../layouts/Docs.astro';
import { APP_ID, ORG_ID } from '../../data/site';

const DESCRIPTION =
  'How to install Claude Code, Codex, Gemini CLI, opencode or aider on Pulsar, point one at a crash or a local model, and leave it running in a session you can undo.';

const LIST = [
  '$ pulsar agent list',
  'NAME      COMMAND   INSTALL                            STATE      DESCRIPTION',
  'claude    claude    npm @anthropic-ai/claude-code      -          Claude Code (Anthropic)',
  'codex     codex     npm @openai/codex                  -          Codex CLI (OpenAI)',
  'gemini    gemini    npm @google/gemini-cli             -          Gemini CLI (Google)',
  'opencode  opencode  npm opencode-ai                    -          opencode (open source, any provider)',
  'aider     aider     uv aider-chat                      -          aider (open source, any provider)',
  '',
  'none is installed by default. box: agents  prefix: /var/home/you/.local/share/pulsar/agents',
].join('\n');

const ADD = [
  'pulsar agent add claude       # then type `claude` in any terminal',
  'pulsar agent remove claude    # its command and package; your logins stay',
].join('\n');

const STATUS = [
  '$ pulsar agent',
  'guide    /usr/share/pulsar/AGENTS.md  (pulsar agent guide)',
  'agent    claude    native',
  'sandbox  off here (default)  (pulsar agent sandbox)',
  'guard    off: layering and system Flatpak installs do not prompt  (sudo pulsar agent guard on)',
].join('\n');

const ASK = [
  'pulsar agent default claude                      # the agent ask starts',
  'pulsar agent ask                                 # "what, if anything, looks wrong?"',
  'pulsar agent ask why does the fan never stop     # your own question',
  'pulsar agent ask --crash latest                  # the newest crash, explained',
  'pulsar agent ask --with codex                    # someone other than the default',
].join('\n');

const SESSIONS = [
  'pulsar agent run claude --tmux work              # start claude in a session named work',
  'pulsar agent run claude --tmux work --worktree   # the same, in its own git worktree',
  'pulsar agent attach work                         # back onto work, from any terminal',
  'pulsar agent attach                              # back onto the one you were on last',
  'pulsar agent sessions                            # every session, and what each is doing',
  'pulsar agent usage work                          # its model, context and tokens (Claude Code)',
].join('\n');

const UNDO = [
  'pulsar agent undo work --dry-run    # what an undo would change',
  'pulsar agent undo work              # the files as they were when work started',
  'pulsar agent undo work --redo       # take the undo back',
].join('\n');

const MODEL = [
  'pulsar agent model on                            # the default: Qwen2.5 Coder 7B',
  'pulsar agent model on --model <owner/repo[:quant]> --at-login',
  'pulsar agent model                               # state, endpoint, key, the aider line',
  'pulsar agent model off --purge                   # stop, remove, delete the downloads',
].join('\n');

const SANDBOX = [
  'pulsar agent sandbox on               # every project, from now on',
  'pulsar agent sandbox on --here        # just this one',
  'pulsar agent sandbox                  # what applies here, and why',
  'pulsar agent sandbox push branches    # never the default branch',
  'pulsar agent sandbox push off         # no pushes, no pull requests',
].join('\n');

const SANDBOX_START = [
  '$ claude',
  'sandboxed: only /var/home/you/code/app is visible; push on through the gate',
].join('\n');

const SANDBOX_MORE = [
  'pulsar agent sandbox allow ~/.local/bin/my-hook     # one more path in, read-only',
  'pulsar agent sandbox allow ~/notes --rw --here      # read-write, this project only',
  'pulsar agent sandbox repin                          # after you really changed a remote',
  'pulsar agent run claude --no-sandbox                # one session outside it',
].join('\n');

const REPO_TOML = ['# .pulsar/agent.toml, committed to the repo', 'sandbox = "on"', 'push = "branches"'].join('\n');

const GUARD = [
  '$ pulsar agent guard',
  'guard: off',
  '',
  '  org.projectatomic.rpmostree1.install-uninstall-packages    no prompt',
  '  org.projectatomic.rpmostree1.rollback                      no prompt',
  '  org.projectatomic.rpmostree1.cleanup                       no prompt',
  '  org.freedesktop.Flatpak.app-install                        no prompt',
  '  org.freedesktop.Flatpak.app-uninstall                      no prompt',
].join('\n');

const TOOLS: [string, string][] = [
  ['doctor', 'the health checks, all or one'],
  ['status', 'deployments, pins and layered packages'],
  ['manifest', 'the image, the variant, the kernel and the hardware'],
  ['report', 'the redacted diagnosis report, with a crash if asked'],
  ['crashes', 'your crashes this boot'],
  ['update_check', 'whether a newer image is out'],
  ['agent_status', 'the guide, the agents, guard, the pin and the sandbox setting'],
  ['theme_list, theme_current', 'the desktop themes'],
  ['theme_set', 'sets your desktop theme (pulsar theme revert undoes it). The only tool here that changes anything'],
];

const JSONLD = [
  {
    '@type': 'TechArticle',
    headline: 'Coding agents on Pulsar',
    description: DESCRIPTION,
    about: { '@id': APP_ID },
    author: { '@id': ORG_ID },
    publisher: { '@id': ORG_ID },
    url: new URL('/docs/agents', Astro.site).href,
  },
];
const TOC = [
  { id: 'install', label: 'Install one', level: 2 },
  { id: 'briefing', label: 'What it knows about the machine', level: 2 },
  { id: 'ask', label: 'Ask it to fix something', level: 2 },
  { id: 'sessions', label: 'Sessions you can leave running', level: 2 },
  { id: 'model', label: 'A model on your own GPU', level: 2 },
  { id: 'sandbox', label: 'The sandbox', level: 2 },
  { id: 'guard', label: 'Guard, and checkpoints', level: 2 },
];
---

<Docs
  title="Coding agents"
  fullTitle="Coding agents on Pulsar | Pulsar docs"
  description={DESCRIPTION}
  path="/docs/agents"
  headings={TOC}
  jsonLd={JSONLD}
>
  <h1>Coding agents</h1>
  <p class="intro">
    Pulsar doesn’t come with an agent. When you add one, it gets a briefing on this machine and
    the health tools, and you can sandbox it so it sees one project.
  </p>

  <h2 id="install">Install one</h2>
  <p>The welcome window offers them at first login, or you can add one from a terminal.</p>
  <arc-code-block class="theme-fixed-dark" filename="pulsar agent list" code={LIST}></arc-code-block>
  <arc-code-block class="theme-fixed-dark" language="bash" filename="add" code={ADD}></arc-code-block>
  <p>
    <code>add</code> creates an <code>agents</code> toolbox, installs the agent with its vendor’s npm
    or uv method into <code>~/.local/share/pulsar/agents</code>, and adds a command to{' '}
    <code>~/.local/bin</code>. None of that needs root or layers a package. An agent you installed yourself is left in
    place (listed as <code>native</code>) and still gets the setup below.
  </p>
  <arc-alert variant="info" heading="The toolbox doesn’t isolate anything">
    It keeps Node, Python and the agent off the host (<code>toolbox rm -f agents</code> removes
    the lot). It still shares your home folder and your session. If you want the agent walled off,
    use <a href="#sandbox">the sandbox</a>.
  </arc-alert>

  <h2 id="briefing">What it knows about the machine</h2>
  <p>
    The briefing is <code>/usr/share/pulsar/AGENTS.md</code>. It tells an agent that{' '}
    <code>/usr</code> is read-only, that dev tools go in a toolbox and apps in Flatpaks, what a
    rollback covers, and what it must never do. <code>pulsar agent guide</code> prints it, so any agent can read it.
  </p>
  <p>
    <code>add</code> also links it into the agent’s own instructions if none exist (Claude Code:{' '}
    <code>~/.claude/rules/pulsar.md</code>), links the image’s skills (including one that makes
    themes), and for MCP agents registers <code>pulsar mcp</code>:
  </p>
  <table>
    <thead><tr><th>Tool</th><th>What it answers</th></tr></thead>
    <tbody>
      {TOOLS.map(([t, what]) => (
        <tr><td><code>{t}</code></td><td>{what}</td></tr>
      ))}
    </tbody>
  </table>
  <p>
    Nothing in it needs root, and there’s no way through it to update, roll back, checkpoint,
    change the guard or pin. <code>pulsar agent</code> on its own shows how it’s set up.
  </p>
  <arc-code-block class="theme-fixed-dark" filename="pulsar agent" code={STATUS}></arc-code-block>

  <h2 id="ask">Ask it to fix something</h2>
  <arc-code-block class="theme-fixed-dark" language="bash" filename="ask" code={ASK}></arc-code-block>
  <p>
    <code>ask</code> writes a redacted <code>pulsar report</code> (plus the crash, if named) to a
    private file in <code>$XDG_RUNTIME_DIR</code> (deleted at logout), then starts your agent with
    a prompt pointing at it, your question, and “Do not change the system without asking me
    first.” In opencode, press Enter to send it. aider gets the report as a read-only file, and you
    paste the prompt it prints.
  </p>
  <p>
    A crash notification’s <strong>Ask</strong> button runs <code>pulsar agent ask --crash</code>{' '}
    in a new terminal. The report has the stack trace and logs, never the core file{' '}
    (<a href="/docs/troubleshooting#crashes">Troubleshooting</a>). Whatever the agent reads is sent
    to its provider, so only click it if you’re fine with that.
  </p>

  <h2 id="sessions">Sessions you can leave running</h2>
  <p>
    <code>pulsar agent run &lt;agent&gt; --tmux &lt;name&gt;</code> starts the agent in a named tmux
    session that outlives its terminal window, or attaches to it if it’s already running. Sessions
    run on a tmux server of their own (<code>-L pulsar-agents</code>), apart from yours. tmux is in
    the image.
  </p>
  <arc-code-block class="theme-fixed-dark" language="bash" filename="sessions" code={SESSIONS}></arc-code-block>
  <p>
    With Claude Code, coming back to a session picks up the same conversation. Other agents start a
    new one. A session that ended starts again with its agent, folder and sandbox setting.{' '}
    <code>--worktree</code> gives the session its own branch, named after it, checked out in{' '}
    <code>&lt;repo&gt;/.worktrees/&lt;name&gt;</code>, so several agents can work in one project
    without touching each other’s files. It works in the sandbox too.
  </p>
  <p>
    When an agent in a session you aren’t looking at finishes or needs you, a notification says so,
    and its <strong>Open</strong> button takes you to that session. Claude Code tells Pulsar about
    both. Other agents notify you when they ring the terminal bell.
  </p>
  <arc-code-block class="theme-fixed-dark" language="bash" filename="undo" code={UNDO}></arc-code-block>
  <p>
    Undo works in git repositories. It puts the files back as they were when the session first
    started (or last started with <code>--new</code>), however often it restarted since, and deletes
    files added since. It never touches files git ignores, never overwrites a file it couldn’t take
    back (it names those), and never moves a branch, so commits made since stay. It won’t run while
    a session is running in that checkout, so end the session first.
  </p>
  <p>
    Pulsar Settings has an Agents page listing each session with its folder and usage, and{' '}
    <strong>Open</strong>, <strong>Undo</strong> and <strong>End</strong> buttons.
  </p>
  <p>
    On a fresh install the sandbox and the guard are both off. A session you leave running can read
    your whole home folder, and anything it runs can layer packages or roll back without a
    password. <a href="#sandbox">The sandbox</a> limits what it can read, and{' '}
    <a href="#guard">guard</a> makes those changes ask for a password.
  </p>

  <h2 id="model">A model on your own GPU</h2>
  <p>opencode and aider can use a local OpenAI-compatible server, with no account.</p>
  <arc-code-block class="theme-fixed-dark" language="bash" filename="model" code={MODEL}></arc-code-block>
  <ul>
    <li>
      Runs llama.cpp’s server image as a rootless user service: CUDA on the NVIDIA image, Vulkan
      with a GPU at <code>/dev/dri</code>, else CPU.
    </li>
    <li>First start downloads the model into <code>~/.local/share/pulsar/models</code>.</li>
    <li>
      Serves <code>http://127.0.0.1:8080/v1</code>, local only. Requests need the key in{' '}
      <code>~/.config/pulsar/model-key</code>.
    </li>
    <li>
      opencode: pick “Local (Pulsar)” with <code>/models</code>. aider:{' '}
      <code>pulsar agent model</code> prints the command.
    </li>
    <li>
      Stops at logout unless started with <code>--at-login</code> (a loaded model holds gigabytes of
      video memory).
    </li>
  </ul>

  <h2 id="sandbox">The sandbox</h2>
  <p>
    The agent runs in a rootless container that sees only the project you started it in: no SSH
    keys, browser profiles or other projects. Pushes go through a host-side gate that uses your
    credentials without exposing them and refuses force-pushes, deletions and tags.
  </p>
  <arc-code-block class="theme-fixed-dark" language="bash" filename="sandbox" code={SANDBOX}></arc-code-block>
  <ul>
    <li>
      The agent can commit, but git config and hooks (the repo’s, its submodules’, and any
      in-project hooks path or include) are read-only, and <code>.git</code> can’t be moved.
    </li>
    <li>
      A new <code>commondir</code> or <code>.git</code> in the tree is renamed to{' '}
      <code>&lt;name&gt;.from-sandbox</code> when the session ends. Until then, an editor running
      git in the background could follow it: close the editor on the project while an untrusted
      agent works.
    </li>
    <li>
      A linked worktree inside its main checkout, where <code>--worktree</code> puts them, works. One
      outside it, and a submodule checkout, are refused, because their git directory is outside the
      project where the sandbox can’t protect it.
    </li>
  </ul>
  <p>Type the agent’s name as usual:</p>
  <arc-code-block class="theme-fixed-dark" filename="claude" code={SANDBOX_START}></arc-code-block>
  <p>
    Start it inside a project. It refuses your whole home folder. In interactive bash,{' '}
    <code>claude</code>, <code>codex</code>, <code>gemini</code>, <code>opencode</code> and{' '}
    <code>aider</code> go through the sandbox, and <code>pulsar agent sandbox wrap off</code> stops
    that. Scripts, other shells and <code>command claude</code> don’t.{' '}
    <code>pulsar agent run claude</code> always follows your settings.
  </p>
  <arc-code-block class="theme-fixed-dark" language="bash" filename="more" code={SANDBOX_MORE}></arc-code-block>
  <p>A repository can require the sandbox (this file can only tighten settings):</p>
  <arc-code-block class="theme-fixed-dark" filename=".pulsar/agent.toml" code={REPO_TOML}></arc-code-block>
  <p class="hint">
    The sandbox leaves the network open. The rest of what it lets in and out is in{' '}
    <a href="/docs/agents-safety#the-sandbox-and-a-push-that-never-holds-your-key">Agents and safety</a>.
  </p>

  <h2 id="guard">Guard, and checkpoints</h2>
  <p>
    On stock Fedora, and on Pulsar until you turn the guard on, an admin’s session and anything it
    starts can layer packages, roll back, clean up deployments, and install or remove system
    Flatpaks without a password.
  </p>
  <arc-code-block class="theme-fixed-dark" filename="pulsar agent guard" code={GUARD}></arc-code-block>
  <p>
    <code>sudo pulsar agent guard on</code> makes all five ask for the admin password. Updates stay
    ungated. <code>sudo pulsar agent guard off</code> restores Fedora’s default.
  </p>
  <p>
    Take a checkpoint before a long session with <code>sudo pulsar checkpoint "before the agent"</code>.
    Afterwards, <code>diff</code> shows what changed and <code>restore</code> puts it back. More in{' '}
    <a href="/docs/updates#checkpoint">Checkpoints</a>.
  </p>
</Docs>
