---
// The docs front page: what is here, grouped the way the sidebar is.
import { getCollection } from 'astro:content';
import Docs from '../../layouts/Docs.astro';
import { DOCS_NAV as ALL_NAV, hrefOf } from '../../data/docs';
// Only the repo docs a published nightly has shipped (as the sidebar does):
// releases.md arrives with the release it describes.
const shipped = new Set((await getCollection('docs')).map((d) => d.id));
const DOCS_NAV = ALL_NAV.map((g) => ({ ...g, links: g.links.filter((l) => !l.slug || shipped.has(l.slug)) })).filter((g) => g.links.length);
---

<Docs
  title="Docs"
  fullTitle="Pulsar docs — install, themes, agents, updates"
  description="How Pulsar works: installing it, themes, games, coding agents, updates and rollback, fixing what breaks, and how every image is built and signed."
  path="/docs"
>
  <h1>Pulsar docs</h1>
  <p class="intro">How Pulsar works and how to use it.</p>
  <ul>
    <li>New: <a href="/docs/install">Install</a>, then <a href="/docs/where-things-go">Where things go</a>.</li>
    <li>From Windows or a Mac: <a href="/docs/coming-from">start here</a>.</li>
    <li>Something broken: <code>pulsar doctor</code>, then <a href="/docs/troubleshooting">Troubleshooting</a>.</li>
  </ul>
  {
    DOCS_NAV.map((g) => (
      <section class="block">
        <h2>{g.heading}</h2>
        <ul class="links">
          {g.links.filter((l) => l.href !== '/docs').map((l) => (
            <li>
              <a href={hrefOf(l)}>
                <arc-icon name={l.icon} size="md"></arc-icon>
                <span>{l.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Docs>

<style>
  .intro {
    font-size: var(--text-lg);
    max-width: 56ch;
  }
  .block h2 {
    margin-top: var(--space-xl);
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: var(--space-sm);
  }
  .links a {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    text-decoration: none;
    transition: border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }
  .links a:hover {
    border-color: var(--border-bright);
    box-shadow: var(--glow-hover);
  }
  .links arc-icon {
    color: var(--accent-primary);
  }
</style>
