---
// The docs front page: what is here, grouped the way the sidebar is.
import Docs from '../../layouts/Docs.astro';
import { DOCS_NAV, hrefOf } from '../../data/docs';
---

<Docs
  title="Docs"
  fullTitle="Pulsar docs — install, themes, agents, updates"
  description="How Pulsar works: installing it, themes, games, coding agents, updates and rollback, fixing what breaks, and how every image is built and signed."
  path="/docs"
>
  <h1>Pulsar docs</h1>
  <p class="intro">
    How Pulsar works, and how to make it yours. These pages live in the same repository as the
    image, and every command in them is one the image ships.
  </p>
  <p>
    New here? <a href="/docs/install">Install</a>, then <a href="/docs/where-things-go">Where things go</a>:
    the one habit an image-based system asks of you. Something broken? Run{' '}
    <code>pulsar doctor</code> and read <a href="/docs/troubleshooting">Troubleshooting</a>.
  </p>
  {
    DOCS_NAV.map((g) => (
      <section class="block">
        <h2>{g.heading}</h2>
        <ul class="links">
          {g.links.filter((l) => l.href !== '/docs').map((l) => (
            <li>
              <a href={hrefOf(l)}>
                <arc-icon name={l.icon} size="md"></arc-icon>
                <span>{l.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Docs>

<style>
  .intro {
    font-size: var(--text-lg);
    max-width: 56ch;
  }
  .block h2 {
    margin-top: var(--space-xl);
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: var(--space-sm);
  }
  .links a {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    text-decoration: none;
    transition: border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }
  .links a:hover {
    border-color: var(--border-bright);
    box-shadow: var(--glow-hover);
  }
  .links arc-icon {
    color: var(--accent-primary);
  }
</style>
