---
// Updates and undo, in the order you meet them: the notification, the update,
// the restart, and the three ways back (rollback, pin, checkpoint). Commands,
// flags and messages are cli/pulsar's; the timers and the GNOME Software
// policy are system_files/usr/lib/systemd/user/pulsar-update-check.*,
// system_files/usr/lib/systemd/system/pulsar-update-{auto,stage}.* and
// zz0-pulsar.gschema.override. The status transcripts are real runs.
import Docs from '../../layouts/Docs.astro';
import { APP_ID, ORG_ID } from '../../data/site';

const DESCRIPTION =
  'How Pulsar updates: new builds download in the background and wait for your next restart, or one click on the notification does it. Then the ways back: rollback, pinning, and checkpoints for /etc and your settings.';

const CHECK = [
  '$ pulsar update --check',
  'up to date: 44.20260928.0 (ghcr.io/arclight-digital/pulsar-nvidia:latest)',
].join('\n');

const CHECK_ANSWERS = [
  'up to date: <version> (<image>)          exit 0',
  'staged: <version> -- reboot to apply      exit 0',
  'update available: <booted> -> <latest>   exit 10',
  '(could not reach the registry)           exit 1',
].join('\n');

const UPDATE = [
  'sudo pulsar update            # fetch and stage; applies at the next restart',
  'sudo pulsar update --apply    # the same, then restart into it',
].join('\n');

const AUTO_OFF = 'sudo systemctl disable --now pulsar-update-auto.timer   # stop downloading in the background';

const STATUS = [
  '$ pulsar status',
  'STATE    VERSION       IMAGE                                         PINNED',
  'booted   44.20260928.0 ghcr.io/arclight-digital/pulsar-nvidia:latest no',
  '-        44.20260927.0 ghcr.io/arclight-digital/pulsar-nvidia:latest no',
].join('\n');

const ROLLBACK = [
  'sudo pulsar rollback          # the previous deployment boots next time',
  'systemctl reboot',
].join('\n');

const DISCARD = 'sudo rpm-ostree cleanup --pending    # drop a staged update before it boots';

const PIN = [
  '$ pulsar pin',
  'the booted deployment is not pinned (sudo pulsar pin on to keep it)',
  '$ sudo pulsar pin on',
  'pinned the booted deployment; it will survive GC',
].join('\n');

const CHECKPOINT = [
  'sudo pulsar checkpoint "before the agent"   # take one, with a note',
  'sudo pulsar checkpoint list                 # every checkpoint',
  'sudo pulsar checkpoint diff                 # what changed since the newest one',
  'sudo pulsar checkpoint restore <id>         # put changed and deleted files back',
  'sudo pulsar checkpoint drop <id>            # delete it, and unpin what it pinned',
].join('\n');

const CHECKPOINT_OUT = [
  'checkpoint <id>',
  '  /etc      <n> paths saved',
  '  home      <n> paths saved from /var/home/you (dotfiles, ~/.config, ~/.local/bin, ~/.ssh)',
  '  deployment 44.20260928.0 pinned',
  'see what changed: sudo pulsar checkpoint diff <id>',
  'undo it:          sudo pulsar checkpoint restore <id>',
].join('\n');

const COVERS: [string, string, string][] = [
  ['The OS image (/usr)', 'yes', 'yes, pinned'],
  ['Layered packages', 'yes: they belong to the deployment', 'yes, pinned'],
  ['/etc', 'no: you boot the old deployment’s copy, which can lose later edits', 'yes'],
  ['Your settings: dotfiles, ~/.config, ~/.local/bin, ~/.ssh', 'no', 'yes'],
  ['Documents, projects, ~/.local/share', 'no', 'no'],
  ['Flatpak apps and their data, toolboxes, containers', 'no', 'no'],
  ['/usr/local, /opt, the rest of /var', 'no', 'no'],
];

const JSONLD = [
  {
    '@type': 'TechArticle',
    headline: 'Updates and rollback on Pulsar',
    description: DESCRIPTION,
    about: { '@id': APP_ID },
    author: { '@id': ORG_ID },
    publisher: { '@id': ORG_ID },
    url: new URL('/docs/updates', Astro.site).href,
  },
];
const TOC = [
  { id: 'notice', label: 'How you hear about one', level: 2 },
  { id: 'update', label: 'Taking an update', level: 2 },
  { id: 'background', label: 'In the background', level: 3 },
  { id: 'rollback', label: 'Going back', level: 2 },
  { id: 'greenboot', label: 'When a boot fails', level: 3 },
  { id: 'pin', label: 'Pinning', level: 2 },
  { id: 'checkpoint', label: 'Checkpoints', level: 2 },
  { id: 'covers', label: 'What each one covers', level: 2 },
];
---

<Docs
  title="Updates and rollback"
  fullTitle="Pulsar updates, rollback, pins and checkpoints"
  description={DESCRIPTION}
  path="/docs/updates"
  headings={TOC}
  jsonLd={JSONLD}
>
  <h1>Updates and rollback</h1>
  <p class="intro">
    A new image is built every night, downloaded in the background, and used from your next restart.
    The previous one stays in the boot menu. Nothing restarts on its own.
  </p>

  <h2 id="notice">How you hear about one</h2>
  <p>
    Your session checks for a newer build 10–40 minutes after login, then about every six hours.
    Each build gets one notice:
  </p>
  <ul>
    <li>
      <strong>Pulsar &lt;version&gt; is ready</strong>: already downloaded. <strong>Restart</strong>{' '}
      opens GNOME’s restart dialog.
    </li>
    <li>
      <strong>Pulsar &lt;version&gt; is available</strong>: not downloaded a day after publishing
      (on battery, metered), or at once if background downloads are off. <strong>Update</strong>{' '}
      downloads it now.
    </li>
  </ul>
  <p>Check yourself (no root):</p>
  <arc-code-block class="theme-fixed-dark" filename="pulsar update --check" code={CHECK}></arc-code-block>
  <arc-code-block class="theme-fixed-dark" filename="the four answers" code={CHECK_ANSWERS}></arc-code-block>
  <p>
    The exit status is the answer; <code>--json</code> gives{' '}
    <code>{'{status, booted, latest, image, staged}'}</code>. GNOME Software’s update downloads and
    bootc’s auto-update timer (which reboots on its own) are off.
  </p>

  <h2 id="update">Taking an update</h2>
  <arc-code-block class="theme-fixed-dark" language="bash" filename="update" code={UPDATE}></arc-code-block>
  <p>
    <code>pulsar update</code> fetches and <strong>stages</strong> the new image; it becomes the
    default at the next boot. On the NVIDIA image it also fetches the next driver’s Flatpak GL
    extension, so Steam has it on boot.
  </p>
  <h3 id="background">In the background</h3>
  <p>
    <code>pulsar-update-auto.timer</code> runs <code>pulsar update --background</code> 20 minutes
    after boot, then every 12 hours awake, at the lowest priority. It skips (and logs why) on
    battery, on a metered connection, or when the newest build is already staged. It never
    restarts and never uses <code>--apply</code>.
  </p>
  <arc-code-block class="theme-fixed-dark" language="bash" filename="turn it off" code={AUTO_OFF}></arc-code-block>
  <p>
    The notification’s <strong>Update</strong> button starts the same download. A local admin isn’t
    asked for a password; it can only stage the published image, never apply it.
  </p>
  <p>
    With layered packages (<code>rpm-ostree install</code>), <code>pulsar update</code> uses{' '}
    <code>rpm-ostree upgrade</code> to keep them; plain <code>bootc upgrade</code> would drop them.
  </p>
  <p><code>pulsar status</code> shows the booted, staged and previous deployments.</p>
  <arc-code-block class="theme-fixed-dark" filename="pulsar status" code={STATUS}></arc-code-block>
  <arc-alert variant="warning" heading="Installed from an ISO before September 25, 2026?">
    Those installs are pinned to one image digest and never update. <code>pulsar doctor</code>{' '}
    (the <code>origin</code> check) and <code>pulsar update</code> print the command that points
    them at <code>:latest</code>.
  </arc-alert>

  <h2 id="rollback">Going back</h2>
  <p>The previous deployment stays on disk. Make it the default and restart:</p>
  <arc-code-block class="theme-fixed-dark" language="bash" filename="rollback" code={ROLLBACK}></arc-code-block>
  <p>
    It doesn’t restart for you. For a one-off, pick the older version in the boot menu. To discard a
    staged update you haven’t booted:
  </p>
  <arc-code-block class="theme-fixed-dark" language="bash" filename="discard" code={DISCARD}></arc-code-block>

  <h3 id="greenboot">When a boot fails</h3>
  <p>
    greenboot requires the login screen or a desktop within two minutes of boot. After three failed
    boots, the machine rolls back to the previous deployment on its own. The scheduler and network
    checks only warn. <code>pulsar doctor greenboot</code> shows this boot’s result.
  </p>

  <h2 id="pin">Pinning</h2>
  <p>Updates clean up old deployments. A pin keeps the booted one on disk through any number of updates.</p>
  <arc-code-block class="theme-fixed-dark" filename="pin" code={PIN}></arc-code-block>
  <p><code>sudo pulsar pin off</code> lets it go again.</p>

  <h2 id="checkpoint">Checkpoints</h2>
  <p>
    Rollback covers the OS image, not <code>/etc</code> or your home folder. A checkpoint covers
    both. Take one before a risky session:
  </p>
  <arc-code-block class="theme-fixed-dark" language="bash" filename="checkpoint" code={CHECKPOINT}></arc-code-block>
  <arc-code-block class="theme-fixed-dark" filename="what a new checkpoint prints" code={CHECKPOINT_OUT}></arc-code-block>
  <p>A checkpoint keeps three things:</p>
  <ul>
    <li><strong>All of <code>/etc</code></strong>, with owners, modes, ACLs and SELinux labels.</li>
    <li>
      <strong>Your settings</strong> (the <code>sudo</code> user’s): home dotfiles,{' '}
      <code>~/.config</code> minus caches, <code>~/.local/bin</code>, <code>~/.ssh</code>. Not
      documents, projects or <code>~/.local/share</code>. Skipped over 512 MB, or with{' '}
      <code>--no-home</code>.
    </li>
    <li><strong>A pin</strong> on the booted deployment.</li>
  </ul>
  <ul>
    <li>
      <code>diff</code>: every path <code>changed</code>, <code>added</code> or{' '}
      <code>removed</code> in <code>/etc</code> and your settings, and any deployment staged or
      booted since.
    </li>
    <li>
      <code>restore</code>: puts back changed and deleted files and discards a deployment staged
      since. Added files are listed, not deleted. Nothing is restarted: restart affected services,
      and log out for GNOME settings.
    </li>
  </ul>
  <arc-alert variant="warning" heading="Read the diff before you restore">
    Restore puts back <strong>everything</strong> changed since the checkpoint, not only what the
    agent touched. Every subcommand needs root, even <code>list</code>: checkpoints hold{' '}
    <code>/etc/shadow</code> and your SSH keys.
  </arc-alert>

  <h2 id="covers">What each one covers</h2>
  <table>
    <thead><tr><th>What changed</th><th>Rollback</th><th>Checkpoint</th></tr></thead>
    <tbody>
      {COVERS.map(([what, rb, cp]) => (
        <tr><td>{what}</td><td>{rb}</td><td>{cp}</td></tr>
      ))}
    </tbody>
  </table>
  <p class="hint">
    What an agent can change without asking: <a href="/docs/agents-safety">Agents and safety</a>.
  </p>
</Docs>
