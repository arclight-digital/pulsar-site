---
// The onramp for people arriving from Windows or macOS: whether their machine
// can run it, making the stick on the system they have, keeping Windows
// alongside, and where their habits land. Facts from the OS repo: the ISOs are
// x86_64 only (scripts/build-iso.sh), the installer asks before it touches a
// disk and writes no time zone or RTC setting (scripts/pulsar-install-system
// writes only locale.conf and vconsole.conf), the default apps
// (flatpaks.list), the window buttons and touchpad defaults and the disabled
// auto-downloads (zz0-pulsar.gschema.override), Super+T (scripts/pulsar-theme),
// the update notification's own text (cli/pulsar). The command output is real,
// from a Pulsar machine on 45.20261109.0. Every Flathub ID below was checked
// with flatpak remote-info.
import Docs from '../../layouts/Docs.astro';
import { APP_ID, ORG_ID } from '../../data/site';

const DESCRIPTION =
  'For people moving from Windows or macOS: which computers can run Pulsar, how to make the USB stick and keep Windows, and where your apps and shortcuts went.';

const BITLOCKER = [
  'manage-bde -status C:          # is BitLocker on?',
  'manage-bde -protectors -get C: # the recovery key: write down the 48 digits',
].join('\n');

const APPS = [
  '$ flatpak search libreoffice',
  'LibreOffice   The LibreOffice productivity suite   org.libreoffice.LibreOffice   stable   fedora,flathub',
  '',
  '$ flatpak install --user flathub org.libreoffice.LibreOffice',
].join('\n');

const UPDATES = [
  '$ pulsar update --check',
  'up to date: 45.20261109.0 (ghcr.io/arclight-digital/pulsar-nvidia:latest)',
  '',
  '$ pulsar status',
  'STATE    VERSION       IMAGE                                         PINNED',
  'booted   45.20261109.0 ghcr.io/arclight-digital/pulsar-nvidia:latest no',
  '-        45.20261108.0 ghcr.io/arclight-digital/pulsar-nvidia:latest no',
].join('\n');

const UPDATE_CMDS = [
  'sudo pulsar update   # the system, from your next restart',
  'flatpak update       # your apps, or use Software',
].join('\n');

const CLOCK = 'timedatectl set-local-rtc 1 --adjust-system-clock';

// what you did before, and what it is here
const HABITS: [string, string, string][] = [
  ['Start menu', 'Spotlight, Launchpad', 'Press Super and type. Super+A shows every app.'],
  ['Taskbar', 'Dock', 'The dash, in the overview. Right-click an app there to pin it.'],
  ['Settings, Control Panel', 'System Settings', 'Settings, in the app grid, or Super and type what you want.'],
  ['Microsoft Store, a .exe', 'App Store, a .dmg', 'GNOME Software, or flatpak install. Both install Flatpaks.'],
  ['Windows Update', 'Software Update', 'Downloads in the background and offers a restart in a notification. Updates never restart the computer.'],
  ['File Explorer', 'Finder', 'Files. Your folders are under /home/you, called ~ for short.'],
  ['Task Manager', 'Activity Monitor', 'System Monitor, in the app grid.'],
  ['Terminal, PowerShell', 'Terminal', 'Ptyxis, which Pulsar’s themes recolor along with the desktop.'],
  ['System Restore', 'Time Machine (the system half)', 'Pick the previous build in the boot menu. That restores the system, not your files.'],
];

const KEYS: [string, string, string, string][] = [
  ['Super', 'The overview: windows, workspaces and search', 'Win', 'Cmd+Space'],
  ['Super+A', 'Every app', 'Win, then All apps', 'Launchpad'],
  ['Alt+Tab', 'Switch apps. Alt+` switches windows of one app', 'Alt+Tab', 'Cmd+Tab'],
  ['Super+←/→', 'Snap a window to half the screen', 'Win+←/→', 'drag it to the edge'],
  ['Super+↑/↓', 'Maximize, and back', 'Win+↑/↓', 'the green button'],
  ['Super+H', 'Minimize', 'Win+↓', 'Cmd+M'],
  ['Super+PgUp/PgDn', 'Switch workspace', 'Win+Ctrl+←/→', 'Ctrl+←/→'],
  ['Super+V', 'Notifications and the calendar', 'Win+N', 'click the clock'],
  ['Print', 'Screenshot or screen recording', 'Win+Shift+S', 'Cmd+Shift+5'],
  ['Super+L', 'Lock the screen', 'Win+L', 'Ctrl+Cmd+Q'],
  ['Ctrl+Q', 'Quit an app. Alt+F4 closes a window here too', 'Alt+F4', 'Cmd+Q'],
  ['Super+T', 'Pulsar’s theme picker, if that shortcut was free', '', ''],
];

// Flathub IDs, each checked with `flatpak remote-info flathub <id>`
const EQUIV: [string, string, string][] = [
  ['Office documents', 'LibreOffice, ONLYOFFICE', 'org.libreoffice.LibreOffice, org.onlyoffice.desktopeditors'],
  ['Photoshop, Paint', 'GIMP, Krita, Pinta', 'org.gimp.GIMP, org.kde.krita, com.github.PintaProject.Pinta'],
  ['Illustrator', 'Inkscape', 'org.inkscape.Inkscape'],
  ['Lightroom', 'darktable', 'org.darktable.Darktable'],
  ['Premiere, iMovie', 'Kdenlive', 'org.kde.kdenlive'],
  ['Outlook, Mail', 'Thunderbird', 'org.mozilla.Thunderbird'],
  ['VLC, a video you double-clicked', 'Showtime (installed), VLC', 'org.gnome.Showtime, org.videolan.VLC'],
  ['Chrome, Brave', 'The same apps', 'com.google.Chrome, com.brave.Browser'],
  ['Spotify, Slack, Zoom, Signal', 'The same apps', 'com.spotify.Client, com.slack.Slack, us.zoom.Zoom, org.signal.Signal'],
  ['A password manager', 'Bitwarden', 'com.bitwarden.desktop'],
];

const JSONLD = [
  {
    '@type': 'TechArticle',
    headline: 'Coming to Pulsar from Windows or macOS',
    description: DESCRIPTION,
    about: { '@id': APP_ID },
    author: { '@id': ORG_ID },
    publisher: { '@id': ORG_ID },
    url: new URL('/docs/coming-from', Astro.site).href,
  },
];
const TOC = [
  { id: 'can-it', label: 'Which computers can run it', level: 2 },
  { id: 'backup', label: 'Before you start', level: 2 },
  { id: 'stick', label: 'Make the USB stick', level: 2 },
  { id: 'boot', label: 'Start from the stick', level: 2 },
  { id: 'dual-boot', label: 'Keeping Windows', level: 2 },
  { id: 'habits', label: 'Where things moved', level: 2 },
  { id: 'apps', label: 'Installing apps', level: 2 },
  { id: 'updates', label: 'Updates', level: 2 },
  { id: 'keys', label: 'Keyboard shortcuts', level: 2 },
  { id: 'games', label: 'Games', level: 2 },
  { id: 'limits', label: 'What won’t work here', level: 2 },
  { id: 'stuck', label: 'When you’re stuck', level: 2 },
];
---

<Docs
  title="From Windows or macOS"
  fullTitle="Coming to Pulsar from Windows or macOS"
  description={DESCRIPTION}
  path="/docs/coming-from"
  headings={TOC}
  jsonLd={JSONLD}
>
  <h1>From Windows or macOS</h1>
  <p class="intro">
    You can make the Pulsar USB stick from Windows or macOS and keep Windows on the same disk. Check
    your computer against the table below first. Apple silicon Macs and Intel Macs from 2018 to 2020
    can’t run Pulsar.
  </p>

  <h2 id="can-it">Which computers can run it</h2>
  <table>
    <thead><tr><th>You have</th><th>Pulsar?</th></tr></thead>
    <tbody>
      <tr>
        <td>A Windows PC with Intel or AMD graphics</td>
        <td>Yes, with the standard download.</td>
      </tr>
      <tr>
        <td>A Windows PC with an NVIDIA GeForce card</td>
        <td>
          Yes for GTX 16 and RTX 20 series cards and newer, with the NVIDIA download. It ships only
          NVIDIA’s open driver (<code>nvidia-open</code>), which doesn’t support GTX 10 series and
          older cards, so use the standard download for those.
        </td>
      </tr>
      <tr>
        <td>A Mac with Apple silicon (M1 and later)</td>
        <td>
          No. Pulsar is x86_64 only.
        </td>
      </tr>
      <tr>
        <td>An Intel Mac, 2018 to 2020</td>
        <td>
          No. The T2 chip’s keyboard, trackpad and audio need drivers Fedora’s kernel lacks.
        </td>
      </tr>
      <tr>
        <td>An older Intel Mac</td>
        <td>
          Maybe, but it’s untested. Broadcom Wi-Fi needs a driver the image lacks, so keep a wired
          connection handy.
        </td>
      </tr>
    </tbody>
  </table>
  <p>On Windows, Task Manager → <strong>Performance</strong> lists each GPU in the machine.</p>

  <h2 id="backup">Before you start</h2>
  <p>
    <strong>Back up everything you want to keep</strong> to an external drive or a cloud.
  </p>
  <ul>
    <li>
      If Windows uses BitLocker, save the recovery key (from your Microsoft account or Control
      Panel) before you change firmware settings, because a boot-order or Secure Boot change can make
      Windows ask for it. The first command below (PowerShell, as admin) prints{' '}
      <code>Protection On</code> if BitLocker is on.
    </li>
    <li>
      On a Mac with FileVault turned on, only macOS can read your files, so copy them off first.
    </li>
    <li>
      Deactivate anything that counts devices (Adobe, Office, some games), and export or sync your
      browser’s passwords.
    </li>
  </ul>
  <arc-code-block class="theme-fixed-dark" filename="PowerShell (admin)" code={BITLOCKER}></arc-code-block>

  <h2 id="stick">Make the USB stick</h2>
  <p>
    You need a USB stick of 8&nbsp;GB or more, which will be erased, and the ISO from{' '}
    <a href="/#install">Get Pulsar</a>.
  </p>
  <h3>From Windows or macOS: Fedora Media Writer</h3>
  <p>
    Install Fedora Media Writer from fedoraproject.org, choose <strong>Select .iso file</strong>,
    pick the Pulsar ISO and the stick, and write.
  </p>
  <h3>Rufus, balenaEtcher or Ventoy</h3>
  <p>
    These work too. In Rufus, pick <strong>DD</strong> mode. Ventoy works with the current ISO; read the{' '}
    <a href="/docs/install#iso">warning about old downloads</a> first.
  </p>
  <p class="hint">
    To verify the download, see <a href="/docs/install#iso">Install</a>.
  </p>

  <h2 id="boot">Start from the stick</h2>
  <ul>
    <li>
      On a PC, restart with the stick in and tap the boot menu key (usually{' '}
      <arc-kbd>F12</arc-kbd>, <arc-kbd>F11</arc-kbd>, <arc-kbd>F8</arc-kbd> or <arc-kbd>Esc</arc-kbd>).
      Pick the USB entry.
    </li>
    <li>
      On an Intel Mac, hold <arc-kbd>Option</arc-kbd> at startup and pick EFI Boot.
    </li>
  </ul>
  <p>
    <strong>Leave Secure Boot on.</strong> The NVIDIA image needs{' '}
    <a href="/docs/install#secure-boot">its key enrolled</a> once after installing.
  </p>

  <h2 id="dual-boot">Keeping Windows</h2>
  <p>To keep Windows on the same disk and pick one at power-on, do these in order.</p>
  <ol>
    <li>
      In Disk Management, right-click C: and choose <strong>Shrink Volume</strong>. Pulsar needs
      36&nbsp;GB (the installer counts that as 39&nbsp;GB), and 100&nbsp;GB or more if you play
      games. Leave the space unallocated.
    </li>
    <li>
      Turn off Fast Startup (Control Panel → Power Options → Choose what the power buttons do), or
      the Windows drive stays locked.
    </li>
    <li>
      Turn off BitLocker and let it finish decrypting. The installer won’t install beside a drive
      that has it on.
    </li>
    <li>
      In the installer, pick the disk, then <strong>Install alongside Windows</strong>. Windows’
      partitions and boot files stay as they are, and Windows goes in the startup menu.
    </li>
  </ol>
  <p>
    If Windows isn’t in Pulsar’s boot menu, the PC’s boot menu lists{' '}
    <strong>Windows Boot Manager</strong>. Files can open the Windows drive if Windows was shut
    down fully.
  </p>
  <p>
    Windows keeps the hardware clock in local time and Pulsar keeps it in UTC, so after you’ve been
    in Windows the clock can be off by your time zone. This makes Pulsar use local time too.
  </p>
  <arc-code-block class="theme-fixed-dark" language="bash" filename="clock" code={CLOCK}></arc-code-block>

  <h2 id="habits">Where things moved</h2>
  <table>
    <thead><tr><th>Windows</th><th>macOS</th><th>Pulsar</th></tr></thead>
    <tbody>
      {HABITS.map(([win, mac, here]) => (
        <tr><td>{win}</td><td>{mac}</td><td>{here}</td></tr>
      ))}
    </tbody>
  </table>
  <p>
    Window buttons are at the top right. To move them left: GNOME Tweaks →{' '}
    <strong>Windows → Titlebar Buttons → Placement</strong>. Tap-to-click and two-finger scrolling
    are on.
  </p>
  <p>
    There is no <code>C:\</code>. Your files are in your home folder, <code>/home/you</code>, and the
    system is a separate read-only image. An update replaces the image and leaves your home folder
    alone. <a href="/docs/where-things-go">Where things go</a> has a table of the other folders.
  </p>

  <h2 id="apps">Installing apps</h2>
  <p>
    Apps are Flatpaks from Flathub. Install them in GNOME Software, or in the terminal.
  </p>
  <arc-code-block class="theme-fixed-dark" language="bash" filename="flatpak" code={APPS}></arc-code-block>
  <p>
    Firefox is built in. The first boot with a network installs a starting set (text editor,
    calculator, image, PDF, video and music viewers, Steam, Heroic, Discord, OBS Studio and more),
    and Pulsar doesn’t put back any you remove.
  </p>
  <h3>Replacements for common apps</h3>
  <p>These are all on Flathub. Search for the name in Software.</p>
  <table>
    <thead><tr><th>You used</th><th>Here</th></tr></thead>
    <tbody>
      {EQUIV.map(([was, here]) => (
        <tr><td>{was}</td><td>{here}</td></tr>
      ))}
    </tbody>
  </table>
  <h3>Windows programs</h3>
  <p>
    Bottles (installed) runs many Windows programs through Wine. Mac-only apps have no equivalent.
    Utilities and older software often work in Bottles. Suites with activation, such as Microsoft
    Office and Adobe Creative Cloud, mostly don’t, and their web versions work in the browser instead.
  </p>

  <h2 id="updates">Updates</h2>
  <p>
    The system updates as one image. It downloads in the background, and when it’s ready a
    notification says <strong>Pulsar 45.x is ready</strong> and offers a Restart button. The new build
    starts at your next restart.
  </p>
  <arc-code-block class="theme-fixed-dark" language="bash" filename="update" code={UPDATE_CMDS}></arc-code-block>
  <arc-code-block class="theme-fixed-dark" filename="pulsar status" code={UPDATES}></arc-code-block>
  <p>
    In <code>pulsar status</code>, the row right after <code>booted</code> is the previous build. If
    an update misbehaves, pick that build in the boot menu. <a href="/docs/updates">Updates and rollback</a> covers the rest.
  </p>

  <h2 id="keys">Keyboard shortcuts</h2>
  <p>
    <arc-kbd>Super</arc-kbd> is the Windows key (<arc-kbd>Cmd</arc-kbd> on a Mac keyboard). Tap it
    and type an app’s name to open it.
  </p>
  <table>
    <thead><tr><th>Keys</th><th>Does</th></tr></thead>
    <tbody>
      {KEYS.map(([keys, does, win, mac]) => (
        <tr>
          <td><arc-kbd>{keys}</arc-kbd></td>
          <td>
            {does}
            {win && <span class="was">Windows: {win} · Mac: {mac}</span>}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  <p>
    Coming from a Mac, copy and paste are <arc-kbd>Ctrl+C</arc-kbd> and{' '}
    <arc-kbd>Ctrl+V</arc-kbd>. In the terminal, <arc-kbd>Ctrl+Shift+C</arc-kbd> and{' '}
    <arc-kbd>Ctrl+Shift+V</arc-kbd> (<arc-kbd>Ctrl+C</arc-kbd> stops the running command).
  </p>

  <h2 id="games">Games</h2>
  <p>
    Steam is installed, and most Windows games run through Proton. Heroic covers Epic, GOG and
    Amazon. <a href="/docs/gaming">Gaming</a> has more.
  </p>
  <p>
    Games whose anti-cheat blocks Linux won’t run (currently Valorant,
    League of Legends, Fortnite, recent Call of Duty). Easy Anti-Cheat and BattlEye games work only
    if the developer enabled Proton support. Check ProtonDB before wiping anything, or keep Windows.
  </p>

  <h2 id="limits">What won’t work here</h2>
  <p>
    Apple has no Linux clients for iCloud Drive, iMessage or AirDrop (iCloud’s website works).
    Windows-only apps for RGB lighting, fans and peripherals don’t run.
  </p>

  <h2 id="stuck">When you’re stuck</h2>
  <p>Open the terminal (Super, type <em>terminal</em>) and run:</p>
  <arc-code-block class="theme-fixed-dark" language="bash" filename="health" code="pulsar doctor"></arc-code-block>
  <p>
    Each check prints <code>ok</code>, <code>warn</code> or <code>FAIL</code>, and a warning or
    failure can add a line saying what to do. To ask for help, share the output of{' '}
    <code>pulsar report --text</code>, and read it before you post it. It removes your hostname,
    username, MAC, IPv4 and email addresses and the tokens it recognizes, but it copies log messages
    as written. <a href="/docs/troubleshooting">Troubleshooting</a> has more.
  </p>
</Docs>

<style>
  .was {
    display: block;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
